{{!-- Inventory inspection panel — renders an item's display layer in
      the chrome's inspect pane. Mirrors the Witcher-3 tooltip from the
      weapon sheet display view so the inspect panel matches the sheet.
      Falls through to a compact name + image + description for item
      types that don't have a bespoke section yet. --}}

<div class="wdm-w3 wdm-w3-inspect is-{{type}}">

  <header class="wdm-w3-head">
    <img class="wdm-w3-portrait" src="{{item.img}}" alt="" />
    <div class="wdm-w3-titles">
      <h1 class="wdm-w3-title">{{item.name}}</h1>
      <div class="wdm-w3-subtitle">
        {{#if (eq type "weapon")}}{{#if item.system.weaponType}}{{localize (lookup config.weapon.types item.system.weaponType)}}{{/if}}{{#if item.system.hands}} · {{#unless (eq item.system.hands "two")}}{{#if item.system.quick}}{{localize 'WITCHER.Inspect.ItemCard.Text.QuickPrefix'}} {{/if}}{{/unless}}{{localize (lookup config.weapon.hands item.system.hands)}}{{/if}}{{else if (eq type "ammo")}}{{ammoMeta.ammoTypeLabel}}{{else if (eq type "armor")}}{{#if item.system.armorType}}{{localize (lookup config.armor.types item.system.armorType)}}{{/if}}{{else if (eq type "alchemical")}}{{alchemyMeta.typeLabel}}{{else if (eq type "component")}}{{#if componentMeta.isSubstance}}{{localize 'WITCHER.Inspect.ItemCard.Text.AlchemicalSubstance'}}{{else}}{{localize 'WITCHER.Inspect.ItemCard.Text.CraftingMaterial'}}{{/if}}{{else if (eq type "container")}}{{localize 'WITCHER.Inspect.ItemCard.Text.Container'}}{{else if (eq type "mutagen")}}{{#if mutagenMeta.typeLabel}}{{mutagenMeta.typeLabel}} {{/if}}{{localize 'WITCHER.Inspect.ItemCard.Text.Mutagen'}}{{else if (eq type "diagrams")}}{{#if diagramMeta.levelLabel}}{{diagramMeta.levelLabel}} · {{/if}}{{diagramMeta.kindLabel}}{{#if diagramMeta.subtypeLabel}} · {{diagramMeta.subtypeLabel}}{{/if}}{{else if (eq type "food")}}{{foodMeta.kindLabel}}{{#if foodMeta.isAlcohol}} · {{localize 'WITCHER.Inspect.ItemCard.Text.Alcoholic'}}{{/if}}{{#if foodMeta.tierLabel}} · <span class="wdm-w3-tier-{{foodMeta.tier}}">{{foodMeta.tierLabel}}</span>{{/if}}{{else if (eq type "book")}}{{bookDisplayMeta.bookTypeLabel}}{{else if (eq type "enhancement")}}{{enhancementMeta.typeLabel}}{{#if enhancementMeta.attachedName}} · socketed in {{enhancementMeta.attachedName}}{{/if}}{{else if (eq type "focus")}}{{localize 'WITCHER.Sheet.Focus.Text.Focus'}}{{else}}{{type}}{{/if}}
      </div>
    </div>
  </header>

  {{#if (eq type "weapon")}}
    {{!-- Weapon: damage hero + key stats + qualities. When enhancements
         are socketed, the hero and stat rows show effective (derived)
         values; otherwise they fall back to the base source values. --}}
    <div class="wdm-w3-hero">
      <div class="wdm-w3-hero-value">{{#if effective.modified}}{{effective.damage}}{{else}}{{item.system.damage}}{{/if}}</div>
      <div class="wdm-w3-hero-label">{{localize 'WITCHER.Sheet.Item.Text.DAMAGE'}}{{#if effective.modified}} <i class="fa-solid fa-gem" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.Enhanced'}}"></i>{{/if}}</div>
      {{#if item.system.requiresAmmo}}
        <div class="wdm-w3-hero-sub">{{localize 'WITCHER.Inspect.ItemCard.Text.ByAmmunition'}}</div>
      {{else if effective.damageTypes.length}}
        <div class="wdm-w3-hero-sub">
          {{#each effective.damageTypes}}{{#unless @first}} · {{/unless}}{{this}}{{/each}}
        </div>
      {{else if item.system.damageTypes.length}}
        <div class="wdm-w3-hero-sub">
          {{#each item.system.damageTypes}}{{#unless @first}} · {{/unless}}{{this}}{{/each}}
        </div>
      {{/if}}
    </div>

    <ul class="wdm-w3-stats">
      {{#unless (eq effective.accuracy 0)}}
        <li class="wdm-w3-stat {{#if (gte effective.accuracy 0)}}is-positive{{/if}}">
          <span class="val">{{#if (gte effective.accuracy 0)}}+{{/if}}{{effective.accuracy}}</span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.WeaponAccuracy'}}</span>
        </li>
      {{/unless}}
      {{#unless (eq effective.reliabilityMax 0)}}
        <li class="wdm-w3-stat">
          <span class="val">{{item.system.reliability.value}}/{{effective.reliabilityMax}}</span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.Reliability'}}</span>
        </li>
      {{/unless}}
      {{#if item.system.range}}
        <li class="wdm-w3-stat">
          <span class="val">{{item.system.range}}m</span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.Range'}}</span>
        </li>
      {{/if}}
      {{#if (eq item.system.weaponType "thrown")}}
        {{#unless (eq item.system.radius 0)}}
          <li class="wdm-w3-stat">
            <span class="val">{{item.system.radius}}m</span>
            <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.Radius'}}</span>
          </li>
        {{/unless}}
      {{/if}}
      {{#if enhancementSlots.length}}
        <li class="wdm-w3-stat wdm-w3-stat-slots">
          <span class="val">{{enhancementSlots.length}}</span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.EnhancementSlots'}}</span>
          <span class="wdm-w3-slots">
            {{#each enhancementSlots}}
              {{#if this.filled}}
                <span class="wdm-w3-slot is-filled" data-tooltip="{{this.name}}" data-tooltip-direction="UP">
                  <img src="{{this.img}}" alt="" />
                </span>
              {{else}}
                <span class="wdm-w3-slot"></span>
              {{/if}}
            {{/each}}
          </span>
        </li>
      {{/if}}
    </ul>

    {{#if weaponQualityList.length}}
      <div class="wdm-w3-tags">
        {{#each weaponQualityList}}
          <span class="wdm-w3-tag" data-tooltip="{{this.description}}" data-tooltip-direction="UP">{{this.label}}</span>
        {{/each}}
      </div>
    {{/if}}

    {{#if socketedQualityList.length}}
      <div class="wdm-w3-section-label">{{localize 'WITCHER.Inspect.ItemCard.Text.FromEnhancements'}}</div>
      <div class="wdm-w3-tags">
        {{#each socketedQualityList}}
          <span class="wdm-w3-tag is-enhanced" data-tooltip="{{this.description}}" data-tooltip-direction="UP">
            <i class="fa-solid fa-gem"></i> {{this.label}}
          </span>
        {{/each}}
      </div>
    {{/if}}

    {{!-- Ranged loadout: the whole chamber, in fire order (FILO — next-to-fire
          first), each round with its own type + oil. Chamber weapons only. --}}
    {{#if rangedMeta.hasChamber}}
      <div class="wdm-w3-section-label">{{localize 'WITCHER.Inspect.ItemCard.Text.Ammunition'}} <span class="wdm-w3-chamber-count">{{rangedMeta.loadedCount}}/{{rangedMeta.capacity}}</span></div>
      {{#if rangedMeta.isLoaded}}
        <ol class="wdm-w3-chamber-list">
          {{#each rangedMeta.chamber}}
            <li class="wdm-w3-chamber-round{{#if this.next}} is-next{{/if}}">
              {{#if this.img}}<img class="wdm-w3-chamber-img" src="{{this.img}}" alt="">{{/if}}
              <span class="wdm-w3-chamber-name">{{#if this.oilName}}<span class="wdm-w3-chamber-oil">({{this.oilName}})</span> {{/if}}{{this.name}}</span>
              {{#if this.next}}<span class="wdm-w3-chamber-next">{{localize 'WITCHER.Sheet.Weapon.Text.NextToFire'}}</span>{{/if}}
            </li>
          {{/each}}
        </ol>
      {{else}}
        <div class="wdm-w3-loaded-row is-empty"><span class="wdm-w3-loaded-empty">{{localize 'WITCHER.Inspect.ItemCard.Text.ChamberEmpty'}}</span></div>
      {{/if}}
    {{/if}}
  {{/if}}

  {{#if (eq type "ammo")}}
    {{!-- Ammo: ammoType hero + damage-type subline + quantity/availability
         stats + oil coating badge + qualities. Mirrors the depth of the
         weapon and armor cards so an ammo inspection is more than a name
         and a description. --}}
    <div class="wdm-w3-hero">
      <div class="wdm-w3-hero-value">{{ammoMeta.quantity}}</div>
      <div class="wdm-w3-hero-label">{{localize 'WITCHER.Inspect.ItemCard.Text.Quantity'}}</div>
      {{#if ammoMeta.damageTypeLabels.length}}
        <div class="wdm-w3-hero-sub">
          {{#each ammoMeta.damageTypeLabels}}{{#unless @first}} · {{/unless}}{{this}}{{/each}}
        </div>
      {{/if}}
    </div>

    <ul class="wdm-w3-stats">
      <li class="wdm-w3-stat">
        <span class="val">{{ammoMeta.ammoTypeLabel}}</span>
        <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.AmmoType'}}</span>
      </li>
      {{#if ammoMeta.availabilityLabel}}
        <li class="wdm-w3-stat">
          <span class="val">{{ammoMeta.availabilityLabel}}</span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.Availability'}}</span>
        </li>
      {{/if}}
      {{#if ammoMeta.concealLabel}}
        <li class="wdm-w3-stat">
          <span class="val">{{ammoMeta.concealLabel}}</span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.Conceal'}}</span>
        </li>
      {{/if}}
    </ul>

    {{#if ammoMeta.hasOil}}
      <div class="wdm-w3-section-label">{{localize 'WITCHER.Inspect.ItemCard.Text.AppliedOil'}}</div>
      <div class="wdm-w3-tags">
        <span class="wdm-w3-tag is-enhanced" data-tooltip="{{ammoMeta.oilName}}" data-tooltip-direction="UP">
          {{#if ammoMeta.oilImg}}<img src="{{ammoMeta.oilImg}}" alt="" style="height:0.85em;vertical-align:middle;margin-right:0.25em;" />{{/if}}
          {{ammoMeta.oilName}}
          {{#if ammoMeta.oilMaxCharges}} · {{ammoMeta.oilCharges}}/{{ammoMeta.oilMaxCharges}}{{/if}}
          {{#if ammoMeta.oilBonusDamage}} · +{{ammoMeta.oilBonusDamage}} dmg{{/if}}
        </span>
      </div>
    {{/if}}

    {{#if weaponQualityList.length}}
      <div class="wdm-w3-section-label">{{localize 'WITCHER.Inspect.ItemCard.Text.Qualities'}}</div>
      <div class="wdm-w3-tags">
        {{#each weaponQualityList}}
          <span class="wdm-w3-tag" data-tooltip="{{this.description}}" data-tooltip-direction="UP">{{this.label}}</span>
        {{/each}}
      </div>
    {{/if}}
  {{/if}}

  {{#if (eq type "armor")}}
    {{!-- Armor: stopping-power hero + coverage subline + resistance
         flags + EV + enhancement slots + quality tags. Mirrors the
         armor sheet's display layer. --}}
    <div class="wdm-w3-hero">
      <div class="wdm-w3-hero-value">{{armorMeta.primarySP}}{{#if armorMeta.primarySPMax}}/{{armorMeta.primarySPMax}}{{/if}}</div>
      <div class="wdm-w3-hero-label">{{armorMeta.primaryStatLabel}}</div>
      {{#if armorMeta.coverageLabel}}
        <div class="wdm-w3-hero-sub">{{armorMeta.coverageLabel}}</div>
      {{/if}}
    </div>

    <ul class="wdm-w3-stats">
      {{!-- Per-location SP rows for multi-location armor (Full, Arms,
           Legs) — same value at each named slot. Single-location pieces
           skip this list; the hero + coverage subline already covers it. --}}
      {{#if armorMeta.multiLocation}}
        {{#each armorMeta.spLocations}}
          <li class="wdm-w3-stat wdm-w3-stat-sp">
            <span class="val">{{this.value}}{{#if this.max}}/{{this.max}}{{/if}}</span>
            <span class="lbl">{{this.label}}</span>
          </li>
        {{/each}}
      {{/if}}
      {{#unless (eq effective.bonusSP 0)}}
        <li class="wdm-w3-stat is-positive">
          <span class="val">+{{effective.bonusSP}}</span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.BonusStopping'}} <i class="fa-solid fa-gem"></i></span>
        </li>
      {{/unless}}
      {{#if item.system.bludgeoning}}
        <li class="wdm-w3-stat is-positive">
          <span class="val"><i class="fa-solid fa-check"></i></span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.ResistsBludgeoning'}}</span>
        </li>
      {{/if}}
      {{#if item.system.slashing}}
        <li class="wdm-w3-stat is-positive">
          <span class="val"><i class="fa-solid fa-check"></i></span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.ResistsSlashing'}}</span>
        </li>
      {{/if}}
      {{#if item.system.piercing}}
        <li class="wdm-w3-stat is-positive">
          <span class="val"><i class="fa-solid fa-check"></i></span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.ResistsPiercing'}}</span>
        </li>
      {{/if}}
      {{!-- Enhancement-added resistances: under RAW show a piece-wide
            diamond (no zone concept); under EO the S/P/B chips appear
            per-zone in the AE section below and this piece-wide row
            is suppressed. --}}
      {{#unless armorMeta.eoArmorModelOn}}
        {{#each effective.addedResistances}}
          <li class="wdm-w3-stat is-positive">
            <span class="val"><i class="fa-solid fa-gem"></i></span>
            <span class="lbl">Resists {{this}}</span>
          </li>
        {{/each}}
      {{/unless}}
      {{#unless (eq item.system.encumbranceValue 0)}}
        <li class="wdm-w3-stat is-negative">
          <span class="val">−{{item.system.encumbranceValue}}</span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.EncumbrancePenalty'}}</span>
        </li>
      {{/unless}}
      {{#if armorMeta.eoArmorModelOn}}
        {{!-- EO enhancement slots: one AE budget row + one row per
              physically covered body zone. Per-zone rows show the
              enhancements attached to that zone plus S/P/B chips for
              any resistance this zone got from an enhancement (base
              piece-wide resistances are already shown as diamonds
              above, so they don't repeat as chips). Glyph pool renders
              alongside as its own row with the classic used/cap. --}}
        {{#if armorMeta.aeBudget}}
          <li class="wdm-w3-stat wdm-w3-stat-slots">
            <span class="val">{{armorMeta.aeBudget.used}}/{{armorMeta.aeBudget.total}}</span>
            <span class="lbl">{{localize 'WITCHER.Sheet.Armor.Text.AeBudget'}}</span>
          </li>
        {{/if}}
        {{#each armorMeta.enhancementSlotGroups}}
          <li class="wdm-w3-stat wdm-w3-stat-slots">
            {{#if (eq this.kind 'glyph')}}
              <span class="val">{{this.used}}/{{this.cap}}</span>
            {{else}}
              <span class="val">{{this.used}}</span>
            {{/if}}
            <span class="lbl">{{this.label}}{{#if this.resistances}}{{#if (or this.resistances.slashing this.resistances.piercing this.resistances.bludgeoning)}}
              <span class="wdm-w3-zone-res">
                {{#if this.resistances.slashing}}<span class="wdm-w3-zone-res-chip" data-res="slashing" data-tooltip="Enhancement-added slashing resistance on this zone" data-tooltip-direction="UP">S</span>{{/if}}
                {{#if this.resistances.piercing}}<span class="wdm-w3-zone-res-chip" data-res="piercing" data-tooltip="Enhancement-added piercing resistance on this zone" data-tooltip-direction="UP">P</span>{{/if}}
                {{#if this.resistances.bludgeoning}}<span class="wdm-w3-zone-res-chip" data-res="bludgeoning" data-tooltip="Enhancement-added bludgeoning resistance on this zone" data-tooltip-direction="UP">B</span>{{/if}}
              </span>
            {{/if}}{{/if}}</span>
            <span class="wdm-w3-slots">
              {{#each this.slots}}
                {{#if this.filled}}
                  <span class="wdm-w3-slot is-filled" data-tooltip="{{this.name}}" data-tooltip-direction="UP">
                    <img src="{{this.img}}" alt="" />
                  </span>
                {{else}}
                  <span class="wdm-w3-slot" data-tooltip="Empty {{../location}} zone AE slot"></span>
                {{/if}}
              {{/each}}
            </span>
          </li>
        {{/each}}
      {{else}}
        {{#if enhancementSlots.length}}
          <li class="wdm-w3-stat wdm-w3-stat-slots">
            <span class="val">{{enhancementSlots.length}}</span>
            <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.EnhancementSlots'}}</span>
            <span class="wdm-w3-slots">
              {{#each enhancementSlots}}
                {{#if this.filled}}
                  <span class="wdm-w3-slot is-filled" data-tooltip="{{this.name}}" data-tooltip-direction="UP">
                    <img src="{{this.img}}" alt="" />
                  </span>
                {{else}}
                  <span class="wdm-w3-slot"></span>
                {{/if}}
              {{/each}}
            </span>
          </li>
        {{/if}}
      {{/if}}
    </ul>

    {{#if armorQualityList.length}}
      <div class="wdm-w3-tags">
        {{#each armorQualityList}}
          <span class="wdm-w3-tag" data-tooltip="{{this.description}}" data-tooltip-direction="UP">{{this.label}}</span>
        {{/each}}
      </div>
    {{/if}}

    {{#if socketedQualityList.length}}
      <div class="wdm-w3-section-label">{{localize 'WITCHER.Inspect.ItemCard.Text.FromEnhancements'}}</div>
      <div class="wdm-w3-tags">
        {{#each socketedQualityList}}
          <span class="wdm-w3-tag is-enhanced" data-tooltip="{{this.description}}" data-tooltip-direction="UP">
            <i class="fa-solid fa-gem"></i> {{this.label}}
          </span>
        {{/each}}
      </div>
    {{/if}}
  {{/if}}

  {{#if (eq type "shield")}}
    {{!-- Shield: Reliability (blocks) hero + CV/category subline +
         EV + enhancement slots + quality tags. Mirrors the shield
         sheet's display layer and shares layout with the armor card. --}}
    <div class="wdm-w3-hero">
      <div class="wdm-w3-hero-value">{{shieldMeta.primarySP}}{{#if shieldMeta.primarySPMax}}/{{shieldMeta.primarySPMax}}{{/if}}</div>
      <div class="wdm-w3-hero-label">{{shieldMeta.primaryStatLabel}}</div>
      {{#if shieldMeta.coverageLabel}}
        <div class="wdm-w3-hero-sub">{{shieldMeta.coverageLabel}}</div>
      {{/if}}
    </div>

    <ul class="wdm-w3-stats">
      {{#unless (eq shieldMeta.coverValue 0)}}
        <li class="wdm-w3-stat is-positive">
          <span class="val">{{shieldMeta.coverValue}}</span>
          <span class="lbl">Cover Value{{#if shieldMeta.isFullCover}} <i class="fa-solid fa-shield-halved" data-tooltip="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.FullCoverAllLocations'}}"></i>{{/if}}</span>
        </li>
      {{/unless}}
      {{#unless (eq item.system.encumbranceValue 0)}}
        <li class="wdm-w3-stat is-negative">
          <span class="val">−{{item.system.encumbranceValue}}</span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.EncumbrancePenalty'}}</span>
        </li>
      {{/unless}}
      {{#if enhancementSlots.length}}
        <li class="wdm-w3-stat wdm-w3-stat-slots">
          <span class="val">{{enhancementSlots.length}}</span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.EnhancementSlots'}}</span>
          <span class="wdm-w3-slots">
            {{#each enhancementSlots}}
              {{#if this.filled}}
                <span class="wdm-w3-slot is-filled" data-tooltip="{{this.name}}" data-tooltip-direction="UP">
                  <img src="{{this.img}}" alt="" />
                </span>
              {{else}}
                <span class="wdm-w3-slot"></span>
              {{/if}}
            {{/each}}
          </span>
        </li>
      {{/if}}
    </ul>

    {{#if shieldQualityList.length}}
      <div class="wdm-w3-tags">
        {{#each shieldQualityList}}
          <span class="wdm-w3-tag" data-tooltip="{{this.description}}" data-tooltip-direction="UP">{{this.label}}</span>
        {{/each}}
      </div>
    {{/if}}

    {{#if socketedQualityList.length}}
      <div class="wdm-w3-section-label">{{localize 'WITCHER.Inspect.ItemCard.Text.FromEnhancements'}}</div>
      <div class="wdm-w3-tags">
        {{#each socketedQualityList}}
          <span class="wdm-w3-tag is-enhanced" data-tooltip="{{this.description}}" data-tooltip-direction="UP">
            <i class="fa-solid fa-gem"></i> {{this.label}}
          </span>
        {{/each}}
      </div>
    {{/if}}
  {{/if}}

  {{#if (eq type "alchemical")}}
    {{!-- Alchemical: type-driven hero + key stats. --}}
    <div class="wdm-w3-hero">
      <div class="wdm-w3-hero-value">{{alchemyMeta.heroValue}}</div>
      <div class="wdm-w3-hero-label">{{alchemyMeta.heroLabel}}</div>
      {{#if alchemyMeta.heroSub}}
        <div class="wdm-w3-hero-sub">{{alchemyMeta.heroSub}}</div>
      {{/if}}
    </div>

    <ul class="wdm-w3-stats">
      {{#if alchemyMeta.isBomb}}
        {{#if item.system.range}}
          <li class="wdm-w3-stat">
            <span class="val">{{item.system.range}}</span>
            <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.ThrowingRange'}}</span>
          </li>
        {{/if}}
        {{#unless (eq item.system.area 0)}}
          <li class="wdm-w3-stat">
            <span class="val">{{item.system.area}}m</span>
            <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.AreaOfEffect'}}</span>
          </li>
        {{/unless}}
      {{/if}}
      {{!-- Alchemy Reborn brew-base summary — same shape as the item-sheet
            display, so the inspect line reads identically. Hidden when
            baseSummary is null (toggle off or item not a configured base). --}}
      {{#if alchemyMeta.baseSummary}}
        <li class="wdm-w3-stat" data-base-type="{{alchemyMeta.baseSummary.key}}">
          <span class="val">{{alchemyMeta.baseSummary.modSigned}} DC</span>
          <span class="lbl">{{alchemyMeta.baseSummary.typeLabel}}</span>
        </li>
      {{/if}}
    </ul>
  {{/if}}

  {{#if (eq type "component")}}
    {{!-- Component: substance hero only when it yields one of the nine
         substances (rarity lives in the footer, not the body). Alchemy
         Reborn adds a Potency line below the hero so the player sees the
         ingredient's brew weight at a glance. --}}
    {{#if componentMeta.hasHero}}
      <div class="wdm-w3-hero">
        <div class="wdm-w3-hero-value is-substance" style="--sub-color: var(--wdm-sub-{{componentMeta.substanceKey}})">
          <img class="wdm-sub-icon" src="{{componentMeta.substanceArt}}" alt="" />{{componentMeta.substanceName}}
        </div>
        <div class="wdm-w3-hero-label">{{localize 'WITCHER.Sheet.Item.Text.SUBSTANCE'}}</div>
        {{#if componentMeta.showPotency}}
          <div class="wdm-w3-hero-sub">Potency {{componentMeta.potency}}</div>
        {{/if}}
      </div>
    {{/if}}

    <ul class="wdm-w3-stats">
      {{#if item.system.forageLocation}}
        <li class="wdm-w3-stat">
          <span class="val">{{item.system.forageLocation}}</span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.FoundIn'}}</span>
        </li>
      {{/if}}
      {{#unless (eq item.system.forageDC 0)}}
        <li class="wdm-w3-stat">
          <span class="val">{{item.system.forageDC}}</span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.ForageDc'}}</span>
        </li>
      {{/unless}}
      {{#if item.system.forageQuantity}}
        <li class="wdm-w3-stat">
          <span class="val">{{item.system.forageQuantity}}</span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.Yield'}}</span>
        </li>
      {{/if}}
      {{#if componentMeta.baseSummary}}
        <li class="wdm-w3-stat" data-base-type="{{componentMeta.baseSummary.key}}">
          <span class="val">{{componentMeta.baseSummary.modSigned}} DC</span>
          <span class="lbl">{{componentMeta.baseSummary.typeLabel}}</span>
        </li>
      {{/if}}
    </ul>
  {{/if}}

  {{#if (eq type "mutagen")}}
    {{!-- Mutagen: Mutation DC hero + the Active-Effect modifiers ("+3 Melee"),
         mirroring the mutagen sheet's display layer. Under Alchemy Reborn
         a Substance hero precedes the DC and a Potency line follows. --}}
    {{#if mutagenMeta.hasSubstance}}
      <div class="wdm-w3-hero">
        <div class="wdm-w3-hero-value is-substance" style="--sub-color: var(--wdm-sub-{{mutagenMeta.substanceKey}})">
          <img class="wdm-sub-icon" src="{{mutagenMeta.substanceArt}}" alt="" />{{mutagenMeta.substanceName}}
        </div>
        <div class="wdm-w3-hero-label">{{localize 'WITCHER.Sheet.Item.Text.SUBSTANCE'}}</div>
        {{#if mutagenMeta.showPotency}}
          <div class="wdm-w3-hero-sub">Potency {{mutagenMeta.potency}}</div>
        {{/if}}
      </div>
    {{/if}}
    {{#if item.system.mutationDC}}
      <div class="wdm-w3-hero">
        <div class="wdm-w3-hero-value">{{item.system.mutationDC}}</div>
        <div class="wdm-w3-hero-label">{{localize 'WITCHER.Inspect.ItemCard.Text.MutationDc'}}</div>
      </div>
    {{/if}}
    {{#if mutagenMeta.modifiers.length}}
      <div class="wdm-w3-section-label">{{localize 'WITCHER.Inspect.ItemCard.Text.Effect'}}</div>
      <ul class="wdm-w3-stats">
        {{#each mutagenMeta.modifiers}}
          <li class="wdm-w3-stat">
            <span class="val">{{this.value}}</span>
            <span class="lbl">{{this.label}}</span>
          </li>
        {{/each}}
      </ul>
    {{/if}}
    {{#if item.system.minorEffect}}
      <div class="wdm-w3-section-label">{{localize 'WITCHER.Inspect.ItemCard.Text.MinorEffect'}}</div>
      <div class="wdm-w3-effects">{{item.system.minorEffect}}</div>
    {{/if}}
    {{#if item.system.transmutation}}
      <div class="wdm-w3-section-label">{{localize 'WITCHER.Inspect.ItemCard.Text.Transmutation'}}</div>
      <div class="wdm-w3-effects">{{item.system.transmutation}}</div>
    {{/if}}
  {{/if}}

  {{#if (eq type "container")}}
    {{!-- Container: stored / capacity (kg) load hero + fill bar + count.
         Mirrors the container sheet's display layer. --}}
    <div class="wdm-w3-hero">
      <div class="wdm-w3-hero-value {{#if containerMeta.isOver}}is-over{{/if}}">
        {{containerMeta.storedWeight}}{{#if containerMeta.hasCapacity}} / {{containerMeta.capacity}}{{/if}}
      </div>
      <div class="wdm-w3-hero-label">{{#if containerMeta.hasCapacity}}Capacity (kg){{else}}Stored (kg){{/if}}</div>
    </div>

    {{#if containerMeta.hasCapacity}}
      <div class="wdm-w3-capbar {{#if containerMeta.isOver}}is-over{{/if}}">
        <div class="wdm-w3-capbar-fill" style="width: {{containerMeta.fillPct}}%"></div>
      </div>
    {{/if}}

    <ul class="wdm-w3-stats">
      <li class="wdm-w3-stat">
        <span class="val">{{containerMeta.contentCount}}</span>
        <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.ItemsStored'}}</span>
      </li>
    </ul>
  {{/if}}

  {{#if (eq type "diagrams")}}
    {{!-- Diagram / formula: craft-DC hero + crafting stats, produced-item
         preview, ingredient list and (formulae) required substances.
         Mirrors the diagram sheet's display layer. --}}
    <div class="wdm-w3-hero">
      <div class="wdm-w3-hero-value">{{diagramMeta.dc}}</div>
      <div class="wdm-w3-hero-label">{{diagramMeta.dcLabel}}</div>
    </div>

    <ul class="wdm-w3-stats">
      {{#if diagramMeta.craftingTime}}
        <li class="wdm-w3-stat">
          <span class="val">{{diagramMeta.craftingTime}}</span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.CraftingTime'}}</span>
        </li>
      {{/if}}
      {{#unless (eq diagramMeta.investment 0)}}
        <li class="wdm-w3-stat">
          <span class="val">{{diagramMeta.investment}}</span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.InvestmentCrowns'}}</span>
        </li>
      {{/unless}}
      {{#if diagramMeta.learned}}
        <li class="wdm-w3-stat is-positive">
          <span class="val"><i class="fa-solid fa-check"></i></span>
          <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.Memorized'}}</span>
        </li>
      {{/if}}
    </ul>

    {{#if diagramMeta.output.linked}}
      <div class="wdm-w3-output">
        <img src="{{diagramMeta.output.img}}" alt="" />
        <div class="wdm-w3-output-meta">
          <span class="wdm-w3-output-kicker">{{localize 'WITCHER.Inspect.ItemCard.Text.Produces'}}</span>
          <span class="wdm-w3-output-name">{{diagramMeta.output.name}}</span>
        </div>
      </div>
    {{/if}}

    {{#if diagramMeta.hasIngredients}}
      <div class="wdm-w3-section-label">{{localize 'WITCHER.Inspect.ItemCard.Text.Ingredients'}}</div>
      <ul class="wdm-w3-ingredients">
        {{#each diagramMeta.ingredients}}
          <li class="wdm-w3-ingredient">
            <img src="{{this.img}}" alt="" />
            <span class="nm">{{this.name}}</span>
            <span class="qt">×{{this.quantity}}</span>
          </li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if diagramMeta.hasSubstances}}
      <div class="wdm-w3-section-label">{{localize 'WITCHER.Inspect.ItemCard.Text.Substances'}}</div>
      <div class="wdm-w3-subs">
        {{#each diagramMeta.substancesRequired}}
          <span class="wdm-w3-sub" style="--sub-color: var(--wdm-sub-{{this.key}})">
            <img class="wdm-sub-icon" src="{{this.art}}" alt="" />{{this.label}} ×{{this.qty}}
          </span>
        {{/each}}
      </div>
    {{/if}}
  {{/if}}

  {{#if (eq type "enhancement")}}
    {{!-- Enhancement (rune / glyph / weapon-mod / armor-mod): mirrors the item
         sheet's display view via the shared enhancementDisplay builder. --}}
    <div class="wdm-w3-hero">
      <div class="wdm-w3-hero-value">{{enhancementMeta.heroValue}}</div>
      <div class="wdm-w3-hero-label">{{enhancementMeta.heroLabel}}</div>
    </div>
    {{#if enhancementMeta.modRows.length}}
      <ul class="wdm-w3-stats">
        {{#each enhancementMeta.modRows}}
          <li class="wdm-w3-stat {{#if this.positive}}is-positive{{else}}is-negative{{/if}}">
            <span class="val">{{this.val}}</span>
            <span class="lbl">{{this.lbl}}</span>
          </li>
        {{/each}}
      </ul>
    {{/if}}
    {{#if enhancementMeta.addedTypeTags.length}}
      <div class="wdm-w3-section-label">{{localize 'WITCHER.Sheet.Enhancement.Text.AddsDamageType'}}</div>
      <div class="wdm-w3-tags">{{#each enhancementMeta.addedTypeTags}}<span class="wdm-w3-tag">{{this}}</span>{{/each}}</div>
    {{/if}}
    {{#if enhancementMeta.resistTags.length}}
      <div class="wdm-w3-section-label">{{localize 'WITCHER.Sheet.Enhancement.Text.GrantsResistance'}}</div>
      <div class="wdm-w3-tags">{{#each enhancementMeta.resistTags}}<span class="wdm-w3-tag">{{this}}</span>{{/each}}</div>
    {{/if}}
    {{#if enhancementMeta.grantedQualityList.length}}
      <div class="wdm-w3-section-label">{{localize 'WITCHER.Sheet.Enhancement.Text.GrantsQualities'}}</div>
      <div class="wdm-w3-tags">
        {{#each enhancementMeta.grantedQualityList}}
          <span class="wdm-w3-tag" data-tooltip="{{this.description}}" data-tooltip-direction="UP">{{this.label}}</span>
        {{/each}}
      </div>
    {{/if}}
    {{#if enhancementMeta.effects}}
      <div class="wdm-w3-effects">{{{enhancementMeta.effects}}}</div>
    {{/if}}
  {{/if}}

  {{!-- Shared description + footer, normalized across the three physical
       item types so weapon / armor / alchemical inspect cards match.
       Description sits above the footer; the footer carries
       weight | qty | conceal | availability (rarity) | price. The conceal
       cell self-hides when the item has no concealment (e.g. armor). --}}
  {{#if bookMeta}}
    <div class="wdm-w3-section-label">{{localize 'WITCHER.Inspect.ItemCard.Text.ReadingProgress'}}</div>
    <div class="wdm-book-progress{{#if bookMeta.completed}} is-complete{{/if}}">
      <div class="wdm-book-progress-bar"><span style="width:{{bookMeta.percent}}%"></span></div>
      <div class="wdm-book-progress-pct">{{bookMeta.percent}}%{{#if bookMeta.completed}} · Complete{{/if}}</div>
    </div>
  {{/if}}

  {{#if (eq type "food")}}
    {{!-- Food / drink: portion ticker + satiety restore + alcohol DC.
         The drunk DC only shows when the kind is drink AND the item is
         flagged alcoholic — meals can't carry alcohol metadata. --}}
    {{#if (or foodMeta.hasCharges foodMeta.satietyRestore foodMeta.isAlcohol foodMeta.baseSummary)}}
      <ul class="wdm-w3-stats">
        {{#if foodMeta.hasCharges}}
          <li class="wdm-w3-stat">
            <span class="val">{{foodMeta.chargesCurrent}}/{{foodMeta.chargesMax}}</span>
            <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.Portions'}}</span>
          </li>
        {{/if}}
        {{#if foodMeta.satietyRestore}}
          <li class="wdm-w3-stat">
            <span class="val">+{{foodMeta.satietyRestore}}</span>
            <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.SatietyPortion'}}</span>
          </li>
        {{/if}}
        {{#if foodMeta.isAlcohol}}
          <li class="wdm-w3-stat">
            <span class="val">DC {{foodMeta.drunkDC}}</span>
            <span class="lbl">{{localize 'WITCHER.Inspect.ItemCard.Text.EnduranceVsDrunk'}}</span>
          </li>
        {{/if}}
        {{!-- Alchemy Reborn brew-base summary — drinks acting as potion
              bases, ingredients acting as bomb bases, etc. Shares the same
              data shape as alchemyMeta.baseSummary so the row reads the
              same on both item types. --}}
        {{#if foodMeta.baseSummary}}
          <li class="wdm-w3-stat" data-base-type="{{foodMeta.baseSummary.key}}">
            <span class="val">{{foodMeta.baseSummary.modSigned}} DC</span>
            <span class="lbl">{{foodMeta.baseSummary.typeLabel}}</span>
          </li>
        {{/if}}
      </ul>
    {{/if}}

    {{!-- Freshness chip. Hidden when the GM didn't author a shelf life or
         the item hasn't been acquired (untracked → freshness.tracked === false). --}}
    {{#if foodMeta.freshness.tracked}}
      <div class="wdm-food-freshness is-{{foodMeta.freshness.state}}">
        <i class="fa-solid {{foodMeta.freshness.icon}}"></i>
        <span class="wdm-food-freshness-label">{{foodMeta.freshness.stateLabel}}</span>
        {{#if foodMeta.freshness.remaining}}
          <span class="wdm-food-freshness-time">· {{foodMeta.freshness.remaining}} day{{#unless (eq foodMeta.freshness.remaining "1.0")}}s{{/unless}} left</span>
        {{/if}}
      </div>
    {{/if}}
  {{/if}}

  {{#if (eq type "focus")}}
    <ul class="wdm-w3-stats">
      <li class="wdm-w3-stat is-positive">
        <span class="val">−{{item.system.focus}}</span>
        <span class="lbl">{{localize 'WITCHER.Sheet.Focus.Text.StaReduction'}}</span>
      </li>
      <li class="wdm-w3-stat is-positive">
        <span class="val">+{{item.system.greaterFocus}}</span>
        <span class="lbl">{{localize 'WITCHER.Sheet.Focus.Text.CastBonus'}}</span>
      </li>
    </ul>
  {{/if}}

  {{#if (eq type "remains")}}
    {{!-- Remains: track what's been done to the carcass — no description/value/availability. --}}
    <div class="wdm-w3-section-label">{{localize 'WITCHER.Inspect.ItemCard.Text.Carcass'}}</div>
    <div class="wdm-remains-state">
      <span class="wdm-remains-tag{{#if remainsState.harvested}} is-done{{/if}}">
        <i class="fa-solid {{#if remainsState.harvested}}fa-check{{else}}fa-xmark{{/if}}"></i> {{localize 'WITCHER.Sheet.Valuable.Text.Harvested'}}
      </span>
      {{#if remainsState.hasMutagen}}
      <span class="wdm-remains-tag{{#if remainsState.extracted}} is-done{{/if}}">
        <i class="fa-solid {{#if remainsState.extracted}}fa-check{{else}}fa-xmark{{/if}}"></i> {{localize 'WITCHER.Sheet.Valuable.Text.MutagenExtracted'}}
      </span>
      {{/if}}
      <span class="wdm-remains-tag wdm-remains-charges" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.EachHarvestExtractCosts1ChargeDissectCos'}}">
        <i class="fa-solid fa-droplet"></i> {{remainsState.charges}}/{{remainsState.chargesMax}} charges
      </span>
    </div>
  {{else}}
    {{#if item.system.description}}
      <div class="wdm-w3-description">{{{descriptionHtml}}}</div>
    {{/if}}
  {{/if}}

  {{#if (or (eq type "weapon") (eq type "armor") (eq type "shield") (eq type "alchemical") (eq type "book") (eq type "enhancement") (eq type "focus"))}}
    <div class="wdm-w3-footer">
      <span class="wdm-w3-foot-cell" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.WeightKg'}}"><i class="fa-solid fa-weight-hanging"></i>{{item.system.weight}}</span>
      {{#unless (eq item.system.quantity 1)}}
        <span class="wdm-w3-foot-cell" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.Quantity'}}"><i class="fa-solid fa-layer-group"></i>×{{item.system.quantity}}</span>
      {{/unless}}
      {{#if item.system.conceal}}
        {{#unless (eq item.system.conceal "N/A")}}
          <span class="wdm-w3-foot-cell" title="{{localize 'WITCHER.Sheet.Item.Text.Concealability'}}"><i class="fa-solid fa-eye-slash"></i>{{localize (lookup config.concealment item.system.conceal)}}</span>
        {{/unless}}
      {{/if}}
      <span class="wdm-w3-foot-spacer"></span>
      <span class="wdm-w3-foot-cell wdm-w3-rarity" title="{{localize 'WITCHER.Sheet.Item.Text.Availability'}}">{{localize (lookup config.availability item.system.availability)}}</span>
      <span class="wdm-w3-foot-cell wdm-w3-price" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.Crowns'}}"><i class="fa-solid fa-coins"></i>{{item.system.cost}}</span>
    </div>
  {{/if}}

  {{#if (eq type "component")}}
    <div class="wdm-w3-footer">
      <span class="wdm-w3-foot-cell" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.WeightKg'}}"><i class="fa-solid fa-weight-hanging"></i>{{item.system.weight}}</span>
      {{#unless (eq item.system.quantity 1)}}
        <span class="wdm-w3-foot-cell" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.Quantity'}}"><i class="fa-solid fa-layer-group"></i>×{{item.system.quantity}}</span>
      {{/unless}}
      <span class="wdm-w3-foot-spacer"></span>
      <span class="wdm-w3-foot-cell wdm-w3-rarity" title="{{localize 'WITCHER.Sheet.Item.Text.Availability'}}">{{localize (lookup config.availability item.system.availability)}}</span>
      <span class="wdm-w3-foot-cell wdm-w3-price" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.Crowns'}}"><i class="fa-solid fa-coins"></i>{{item.system.cost}}</span>
    </div>
  {{/if}}

  {{#if (eq type "container")}}
    <div class="wdm-w3-footer">
      <span class="wdm-w3-foot-cell" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.EmptyWeightKg'}}"><i class="fa-solid fa-weight-hanging"></i>{{item.system.weight}}</span>
      {{#if item.system.equipped}}
        <span class="wdm-w3-foot-cell" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.Equipped'}}"><i class="fa-solid fa-person-walking-luggage"></i>{{localize "WITCHER.Sheet.Item.Text.Worn"}}</span>
      {{/if}}
      <span class="wdm-w3-foot-spacer"></span>
      <span class="wdm-w3-foot-cell wdm-w3-price" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.Crowns'}}"><i class="fa-solid fa-coins"></i>{{item.system.cost}}</span>
    </div>
  {{/if}}

  {{#if (eq type "diagrams")}}
    <div class="wdm-w3-footer">
      <span class="wdm-w3-foot-cell" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.WeightKg'}}"><i class="fa-solid fa-weight-hanging"></i>{{item.system.weight}}</span>
      {{#unless (eq item.system.quantity 1)}}
        <span class="wdm-w3-foot-cell" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.Quantity'}}"><i class="fa-solid fa-layer-group"></i>×{{item.system.quantity}}</span>
      {{/unless}}
      <span class="wdm-w3-foot-spacer"></span>
      <span class="wdm-w3-foot-cell wdm-w3-rarity" title="{{localize 'WITCHER.Sheet.Item.Text.Availability'}}">{{localize (lookup config.availability item.system.availability)}}</span>
      <span class="wdm-w3-foot-cell wdm-w3-price" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.Crowns'}}"><i class="fa-solid fa-coins"></i>{{item.system.cost}}</span>
    </div>
  {{/if}}

  {{#if (eq type "remains")}}
    {{!-- Remains: weight-only footer; no quantity (always 1), no availability, no price. --}}
    <div class="wdm-w3-footer">
      <span class="wdm-w3-foot-cell" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.WeightKg'}}"><i class="fa-solid fa-weight-hanging"></i>{{item.system.weight}}</span>
    </div>
  {{/if}}

  {{#if (or (eq type "valuable") (eq type "map"))}}
    <div class="wdm-w3-footer">
      <span class="wdm-w3-foot-cell" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.WeightKg'}}"><i class="fa-solid fa-weight-hanging"></i>{{item.system.weight}}</span>
      {{#unless (eq item.system.quantity 1)}}
        <span class="wdm-w3-foot-cell" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.Quantity'}}"><i class="fa-solid fa-layer-group"></i>×{{item.system.quantity}}</span>
      {{/unless}}
      <span class="wdm-w3-foot-spacer"></span>
      <span class="wdm-w3-foot-cell wdm-w3-rarity" title="{{localize 'WITCHER.Sheet.Item.Text.Availability'}}">{{localize (lookup config.availability item.system.availability)}}</span>
      <span class="wdm-w3-foot-cell wdm-w3-price" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.Crowns'}}"><i class="fa-solid fa-coins"></i>{{item.system.cost}}</span>
    </div>
  {{/if}}

  {{#if (eq type "food")}}
    {{!-- Footer numbers are PORTION-SCALED: a half-eaten loaf weighs half
         what a full one weighs, and is worth half. The "per unit" raw
         numbers stay editable on the sheet — this view is what the carry
         tally actually counts. --}}
    <div class="wdm-w3-footer">
      <span class="wdm-w3-foot-cell" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.EffectiveWeightKgPortionScaled'}}"><i class="fa-solid fa-weight-hanging"></i>{{foodMeta.effectiveWeight}}</span>
      {{#unless (eq item.system.quantity 1)}}
        <span class="wdm-w3-foot-cell" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.QuantityFullUnitsInTheStack'}}"><i class="fa-solid fa-layer-group"></i>×{{item.system.quantity}}</span>
      {{/unless}}
      <span class="wdm-w3-foot-spacer"></span>
      <span class="wdm-w3-foot-cell wdm-w3-rarity" title="{{localize 'WITCHER.Sheet.Item.Text.Availability'}}">{{localize (lookup config.availability item.system.availability)}}</span>
      <span class="wdm-w3-foot-cell wdm-w3-price" title="{{localize 'WITCHER.Inspect.ItemCard.Tooltip.EffectiveValueCrownsPortionScaled'}}"><i class="fa-solid fa-coins"></i>{{foodMeta.effectiveCost}}</span>
    </div>
  {{/if}}

</div>
