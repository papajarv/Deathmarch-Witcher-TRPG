{{!-- Alchemical item sheet — two-layer (RAW Core p.83-95):
        DISPLAY  → Witcher 3 in-game tooltip aesthetic (player reads)
        CONFIG   → editable form (GM / owner with cog toggle)
      Hero is type-driven (computed in WitcherAlchemicalSheet):
        bomb                       → damage formula
        potion/decoction           → toxicity
        item/oil/other             → duration (or type label) --}}

<div class="wdm-item-sheet wdm-item-v2 is-alchemical" data-mode="{{mode}}">

  {{!-- ── Mode toggle (top-right) ─────────────────────────────── --}}
  {{#if canEdit}}
    <button type="button" class="wdm-item-cog" data-action="toggleItemMode"
            title="{{#if (eq mode 'config')}}{{localize 'WITCHER.Sheet.Item.Cog.BackToDisplay'}}{{else}}{{localize 'WITCHER.Sheet.Item.Cog.ConfigureItem'}}{{/if}}">
      <i class="fa-solid {{#if (eq mode 'config')}}fa-eye{{else}}fa-gear{{/if}}"></i>
    </button>
  {{/if}}

  {{!-- ════════════════════════════════════════════════════════════
       DISPLAY VIEW — Witcher 3 tooltip
       ═══════════════════════════════════════════════════════════ --}}
  <div class="wdm-display-view{{#if (hasFlair source.flairColor)}} has-flair{{/if}}" data-rarity="{{source.availability}}"{{#if (hasFlair source.flairColor)}} style="--wdm-rar: {{source.flairColor}}"{{/if}}>
    <div class="wdm-w3">

      <header class="wdm-w3-head">
        <img class="wdm-w3-portrait" src="{{item.img}}" alt="" />
        <div class="wdm-w3-titles">
          <h1 class="wdm-w3-title">{{item.name}}</h1>
          <div class="wdm-w3-subtitle">{{typeLabel}}</div>
        </div>
        {{!-- Use button removed from the display header — the same
              action is reachable via the right-click context menu's
              Consume entry (module/chrome/policy/consume-item.js) and
              the chrome inventory rail. Duplicating it in the sheet
              header added no affordance, so drop it. --}}
      </header>

      <div class="wdm-w3-hero">
        <div class="wdm-w3-hero-value">{{heroValue}}</div>
        <div class="wdm-w3-hero-label">{{heroLabel}}</div>
        {{#if heroSub}}
          <div class="wdm-w3-hero-sub">{{heroSub}}</div>
        {{/if}}
      </div>

      <ul class="wdm-w3-stats">
        {{#if isBomb}}
          {{#if source.range}}
            <li class="wdm-w3-stat">
              <span class="val">{{source.range}}</span>
              <span class="lbl">{{localize 'WITCHER.Sheet.Alchemical.Text.ThrowingRange'}}</span>
            </li>
          {{/if}}
          {{#unless (eq source.area 0)}}
            <li class="wdm-w3-stat">
              <span class="val">{{source.area}}m</span>
              <span class="lbl">{{localize 'WITCHER.Sheet.Alchemical.Text.AreaOfEffect'}}</span>
            </li>
          {{/unless}}
        {{/if}}
        {{!-- Oil mechanic summary. Shown on every oil with a bonus
              regardless of toggle — the bonus damage / target are an
              authoring property of the oil itself, not a Reborn-only
              concept. --}}
        {{#if isOil}}
          {{!-- Charges (Reborn) / duration (RAW) are surfaced in the
                hero; only the bonus-damage / target row goes here so we
                don't repeat the same number twice on the display layer. --}}
          {{#if source.oilBonusDamage}}
            <li class="wdm-w3-stat">
              <span class="val">+{{source.oilBonusDamage}}</span>
              <span class="lbl">{{#if source.oilTarget}}vs {{localize (lookup WITCHER.monster.types source.oilTarget)}}{{else}}{{localize "WITCHER.AlchemyReborn.Oil.Target.Any"}}{{/if}}</span>
            </li>
          {{/if}}
        {{/if}}
        {{!-- Alchemy Reborn brew-base summary. baseSummary is built by the
              sheet context only when the toggle is on AND the item is
              configured as a base, so the row hides itself in every other
              case without needing a {{#if alchemyRebornOn}} wrapper. --}}
        {{#if baseSummary}}
          <li class="wdm-w3-stat" data-base-type="{{baseSummary.key}}">
            <span class="val">{{baseSummary.modSigned}} DC</span>
            <span class="lbl">{{baseSummary.typeLabel}}</span>
          </li>
        {{/if}}
      </ul>

      {{#if source.description}}
        <div class="wdm-w3-description">{{{source.description}}}</div>
      {{/if}}

      {{!-- Footer mirrors the weapon display: weight + qty + conceal on
           the left, availability + price anchored right. --}}
      <div class="wdm-w3-footer">
        <span class="wdm-w3-foot-cell" title="{{localize 'WITCHER.Sheet.Alchemical.Tooltip.WeightKg'}}"><i class="fa-solid fa-weight-hanging"></i>{{source.weight}}</span>
        {{#unless (eq source.quantity 1)}}
          <span class="wdm-w3-foot-cell" title="{{localize 'WITCHER.Sheet.Alchemical.Tooltip.Quantity'}}"><i class="fa-solid fa-layer-group"></i>×{{source.quantity}}</span>
        {{/unless}}
        {{#if source.conceal}}
          {{#unless (eq source.conceal "N/A")}}
            <span class="wdm-w3-foot-cell" title="{{localize 'WITCHER.Sheet.Item.Text.Concealability'}}"><i class="fa-solid fa-eye-slash"></i>{{localize (lookup WITCHER.concealment source.conceal)}}</span>
          {{/unless}}
        {{/if}}
        <span class="wdm-w3-foot-spacer"></span>
        <span class="wdm-w3-foot-cell wdm-w3-rarity" title="{{localize 'WITCHER.Sheet.Item.Text.Availability'}}">{{localize (lookup WITCHER.availability source.availability)}}</span>
        <span class="wdm-w3-foot-cell wdm-w3-price" title="{{localize 'WITCHER.Sheet.Alchemical.Tooltip.Crowns'}}"><i class="fa-solid fa-coins"></i>{{source.cost}}</span>
      </div>

    </div>
  </div>

  {{!-- ════════════════════════════════════════════════════════════
       CONFIG VIEW — compact spec form
       ═══════════════════════════════════════════════════════════ --}}
  <div class="wdm-config-view">
    <div class="wdm-cfg-form">

      <div class="wdm-cfg-head">
        <img class="wdm-cfg-portrait" src="{{item.img}}" data-action="editImage" data-edit="img" alt="" title="{{localize 'WITCHER.Sheet.Alchemical.Tooltip.ClickToChangeIcon'}}" />
        <input class="wdm-cfg-name" type="text" name="name" value="{{item.name}}" placeholder="{{localize 'WITCHER.Sheet.Alchemical.Hint.AlchemicalName'}}" />
      </div>

      <div class="wdm-cfg-section">{{localize 'WITCHER.Sheet.Alchemical.Text.Details'}}</div>
      <div class="wdm-cfg-grid">
        <label class="wdm-cfg-row"><span>{{localize 'WITCHER.Sheet.Alchemical.Text.Availability'}}</span>
          <select name="system.availability">
            {{#each WITCHER.availability}}
              <option value="{{@key}}" {{#if (eq @key ../source.availability)}}selected{{/if}}>{{localize this}}</option>
            {{/each}}
          </select>
        </label>
        {{> "systems/witcher-ttrpg-death-march/templates/item/partials/flair-override.hbs" flairColor=source.flairColor}}
        <label class="wdm-cfg-row"><span>{{localize 'WITCHER.Sheet.Alchemical.Text.Conceal'}}</span>
          <select name="system.conceal">
            {{#each WITCHER.concealment}}
              <option value="{{@key}}" {{#if (eq @key ../source.conceal)}}selected{{/if}}>{{localize this}}</option>
            {{/each}}
          </select>
        </label>
        <label class="wdm-cfg-row"><span>{{localize 'WITCHER.Sheet.Alchemical.Text.WeightKg'}}</span>
          <input type="number" step="0.01" min="0" name="system.weight" value="{{source.weight}}" />
        </label>
        <label class="wdm-cfg-row"><span>{{localize 'WITCHER.Sheet.Alchemical.Text.Cost'}}</span>
          <input type="number" min="0" name="system.cost" value="{{source.cost}}" />
        </label>
        <label class="wdm-cfg-row"><span>{{localize 'WITCHER.Sheet.Alchemical.Text.Quantity'}}</span>
          <input type="number" min="0" name="system.quantity" value="{{source.quantity}}" />
        </label>
      </div>

      <div class="wdm-cfg-section">{{localize 'WITCHER.Sheet.Alchemical.Text.Classification'}}</div>
      <div class="wdm-cfg-grid">
        <label class="wdm-cfg-row"><span>{{localize 'WITCHER.Sheet.Alchemical.Text.Type'}}</span>
          <select name="system.type">
            {{#each WITCHER.alchemical.types}}
              <option value="{{@key}}" {{#if (eq @key ../source.type)}}selected{{/if}}>{{localize this}}</option>
            {{/each}}
          </select>
        </label>
        {{#if hasToxicity}}
          <label class="wdm-cfg-row"><span>{{localize 'WITCHER.Sheet.Alchemical.Text.Toxicity'}}</span>
            <input type="number" min="0" name="system.toxicity" value="{{source.toxicity}}"
                   title="{{localize 'WITCHER.Sheet.Alchemical.Tip.Toxicity'}}" />
          </label>
        {{/if}}
        {{#unless isBomb}}
          {{#unless isOil}}
            {{!-- Free-text duration for potions / decoctions / items.
                  Oils get their own structured oilDuration block below
                  (RAW mode) and don't read this string. --}}
            <label class="wdm-cfg-row"><span>{{localize 'WITCHER.Sheet.Alchemical.Text.Duration'}}</span>
              <input type="text" name="system.duration" value="{{source.duration}}" placeholder="e.g. 1 hour, 10 rounds" />
            </label>
          {{/unless}}
        {{/unless}}
        {{#if isConsumableType}}
          <label class="wdm-cfg-row"><span>{{localize 'WITCHER.Sheet.Alchemical.Text.Consumable'}}</span>
            <input type="checkbox" name="system.consumable" {{#if source.consumable}}checked{{/if}}
                   title="{{localize 'WITCHER.Sheet.Alchemical.Tooltip.WhenUsedHotbarRightClickSpendOneDoseAndA'}}" />
          </label>
        {{/if}}
      </div>

      {{#if isOil}}
        {{!-- Oil mechanic — replaces the AE-on-oil approach. An oil declares
              what monster category it bites, how much bonus damage it adds,
              and how long a coating lasts (RAW). Alchemy Reborn ignores the
              duration and runs the coating off charges instead (Normal=5,
              Enhanced=10, Superior=15, tier from item-name suffix). --}}
        <div class="wdm-cfg-section">{{localize "WITCHER.AlchemyReborn.Oil.Section"}}</div>
        <div class="wdm-cfg-grid">
          <label class="wdm-cfg-row"><span>{{localize "WITCHER.AlchemyReborn.Oil.Target.Label"}}</span>
            <select name="system.oilTarget" title="{{localize 'WITCHER.AlchemyReborn.Oil.Target.Hint'}}">
              <option value="" {{#if (eq source.oilTarget "")}}selected{{/if}}>{{localize "WITCHER.AlchemyReborn.Oil.Target.Any"}}</option>
              {{#each WITCHER.monster.types}}
                <option value="{{@key}}" {{#if (eq @key ../source.oilTarget)}}selected{{/if}}>{{localize this}}</option>
              {{/each}}
            </select>
          </label>
          <label class="wdm-cfg-row"><span>{{localize "WITCHER.AlchemyReborn.Oil.Bonus.Label"}}</span>
            <input type="number" min="0" step="1" name="system.oilBonusDamage" value="{{source.oilBonusDamage}}"
                   title="{{localize 'WITCHER.AlchemyReborn.Oil.Bonus.Hint'}}" />
          </label>
          {{#if alchemyRebornOn}}
            {{!-- Reborn replaces duration with a charge counter — the
                  coating lasts N successful-damaging hits regardless of
                  wall-clock time. Authored per-oil so the GM (or the
                  install macro) can set Normal=5 / Enhanced=10 / Superior=15
                  to match the source-sheet tier table. --}}
            <label class="wdm-cfg-row"><span>{{localize "WITCHER.AlchemyReborn.Oil.Charges.Label"}}</span>
              <input type="number" min="0" step="1" name="system.oilCharges" value="{{source.oilCharges}}"
                     title="{{localize 'WITCHER.AlchemyReborn.Oil.Charges.Hint'}}" />
            </label>
          {{else}}
            <label class="wdm-cfg-row"><span>{{localize "WITCHER.AlchemyReborn.Oil.Duration.Value"}}</span>
              <input type="number" min="0" step="1" name="system.oilDuration.value" value="{{source.oilDuration.value}}" />
            </label>
            <label class="wdm-cfg-row"><span>{{localize "WITCHER.AlchemyReborn.Oil.Duration.Units"}}</span>
              <select name="system.oilDuration.units">
                <option value="seconds" {{#if (eq source.oilDuration.units "seconds")}}selected{{/if}}>{{localize "WITCHER.AlchemyReborn.Oil.Duration.Seconds"}}</option>
                <option value="minutes" {{#if (eq source.oilDuration.units "minutes")}}selected{{/if}}>{{localize "WITCHER.AlchemyReborn.Oil.Duration.Minutes"}}</option>
                <option value="hours"   {{#if (eq source.oilDuration.units "hours")}}selected{{/if}}>{{localize "WITCHER.AlchemyReborn.Oil.Duration.Hours"}}</option>
                <option value="days"    {{#if (eq source.oilDuration.units "days")}}selected{{/if}}>{{localize "WITCHER.AlchemyReborn.Oil.Duration.Days"}}</option>
              </select>
            </label>
          {{/if}}
        </div>
      {{/if}}

      {{#if isBomb}}
        <div class="wdm-cfg-section">{{localize 'WITCHER.Sheet.Alchemical.Text.Bomb'}}</div>
        <div class="wdm-cfg-grid">
          <label class="wdm-cfg-row"><span>{{localize 'WITCHER.Sheet.Alchemical.Text.Damage'}}</span>
            <input type="text" name="system.damage" value="{{source.damage}}" placeholder="5d6" />
          </label>
          <label class="wdm-cfg-row"><span>{{localize 'WITCHER.Sheet.Alchemical.Text.DamageType'}}</span>
            <select name="system.damageType">
              <option value="" {{#if (eq source.damageType "")}}selected{{/if}}>— none —</option>
              {{#each WITCHER.damageTypes}}
                <option value="{{@key}}" {{#if (eq @key ../source.damageType)}}selected{{/if}}>{{localize this}}</option>
              {{/each}}
            </select>
          </label>
          <label class="wdm-cfg-row"><span>{{localize 'WITCHER.Sheet.Alchemical.Text.Range'}}</span>
            <input type="text" name="system.range" value="{{source.range}}" placeholder="e.g. 10 or BODYx4" />
          </label>
          <label class="wdm-cfg-row"><span>{{localize 'WITCHER.Sheet.Alchemical.Text.AreaM'}}</span>
            <input type="number" min="0" name="system.area" value="{{source.area}}" />
          </label>
        </div>
      {{/if}}

      {{!-- Effects tab.
            For OILS, the AEs authored here become the on-hit status effects
            that apply to any actor damaged by a weapon coated with this oil.
            Each AE row shows in the standard editor — author freely, or pick
            from an existing world/status entry via the "Add existing status"
            button below.
            For non-oil alchemicals, the AEs are conventional on-consume AEs
            transferred to the drinker.  --}}
      {{#if isOil}}
      <div class="wdm-cfg-section">{{localize "WITCHER.Sheet.Alchemical.Text.OnHitStatuses"}} <span class="wdm-cfg-sub">({{localize "WITCHER.Sheet.Alchemical.Text.OnHitStatusesSub"}})</span></div>
      {{else}}
      <div class="wdm-cfg-section">{{localize 'WITCHER.Sheet.Alchemical.Text.Effects'}} <span class="wdm-cfg-sub">(Foundry Active Effects)</span></div>
      {{/if}}
      <div class="wdm-cfg-effects">
        {{#if effects.length}}
          <ul class="wdm-effect-list">
            {{#each effects}}
              <li class="wdm-effect-row {{#if this.disabled}}is-disabled{{/if}}" data-effect-id="{{this.id}}">
                <div class="wdm-effect-head">
                  <img class="wdm-effect-img" src="{{this.img}}" alt="" />
                  <span class="wdm-effect-name">{{this.name}}</span>
                  {{#if this.duration.label}}<span class="wdm-effect-duration">{{this.duration.label}}</span>{{/if}}
                  <a data-action="toggleEffect" data-effect-id="{{this.id}}" title="{{#if this.disabled}}Enable{{else}}Disable{{/if}}">
                    <i class="fa-solid {{#if this.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i>
                  </a>
                  <a data-action="editEffect" data-effect-id="{{this.id}}" title="{{localize 'WITCHER.Sheet.Alchemical.Tooltip.Edit'}}"><i class="fa-solid fa-pen-to-square"></i></a>
                  <a data-action="deleteEffect" data-effect-id="{{this.id}}" title="{{localize 'WITCHER.Sheet.Alchemical.Tooltip.Delete'}}"><i class="fa-solid fa-trash"></i></a>
                </div>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p class="wdm-empty">{{localize 'WITCHER.Sheet.Alchemical.Text.NoEffectsConfigured'}}</p>
        {{/if}}
        <button type="button" class="wdm-add-effect" data-action="createEffect">
          <i class="fa-solid fa-plus"></i> {{localize 'WITCHER.Sheet.Item.Button.AddEffect'}}
        </button>
      </div>

      {{!-- Alchemy Reborn: configure this alchemical as a brew base. Most
            commonly used for oil bases (Sunflower Oil etc.); potion bases
            usually live on food (drinks) instead. Hidden when the homebrew
            toggle is off so the RAW alchemical sheet stays uncluttered. --}}
      {{#if alchemyRebornOn}}
        <div class="wdm-cfg-section">{{localize "WITCHER.AlchemyReborn.Section.Base"}}</div>
        <div class="wdm-cfg-grid">
          <label class="wdm-cfg-row"><span>{{localize "WITCHER.AlchemyReborn.Base.Enable.Label"}}</span>
            <input type="checkbox" name="system.alchemyBase.enabled" {{#if source.alchemyBase.enabled}}checked{{/if}}
                   title="{{localize 'WITCHER.AlchemyReborn.Base.Enable.Hint'}}" />
          </label>
          {{#if source.alchemyBase.enabled}}
            <label class="wdm-cfg-row"><span>{{localize "WITCHER.AlchemyReborn.Base.Type.Label"}}</span>
              <select name="system.alchemyBase.baseType">
                <option value=""          {{#if (eq source.alchemyBase.baseType "")}}selected{{/if}}>— choose —</option>
                <option value="potion"    {{#if (eq source.alchemyBase.baseType "potion")}}selected{{/if}}>{{localize "WITCHER.AlchemyReborn.Base.Type.Potion"}}</option>
                <option value="oil"       {{#if (eq source.alchemyBase.baseType "oil")}}selected{{/if}}>{{localize "WITCHER.AlchemyReborn.Base.Type.Oil"}}</option>
                <option value="bomb"      {{#if (eq source.alchemyBase.baseType "bomb")}}selected{{/if}}>{{localize "WITCHER.AlchemyReborn.Base.Type.Bomb"}}</option>
              </select>
            </label>
            <label class="wdm-cfg-row"><span>{{localize "WITCHER.AlchemyReborn.Base.Mod.Label"}}</span>
              <input type="number" step="1" name="system.alchemyBase.baseMod" value="{{source.alchemyBase.baseMod}}"
                     title="{{localize 'WITCHER.AlchemyReborn.Base.Mod.Hint'}}" />
            </label>
          {{/if}}
        </div>
      {{/if}}

      {{> "systems/witcher-ttrpg-death-march/templates/item/partials/source-field.hbs" value=source.source}}

      <div class="wdm-cfg-section">{{localize 'WITCHER.Sheet.Alchemical.Text.Description'}}</div>
      <textarea class="wdm-cfg-textarea" name="system.description" placeholder="{{localize 'WITCHER.Sheet.Alchemical.Hint.AlchemicalLoreAppearanceProvenance'}}">{{source.description}}</textarea>

    </div>
  </div>

</div>
