{{!-- Note item sheet — two-layer (narrative items: clues, letters, postings):
        DISPLAY  → Witcher 3 in-game tooltip aesthetic (player reads)
        CONFIG   → editable form (cog toggle, owners only)
      Amber default accent. The text content IS the hero. A note can be
      dropped onto a scene to pin it as a notice-board parchment posting
      (see module/chrome/chrome/parchments.js). --}}

<div class="wdm-item-sheet wdm-item-v2" data-mode="{{mode}}">

  {{#if canEdit}}
    <button type="button" class="wdm-item-cog" data-action="toggleItemMode"
            title="{{#if (eq mode 'config')}}{{localize 'WITCHER.Sheet.Item.Cog.BackToDisplay'}}{{else}}{{localize 'WITCHER.Sheet.Item.Cog.ConfigureItem'}}{{/if}}">
      <i class="fa-solid {{#if (eq mode 'config')}}fa-eye{{else}}fa-gear{{/if}}"></i>
    </button>
  {{/if}}

  {{!-- ════════════════════════════════════════════════════════════
       DISPLAY VIEW — Witcher 3 tooltip layout
       ═══════════════════════════════════════════════════════════ --}}
  <div class="wdm-display-view">
    <div class="wdm-w3">

      <header class="wdm-w3-head">
        <img class="wdm-w3-portrait" src="{{item.img}}" alt="" />
        <div class="wdm-w3-titles">
          <h1 class="wdm-w3-title">{{item.name}}</h1>
          <div class="wdm-w3-subtitle">{{localize 'WITCHER.Sheet.Note.Text.Note'}}</div>
        </div>
      </header>

      {{#if source.description}}
        <div class="wdm-w3-section-label">{{localize 'WITCHER.Sheet.Note.Text.Content'}}</div>
        <div class="wdm-w3-effects">{{{source.description}}}</div>
      {{else}}
        <div class="wdm-w3-effects wdm-empty">{{localize 'WITCHER.Sheet.Note.Text.NoContentYet'}}</div>
      {{/if}}

      <div class="wdm-w3-pin-hint">
        <i class="fa-solid fa-thumbtack"></i>
    {{localize 'WITCHER.Sheet.Note.Text.PinBlurb'}}
  </div>

    </div>
  </div>

  {{!-- ════════════════════════════════════════════════════════════
       CONFIG VIEW — compact tech form.
       ═══════════════════════════════════════════════════════════ --}}
  <div class="wdm-config-view">
    <div class="wdm-cfg-form">

      <div class="wdm-cfg-head">
        <img class="wdm-cfg-portrait" src="{{item.img}}" data-action="editImage" data-edit="img" alt="" title="{{localize 'WITCHER.Sheet.Note.Tooltip.ClickToChangeIcon'}}" />
        <input class="wdm-cfg-name" type="text" name="name" value="{{item.name}}" placeholder="{{localize 'WITCHER.Sheet.Note.Hint.NoteTitle'}}" />
      </div>

      <div class="wdm-cfg-section">{{localize 'WITCHER.Sheet.Note.Text.Details'}}</div>
      <div class="wdm-cfg-grid">
        <label class="wdm-cfg-row"><span title="{{localize 'WITCHER.Sheet.Note.Tooltip.StackSize'}}">{{localize 'WITCHER.Sheet.Note.Label.Quantity'}}</span>
          <input type="number" min="0" name="system.quantity" value="{{source.quantity}}" />
        </label>
        <label class="wdm-cfg-row"><span title="{{localize 'WITCHER.Sheet.Note.Tooltip.WeightPerUnitNotesAreNonEncumbering'}}">{{localize 'WITCHER.Sheet.Note.Label.WeightKg'}}</span>
          <input type="number" step="0.01" min="0" name="system.weight" value="{{source.weight}}" />
        </label>
      </div>

      <div class="wdm-cfg-section">{{localize 'WITCHER.Sheet.Note.Text.Content'}}</div>
      <textarea class="wdm-cfg-textarea is-tall" name="system.description"
                placeholder="{{localize 'WITCHER.Sheet.Note.Hint.TheTextOnThePageTheContentsOfTheJournalT'}}">{{source.description}}</textarea>

      {{> "systems/witcher-ttrpg-death-march/templates/item/partials/source-field.hbs" value=source.source}}

    </div>
  </div>

</div>
