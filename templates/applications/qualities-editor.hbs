{{!-- Qualities Editor — GM-only world settings form.
      Two catalogs (weapon, armor), one card per quality, every entry
      field exposed as a friendly control. Field names are
      `<prefix>.<index>.<field>` (w = weapon, a = armor); the app reads
      them back with FormDataExtended + expandObject and diffs each card
      against the seed default on save. No JSON. --}}

<div class="wdm-qe">

  <header class="wdm-qe-head">
    <h2>{{localize 'WITCHER.App.QualitiesEditor.Text.WeaponArmorQualities'}}</h2>
    <p class="wdm-qe-blurb">
    {{localize 'WITCHER.App.QualitiesEditor.Blurb'}}
  <code>%</code>, Silver's dice
      formula, Focus's number). Untouched qualities keep the built-in defaults.
    </p>
  </header>

  {{#each catalogs as |cat|}}
  <section class="wdm-qe-section">
    <div class="wdm-qe-section-head">
      <h3>{{cat.label}}</h3>
      <button type="button" class="wdm-se-btn" data-action="addQuality" data-catalog="{{cat.name}}">
        <i class="fa-solid fa-plus"></i> {{localize 'WITCHER.App.QualitiesEditor.Button.Add'}}
      </button>
      <button type="button" class="wdm-qe-reset" data-action="resetCatalog" data-catalog="{{cat.name}}"
              title="{{localize 'WITCHER.App.QualitiesEditor.Tooltip.DiscardYourOverrideRevertToSystemDefault'}}">
        <i class="fa-solid fa-arrow-rotate-left"></i> {{localize 'WITCHER.App.QualitiesEditor.Button.ResetToDefaults'}}
      </button>
    </div>

    <div class="wdm-qe-list">
      {{#each cat.rows as |q|}}
      <details class="wdm-qe-card">
        <summary class="wdm-qe-card-summary">
          <span class="wdm-qe-sum-name">{{q.label}}</span>
          <code class="wdm-qe-sum-key">{{q.key}}</code>
        </summary>
        <div class="wdm-qe-card-body">
        <input type="hidden" name="{{cat.prefix}}.{{q.index}}.isDefault" value="{{q.isDefault}}" />

        <div class="wdm-qe-card-head">
          <label class="wdm-se-field wdm-qe-name">
            <span class="wdm-se-label">{{localize 'WITCHER.App.QualitiesEditor.Text.Name'}}</span>
            <input type="text" name="{{cat.prefix}}.{{q.index}}.label" value="{{q.label}}" />
          </label>
          <label class="wdm-se-field wdm-qe-key">
            <span class="wdm-se-label">Key
              {{#if q.isDefault}}<span class="wdm-se-tag">built-in</span>{{/if}}
            </span>
            <input type="text" name="{{cat.prefix}}.{{q.index}}.key" value="{{q.key}}"
                   {{#if q.isDefault}}readonly{{/if}} placeholder="camelCaseKey" />
          </label>
          <button type="button" class="wdm-se-remove" data-action="removeQuality"
                  data-catalog="{{cat.name}}" data-index="{{q.index}}" title="{{localize 'WITCHER.App.QualitiesEditor.Tooltip.RemoveThisQuality'}}">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>

        <label class="wdm-se-field">
          <span class="wdm-se-label">{{localize 'WITCHER.App.QualitiesEditor.Text.Description'}}</span>
          <textarea name="{{cat.prefix}}.{{q.index}}.description" rows="2" spellcheck="false">{{q.description}}</textarea>
        </label>

        <div class="wdm-qe-param">
          <label class="wdm-se-mini">
            <span>{{localize 'WITCHER.App.QualitiesEditor.Text.Parameter'}}</span>
            <select name="{{cat.prefix}}.{{q.index}}.paramType">
              {{#each q.paramTypeOptions as |o|}}
              <option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>
              {{/each}}
            </select>
          </label>
          <label class="wdm-se-mini">
            <span>{{localize 'WITCHER.App.QualitiesEditor.Text.Placeholder'}}</span>
            <input type="text" name="{{cat.prefix}}.{{q.index}}.paramPlaceholder" value="{{q.paramPlaceholder}}"
                   placeholder="e.g. 25" />
          </label>
          <label class="wdm-se-mini">
            <span>{{localize 'WITCHER.App.QualitiesEditor.Text.Suffix'}}</span>
            <input type="text" name="{{cat.prefix}}.{{q.index}}.paramSuffix" value="{{q.paramSuffix}}"
                   placeholder="e.g. %" />
          </label>
        </div>

        {{!-- Damage-pipeline flags — wired into the damage calculator on
              every hit involving this quality.  Checkboxes are derived from
              DAMAGE_FLAG_KEYS so adding a new flag is one-line. --}}
        <div class="wdm-qe-section-label">{{localize 'WITCHER.App.QualitiesEditor.Text.DamageFlags'}}</div>
        <div class="wdm-qe-flags">
          {{#each q.flagControls as |f|}}
          <label class="wdm-se-check">
            <input type="checkbox" name="{{../cat.prefix}}.{{../q.index}}.flags.{{f.key}}"
                   {{#if f.checked}}checked{{/if}} />
            <span>{{f.label}}</span>
          </label>
          {{/each}}
        </div>

        {{!-- Tactical flags — read by combat-flow code (not the damage
              pipeline). Grid is driven by TACTICAL_FLAG_KEYS so adding a
              new flag is one line in the editor + one consumer wired in
              the appropriate engine surface. --}}
        <div class="wdm-qe-section-label">{{localize 'WITCHER.App.QualitiesEditor.Text.TacticalFlags'}}</div>
        <div class="wdm-qe-flags">
          {{#each q.tacticalControls as |t|}}
          <label class="wdm-se-check">
            <input type="checkbox" name="{{../cat.prefix}}.{{../q.index}}.tacticalFlags.{{t.key}}"
                   {{#if t.checked}}checked{{/if}} />
            <span>{{t.label}}</span>
          </label>
          {{/each}}
        </div>

        {{!-- Numeric effects — read by combat-flow / cast-flow consumers
              that scan a bearer's equipped weapons for the quality. Leave
              at 0 to disable. Each entry is one editable input. --}}
        {{#if q.numericControls.length}}
        <div class="wdm-qe-section-label">{{localize 'WITCHER.App.QualitiesEditor.Text.NumericEffects'}}</div>
        <div class="wdm-qe-flags">
          {{#each q.numericControls as |n|}}
          <label class="wdm-se-mini" title="{{n.hint}}">
            <span>{{n.label}}</span>
            <input type="number" name="{{../cat.prefix}}.{{../q.index}}.numerics.{{n.key}}"
                   value="{{n.value}}" step="1" min="0" />
          </label>
          {{/each}}
        </div>
        {{/if}}

        {{!-- String effects — currently just skillOverride (forces the
              weapon's attack roll onto a specific skillMap key, e.g.
              "brawling" for a Brawling-quality weapon). --}}
        {{#if q.stringControls.length}}
        <div class="wdm-qe-section-label">{{localize 'WITCHER.App.QualitiesEditor.Text.StringEffects'}}</div>
        <div class="wdm-qe-flags">
          {{#each q.stringControls as |s|}}
          <label class="wdm-se-mini" title="{{s.hint}}">
            <span>{{s.label}}</span>
            <input type="text" name="{{../cat.prefix}}.{{../q.index}}.strings.{{s.key}}"
                   value="{{s.value}}" placeholder="e.g. brawling" />
          </label>
          {{/each}}
        </div>
        {{/if}}

        {{!-- Status rider — pick a kind and a status effect to apply when
              the hit lands.  Status dropdown is fed from CONFIG.statusEffects
              so any GM-added status appears here automatically.  Stun-save
              kind reveals the optional location filter. --}}
        <div class="wdm-qe-section-label">{{localize 'WITCHER.App.QualitiesEditor.Text.StatusRider'}} <span class="wdm-qe-section-sub">(applied on a damaging hit)</span></div>
        <div class="wdm-qe-rider">
          <label class="wdm-se-mini">
            <span>{{localize 'WITCHER.App.QualitiesEditor.Text.Kind'}}</span>
            <select name="{{cat.prefix}}.{{q.index}}.riderKind">
              {{#each q.riderKindOptions as |o|}}
              <option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>
              {{/each}}
            </select>
          </label>
          <label class="wdm-se-mini">
            <span>{{localize 'WITCHER.App.QualitiesEditor.Text.StatusEffect'}}</span>
            <select name="{{cat.prefix}}.{{q.index}}.riderStatus">
              {{#each q.riderStatusOptions as |o|}}
              <option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>
              {{/each}}
            </select>
          </label>
          {{#if q.riderHasLocations}}
          <label class="wdm-se-mini wdm-qe-rider-locs">
            <span title="Comma-separated location keys this rider fires on (defaults to head, torso for Stun Save). Available: {{q.riderLocationKeysHint}}">{{localize 'WITCHER.App.QualitiesEditor.Text.Locations'}}</span>
            <input type="text" name="{{cat.prefix}}.{{q.index}}.riderLocations"
                   value="{{q.riderLocations}}" placeholder="head, torso" />
          </label>
          {{else}}
          {{!-- Preserve the value when kind is not stunSave so toggling
                back doesn't lose the user's previous location filter. --}}
          <input type="hidden" name="{{cat.prefix}}.{{q.index}}.riderLocations" value="{{q.riderLocations}}" />
          {{/if}}
        </div>
        </div>
      </details>
      {{/each}}
    </div>
  </section>
  {{/each}}

</div>
