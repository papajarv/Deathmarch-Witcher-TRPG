{{!-- Stress Configuration — GM-only world settings menu. Edits one Object
      setting (`stressConfig`); save reloads the world. --}}
<div class="wdm-stress-config-body">

  <header class="wdm-se-head">
    <h2><i class="fa-solid fa-brain"></i> {{localize 'WITCHER.App.StressConfig.Text.StressConfiguration'}}</h2>
    <p class="wdm-se-blurb">
    {{localize 'WITCHER.App.StressConfig.Blurb'}}
  </p>
  </header>

  <details class="wdm-se-group" open>
    <summary>{{localize 'WITCHER.App.StressConfig.Text.WillSaveRecovery'}}</summary>

    <label class="wdm-se-check">
      <input type="checkbox" name="recoveryPenaltyEnabled" {{#if values.recoveryPenaltyEnabled}}checked{{/if}} />
      <span><b>{{localize 'WITCHER.App.StressConfig.Text.StressOverWillSlowsNaturalHealing'}}</b> — when the character heals HP from rest, they lose <em>(stress − WILL)</em> from the amount restored. Off = stress only affects mental breaks, never physical recovery.</span>
    </label>

    <div class="wdm-se-row">
      <label class="wdm-se-mini" title="{{localize 'WITCHER.App.StressConfig.Tooltip.EachPointOfStressOverWillHitsTheWillSave'}}">
        <span>{{localize 'WITCHER.App.StressConfig.Text.HowHardEachPointOverWillHurtsTheSave'}}</span>
        <input type="number" step="0.1" min="0" name="thresholdPenaltyMultiplier"
               value="{{values.thresholdPenaltyMultiplier}}" />
      </label>
      <label class="wdm-se-mini" title="{{localize 'WITCHER.App.StressConfig.Tooltip.AfterEveryWillSaveStressSettlesToWillThi'}}">
        <span>{{localize 'WITCHER.App.StressConfig.Text.StressRemainingAfterAWillSaveRelativeToW'}}</span>
        <input type="number" step="1" name="postSaveClearOffset"
               value="{{values.postSaveClearOffset}}" />
      </label>
      <label class="wdm-se-mini" title="{{localize 'WITCHER.App.StressConfig.Tooltip.HowManyDistinctMentalBreaksACharacterCan'}}">
        <span>{{localize 'WITCHER.App.StressConfig.Text.MentalBreaksBeforeCharacterIsLost'}}</span>
        <input type="number" step="1" min="1" max="8" name="breakdownCap"
               value="{{values.breakdownCap}}" />
      </label>
    </div>
  </details>

  <details class="wdm-se-group" open>
    <summary>{{localize 'WITCHER.App.StressConfig.Text.CriticalWounds'}}</summary>

    <label class="wdm-se-check">
      <input type="checkbox" name="woundStressEnabled" {{#if values.woundStressEnabled}}checked{{/if}} />
      <span><b>{{localize 'WITCHER.App.StressConfig.Text.TakingACriticalWoundAddsStress'}}</b> — the listed amount lands once when the wound first appears on the character. Pulling the wound back out (item move, healing, GM cleanup) does not refund it.</span>
    </label>

    <div class="wdm-se-row">
      <label class="wdm-se-mini">
        <span>{{localize 'WITCHER.App.StressConfig.Text.SimpleWound'}}</span>
        <input type="number" step="1" min="0" name="woundStressSimple"
               value="{{values.woundStressSimple}}" />
      </label>
      <label class="wdm-se-mini">
        <span>{{localize 'WITCHER.App.StressConfig.Text.ComplexWound'}}</span>
        <input type="number" step="1" min="0" name="woundStressComplex"
               value="{{values.woundStressComplex}}" />
      </label>
      <label class="wdm-se-mini">
        <span>{{localize 'WITCHER.App.StressConfig.Text.DifficultWound'}}</span>
        <input type="number" step="1" min="0" name="woundStressDifficult"
               value="{{values.woundStressDifficult}}" />
      </label>
      <label class="wdm-se-mini">
        <span>{{localize 'WITCHER.App.StressConfig.Text.DeadlyWound'}}</span>
        <input type="number" step="1" min="0" name="woundStressDeadly"
               value="{{values.woundStressDeadly}}" />
      </label>
    </div>
  </details>

  <div class="wdm-se-spacer" style="height:18px;"></div>

  <details class="wdm-se-group" open>
    <summary>{{localize 'WITCHER.App.StressConfig.Text.Books'}}</summary>

    <label class="wdm-se-check">
      <input type="checkbox" name="bookFailStressEnabled" {{#if values.bookFailStressEnabled}}checked{{/if}} />
      <span><b>{{localize 'WITCHER.App.StressConfig.Text.FailedBookReadingsAddStress'}}</b> — {{localize 'WITCHER.App.StressConfig.Text.FailedBookReadingsAddStressHint'}}</span>
    </label>

    <div class="wdm-se-row">
      <label class="wdm-se-mini" title="{{localize 'WITCHER.App.StressConfig.Tooltip.BookFailStressAmount'}}">
        <span>{{localize 'WITCHER.App.StressConfig.Text.StressPerFailedReading'}}</span>
        <input type="number" step="1" min="0" name="bookFailStressAmount"
               value="{{values.bookFailStressAmount}}" />
      </label>
    </div>
  </details>

</div>
