  "WITCHER.Weather.Config.Dusk": "Crépuscule (heure)",
  "WITCHER.Weather.Config.Field.cloudBias": "Couverture nuageuse",
  "WITCHER.Weather.Config.Field.color": "Couleur de la carte",
