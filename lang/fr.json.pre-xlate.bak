  "WITCHER.App.CarouselInitiativeConfig.Section.General": "Général",
  "WITCHER.App.CarouselInitiativeConfig.Section.Layout": "Disposition & dimensions",
  "WITCHER.App.CarouselInitiativeConfig.Section.Motion": "Animations & transitions",
  "WITCHER.App.CarouselInitiativeConfig.Text.ActiveGlowColor": "Halo du tour actif",
  "WITCHER.App.CarouselInitiativeConfig.Text.ActiveScale": "Échelle de la carte active",
  "WITCHER.App.CarouselInitiativeConfig.Text.CardGap": "Écart entre les cartes",
  "WITCHER.App.CarouselInitiativeConfig.Text.CardHeight": "Hauteur des cartes",
  "WITCHER.App.CarouselInitiativeConfig.Text.CardWidth": "Largeur des cartes",
  "WITCHER.App.CarouselInitiativeConfig.Text.ContainerMaxWidth": "Largeur maximale du conteneur",
  "WITCHER.App.CarouselInitiativeConfig.Text.EnabledDesc": "Interrupteur principal du carrousel d'initiative. Quand désactivé, le suivi n'est pas rendu du tout — cette option nécessite un rechargement du monde pour prendre pleinement effet.",
  "WITCHER.App.CarouselInitiativeConfig.Text.EnabledName": "Activer le carrousel d'initiative",
  "WITCHER.App.CarouselInitiativeConfig.Text.FriendlyColor": "Allié (vert)",
  "WITCHER.App.CarouselInitiativeConfig.Text.HideSecretDesc": "Les combattants dont la disposition du jeton est SECRET sont masqués aux joueurs, à la fois dans le carrousel et dans le suivi latéral.",
  "WITCHER.App.CarouselInitiativeConfig.Text.HideSecretName": "Masquer les combattants SECRET aux joueurs",
  "WITCHER.App.CarouselInitiativeConfig.Text.HideStealthDesc": "Les combattants furtifs via le sous-système de furtivité sont masqués aux joueurs — sous réserve de la bascule de visibilité par repéreur ci-dessous.",
  "WITCHER.App.CarouselInitiativeConfig.Text.HideStealthName": "Masquer les combattants furtifs aux joueurs",
  "WITCHER.App.CarouselInitiativeConfig.Text.HostileColor": "Hostile (rouge)",
  "WITCHER.App.CarouselInitiativeConfig.Text.NeutralColor": "Couleur neutre",
  "WITCHER.App.CarouselInitiativeConfig.Text.NeutralShowFrameDesc": "Quand activé, les combattants de disposition neutre reçoivent un cadre coloré utilisant la couleur ci-dessous. Quand désactivé (défaut), les combattants neutres n'ont aucun cadre visible — la largeur de bordure réserve tout de même 2px pour que les cartes conservent une taille uniforme.",
  "WITCHER.App.CarouselInitiativeConfig.Text.NeutralShowFrameName": "Afficher un cadre pour les combattants neutres",
  "WITCHER.App.CarouselInitiativeConfig.Text.PortraitHeight": "Hauteur du portrait",
  "WITCHER.App.CarouselInitiativeConfig.Text.SecretColor": "Secret (violet)",
  "WITCHER.App.CarouselInitiativeConfig.Text.ShowForGMDesc": "Quand désactivé, le carrousel est masqué pour les utilisateurs MJ. Pratique pour les MJ qui préfèrent n'utiliser que le suivi latéral.",
  "WITCHER.App.CarouselInitiativeConfig.Text.ShowForGMName": "Afficher le carrousel au MJ",
  "WITCHER.App.CarouselInitiativeConfig.Text.ShowForPlayersDesc": "Quand désactivé, le carrousel est masqué pour les joueurs. Le suivi latéral continue de s'afficher selon le comportement normal de Foundry.",
  "WITCHER.App.CarouselInitiativeConfig.Text.ShowForPlayersName": "Afficher le carrousel aux joueurs",
  "WITCHER.App.CarouselInitiativeConfig.Text.ShowTheaterDesc": "Quand activé, le carrousel est affiché pour les combats en théâtre de l'esprit (où aucun combattant n'a de jeton sur la scène). Désactivez-le si vous utilisez le suivi latéral pour les combats sans jetons.",
  "WITCHER.App.CarouselInitiativeConfig.Text.ShowTheaterName": "Afficher pour le combat en théâtre de l'esprit",
  "WITCHER.App.CarouselInitiativeConfig.Text.ShowTokenCombatDesc": "Quand activé, le carrousel est affiché pour les combats où au moins un combattant possède un jeton sur la scène. Désactivez-le si vous ne voulez le carrousel que pour les combats en théâtre de l'esprit.",
  "WITCHER.App.CarouselInitiativeConfig.Text.ShowTokenCombatName": "Afficher pour le combat sur jetons",
  "WITCHER.App.CarouselInitiativeConfig.Text.SnapWrapDesc": "Quand activé, le carrousel se cale instantanément (sans animation de glissement) quand le round revient au premier combattant. Sinon la bande s'anime en revenant sur toute la largeur, ce qui se traduit visuellement par un large lance-pierre vers la droite.",
  "WITCHER.App.CarouselInitiativeConfig.Text.SnapWrapName": "Calage au bouclage de round",
  "WITCHER.App.CarouselInitiativeConfig.Text.SpotterVisibilityDesc": "Quand activé, les joueurs qui possèdent un repéreur ayant détecté un combattant furtif continueront de voir ce combattant dans le carrousel et le suivi latéral. Quand désactivé, les combattants furtifs sont toujours masqués aux non-propriétaires, quel que soit le statut du repéreur.",
  "WITCHER.App.CarouselInitiativeConfig.Text.SpotterVisibilityName": "Respecter la visibilité du repéreur",
  "WITCHER.App.CarouselInitiativeConfig.Text.TransitionMs": "Durée du glissement",
  "WITCHER.App.CarouselInitiativeConfig.Title": "Configuration du carrousel d'initiative",
