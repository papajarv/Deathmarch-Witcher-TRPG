  "WITCHER.Weather.Analogue.3": "Mar",
  "WITCHER.Weather.Analogue.4": "Avr",
  "WITCHER.Weather.Analogue.5": "Mai",
  "WITCHER.Weather.Analogue.6": "Juin",
  "WITCHER.Weather.Analogue.7": "Juil",
  "WITCHER.Weather.Analogue.8": "Août",
  "WITCHER.Weather.Analogue.9": "Sept",
  "WITCHER.Weather.Aurora": "Aurore",
  "WITCHER.Weather.Blizzard": "Blizzard",
  "WITCHER.Weather.CalNext": "Mois suivant",
  "WITCHER.Weather.CalPrev": "Mois précédent",
  "WITCHER.Weather.CalUnavailable": "Le calendrier n'est pas disponible.",
  "WITCHER.Weather.CalYearHint": "Saisissez une année et appuyez sur Entrée pour y accéder",
  "WITCHER.Weather.Clear": "Dégagé",
  "WITCHER.Weather.Climate.arid": "Aride",
  "WITCHER.Weather.Climate.coastal": "Côtier",
  "WITCHER.Weather.Climate.highland": "Hautes terres",
  "WITCHER.Weather.Climate.temperate": "Tempéré",
  "WITCHER.Weather.ClockGroup": "Horloge",
  "WITCHER.Weather.Compound.Blustery": "Bourrasques de",
  "WITCHER.Weather.Compound.Driving": "Violent(e)",
  "WITCHER.Weather.Compound.Foggy": "Brumeux",
  "WITCHER.Weather.Compound.Misty": "Brumeux",
  "WITCHER.Weather.Compound.Murky": "Sombre",
  "WITCHER.Weather.Compound.Pattern": "{base} {mods}",
  "WITCHER.Weather.Compound.Thunderous": "Orageux",
  "WITCHER.Weather.Compound.Windy": "Venteux",
  "WITCHER.Weather.Condition.Chilly": "Frais",
  "WITCHER.Weather.Condition.ChillyDesc": "S'applique en cas d'exposition au froid sans vêtements appropriés. Tant qu'il est actif : −1 DEX.",
  "WITCHER.Weather.Condition.Cold": "Froid",
  "WITCHER.Weather.Condition.ColdDesc": "S'applique en cas d'exposition au froid sans vêtements appropriés. Tant qu'il est actif : −1 DEX et −1 REF. Si vous êtes légèrement vêtu ou nu, vous pouvez tenir environ {hours} heures avant que le froid ne devienne mortel.",
  "WITCHER.Weather.Condition.Freezing": "Glacial",
  "WITCHER.Weather.Condition.FreezingDesc": "S'applique en cas d'exposition à un froid glacial sans vêtements appropriés. Tant qu'il est actif : −2 DEX et −1 REF. Si vous êtes légèrement vêtu ou nu, vous pouvez tenir environ {hours} heures avant que le froid ne devienne mortel.",
  "WITCHER.Weather.Condition.GrabHead": "États",
  "WITCHER.Weather.Condition.GrabHint": "Attribuez un état lorsque vous êtes exposé aux intempéries sans abri ni vêtements appropriés. S'applique aux pions sélectionnés ou à votre propre personnage ; cliquez à nouveau pour le retirer.",
  "WITCHER.Weather.Condition.HeatExhaustion": "Coup de chaleur",
  "WITCHER.Weather.Condition.HeatExhaustionDesc": "S'applique lors des déplacements ou des combats sous une chaleur extrême (désert ou canicule). Tant qu'il est actif, votre endurance maximale est réduite d'un tiers — ou de moitié si vous portez une armure moyenne ou lourde.",
  "WITCHER.Weather.Condition.NoTarget": "Aucun personnage auquel appliquer l'état — sélectionnez un pion ou attribuez d'abord un personnage.",
  "WITCHER.Weather.Conditions": "États",
  "WITCHER.Weather.Config.AddBiome": "Ajouter un biome",
  "WITCHER.Weather.Config.AddRow": "Ajouter une pénalité",
  "WITCHER.Weather.Config.AddTerrain": "Ajouter un type de terrain",
  "WITCHER.Weather.Config.Aurora": "Aurores",
  "WITCHER.Weather.Config.AuroraHint": "Autoriser les aurores lors des nuits claires et froides de cette saison.",
  "WITCHER.Weather.Config.Biomes": "Biomes",
  "WITCHER.Weather.Config.CalendarIntro": "Les heures de clarté gèrent l'obscurité automatique des scènes et les boutons de saut à l'aube/au crépuscule. Le cycle lunaire définit le nombre de jours nécessaires pour que la lune revienne à la même phase.",
  "WITCHER.Weather.Config.ClimateIntro": "Les biomes définissent le climat d'une région tout au long de l'année ; les saisons le font évoluer au fil des mois. Les curseurs d'influence permettent d'ajuster si un biome ou une saison a tendance à être plus humide, venteux ou nuageux (une valeur négative = plus sec/calme/dégagé).",
  "WITCHER.Weather.Config.Customized": "Personnalisé",
  "WITCHER.Weather.Config.Dawn": "Aube (heure)",
  "WITCHER.Weather.Config.Daylight": "Clarté par saison",
