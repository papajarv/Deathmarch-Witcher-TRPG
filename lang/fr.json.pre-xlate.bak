  "WITCHER.Mech.CastDamage.Dialog.MarginBody": "<div style=\"padding:8px 0; font-size:0.8125rem;\"><label style=\"display:flex; gap:10px; align-items:center;\"><span style=\"min-width:80px;\">{label}</span><input type=\"number\" name=\"m\" min=\"0\" step=\"1\" value=\"1\" autofocus /></label><p class=\"hint\" style=\"opacity:0.7; margin-top:6px;\">{hint}</p></div>",
