  "WITCHER.Attack.ModeThrown": "Llançat",
  "WITCHER.Attack.NeedsAction": "sense accions restants",
  "WITCHER.Attack.NeedsFullRound": "cal ronda completa",
  "WITCHER.Attack.NoAmmo": "Sense munició per a {name}.",
  "WITCHER.Attack.NotLoaded": "{name} no està carregada — recarrega abans d'atacar.",
  "WITCHER.Attack.NotThrowable": "No llançable",
  "WITCHER.Attack.NoteCharge": "Càrrega: ronda completa — mou-te fins a la velocitat de Córrer i, després, un cop fort a -3. Si el bloquegen, tira Físic contra el Físic de l'objectiu per fer-lo caure.",
  "WITCHER.Attack.NoteDisarm": "Desarmar: sense dany. En cas d'impacte, l'arma de l'objectiu és llançada 1d6 m en una direcció aleatòria (Dispersió).",
  "WITCHER.Attack.NoteFast": "Cop ràpid: dos atacs en aquesta acció sense penalització, però cadascun tira dany per separat.",
  "WITCHER.Attack.NoteFeint": "Fintar: tira Engany en lloc del teu primer Cop ràpid. Si l'objectiu falla un test de Percepció contra el teu Engany, el teu proper atac és a +3.",
  "WITCHER.Attack.NoteJoint": "Atac conjunt: dos atacs, tots dos a -3 (mà principal + arma de mà secundària). L'objectiu ha d'esquivar/reposicionar o tenir dues armes (o arma + escut) per bloquejar/parar tots dos.",
  "WITCHER.Attack.NoteNormal": "Cop normal: un atac sense penalització — el teu cop estàndard.",
  "WITCHER.Attack.NotePommel": "Cop de pom: mig dany, aplicat com a no letal.",
  "WITCHER.Attack.NoteStrong": "Cop fort: -3 per impactar, però duplica el dany tirat (aplicat abans de l'armadura de l'objectiu).",
  "WITCHER.Attack.NoteThrow": "Llançament: hi llances l'arma. L'arma surt de la teva mà i acaba a l'objectiu (recull-la després). Les armes amb qualitat de Llançament guanyen la bonificació indicada.",
  "WITCHER.Attack.NoteTrip": "Traveta: atac amb arma dirigit a la cama de l'objectiu — sense dany. En cas d'impacte, l'objectiu cau a terra.",
  "WITCHER.Attack.OffHand": "Mà secundària",
  "WITCHER.Attack.OffHandWeapon": "Arma de mà secundària",
