  "WITCHER.Effect.ConditionHint": "Expressió, p. ex. @system.stats.toxicity.value > @system.stats.toxicity.max * 125%. Fes servir @path, + - * /, > < >= <= == !=, and / or, i percentatges (25%).",
  "WITCHER.Effect.ConditionLabel": "Estat",
