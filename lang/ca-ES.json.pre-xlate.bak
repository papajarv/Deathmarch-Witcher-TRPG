  "WITCHER.Clinch.Adjacent.Title": "Baralla — prova d'adjacència",
  "WITCHER.Clinch.NotAdjacent": "{holder} no és a l'abast de {target} — fes un pas adjacent (a menys d'1 casella) abans de baralla.",
  "WITCHER.Combat.DamageBreakdown.Line.ActiveShield": "{shield} ha absorbit <b>{drained}</b> (<i>{before} → {after}</i>); en resten {remaining}.",
  "WITCHER.Combat.DamageBreakdown.Line.BlockedBySp": "Impacte totalment bloquejat pel SP d'armadura.",
  "WITCHER.Combat.DamageBreakdown.Line.CritActiveShield": "{shield} ha absorbit <b>{drained}</b> del bonus crític (<i>{before} → {after}</i>); {remaining} restants.",
  "WITCHER.Combat.DamageBreakdown.Line.CritBonus": "Bonus de crític <b>+{added}</b> afegit després de l'armadura (arma {weapon} + crític {added} = {total}).",
  "WITCHER.Combat.DamageBreakdown.Line.CritMonsterImmune": "Bonus de crític anul·lat &mdash; l'objectiu és immune a aquest tipus de dany (<i>{before} &rarr; 0</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.CritMonsterMeteoriteResist": "Bonus de crític reduït a la meitat &mdash; l'objectiu resisteix al dany no meteorític (<i>{before} &rarr; {after}</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.CritMonsterResist": "Bonus de crític reduït a la meitat &mdash; l'objectiu resisteix al dany no argentat (<i>{before} &rarr; {after}</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.CritMonsterTypeResist": "Bonus de crític reduït a la meitat &mdash; l'objectiu resisteix aquest tipus de dany (<i>{before} &rarr; {after}</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.CritShield": "{shield} ha absorbit <b>{drained}</b> del bonus crític (<i>{before} → {after}</i>); {remaining} restants.",
  "WITCHER.Combat.DamageBreakdown.Line.CritSilverPoorEdge": "Bonificació crítica reduïda a la meitat — el mal tall de l'argent contra objectius no febles a l'argent (<i>{before} &rarr; {after}</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.CritVulnerability": "Bonus de crític duplicat &mdash; l'objectiu és vulnerable a aquest tipus de dany (<i>{before} &rarr; {after}</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.DR": "L'armadura resisteix aquest tipus de dany &mdash; dany rebut reduït a la meitat (<i>{before} &rarr; {after}</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.Location": "Localització ×<b>{mult}</b>{label} (<i>{before} → {after}</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.LocationParen": " ({l})",
  "WITCHER.Combat.DamageBreakdown.Line.MonsterImmune": "L'objectiu és <b>immune</b> a aquest tipus de dany &mdash; dany rebut reduït a 0 (<i>{before} &rarr; 0</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.MonsterMeteoriteResist": "Resistència a dany no meteorític &mdash; dany rebut reduït a la meitat (<i>{before} &rarr; {after}</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.MonsterResistPlain": "Resistència a dany no argentat &mdash; dany rebut reduït a la meitat (<i>{before} &rarr; {after}</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.MonsterResistSilver": "Resistència a dany no argentat &mdash; dany base reduït a la meitat (<i>{before} &rarr; {halved}</i>), porció argentada <b>+{added}</b> afegida &rArr; {after}.",
  "WITCHER.Combat.DamageBreakdown.Line.MonsterTypeResist": "L'objectiu resisteix aquest tipus de dany &mdash; dany rebut reduït a la meitat (<i>{before} &rarr; {after}</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.OilBonus": "Bonus d'oli{oilText} <b>+{added}</b>{targetText} (arma {baseWeapon} + oli {added} = {combined}).",
  "WITCHER.Combat.DamageBreakdown.Line.OilName": " ({name})",
  "WITCHER.Combat.DamageBreakdown.Line.OilVsTarget": " contra {label}",
  "WITCHER.Combat.DamageBreakdown.Line.Shield": "{shield} ha absorbit <b>{drained}</b> (<i>{before} → {after}</i>); en resten {remaining}.",
  "WITCHER.Combat.DamageBreakdown.Line.SilverPoorEdge": "Mala fulla de l'argent — l'objectiu no és feble a l'argent, mal entrant a la meitat (<i>{before} &rarr; {after}</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.SpAblateBreakdown": " &mdash; base &minus;{base}{crushing} + Ablació &minus;{ablating} (tirat)",
  "WITCHER.Combat.DamageBreakdown.Line.SpAblated": "SP de l'armadura <b>{sp}</b> restat (<i>{before} → {after}</i>), armadura desgastada en &minus;{total} SP{breakdown}.",
  "WITCHER.Combat.DamageBreakdown.Line.SpDoubledCrushing": " &mdash; duplicat per Força d'aixafament",
  "WITCHER.Combat.DamageBreakdown.Line.SpSoaked": "SP de l'armadura <b>{sp}</b> absorbeix del tot <i>{before}</i> &mdash; sense penetració.",
  "WITCHER.Combat.DamageBreakdown.Line.SpSubtracted": "SP de l'armadura <b>{sp}</b> restat (<i>{before} → {after}</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.Vulnerability": "L'objectiu és <b>vulnerable</b> a aquest tipus de dany &mdash; dany rebut duplicat (<i>{before} &rarr; {after}</i>).",
  "WITCHER.Combat.DamageBreakdown.Text.ActiveShieldCollapsed": "Escut actiu ensorrat",
  "WITCHER.Combat.DamageBreakdown.Text.NoPipelineStagesFired": "Cap fase del pipeline s'ha activat.",
  "WITCHER.CombatExtended.Action.Bash": "Cop",
  "WITCHER.CombatExtended.Action.BashDesc": "Cop d'Escut: tirada de Baralla per impactar; el defensor tria Esquiva o Reposició. En cas d'impacte, tirada oposada de Físic contra Físic — ambdós bàndols sumen el Valor de Cobertura de l'escut equipat. Si guanya l'atacant → l'empeny COS/2 metres enrere (limitat per parets). +7 de diferència → també queda Trontollant.",
  "WITCHER.CombatExtended.Action.Block": "Bloqueig",
  "WITCHER.CombatExtended.Action.BlockDesc": "La teva habilitat cos a cos (o Baralla amb els braços nus) contra l'atac. La teva arma o escut perd 1 Fiabilitat per cada impacte absorbit. Els bloquejos amb braç pateixen dany contundent al braç.",
  "WITCHER.CombatExtended.Action.Charge": "Càrrega",
  "WITCHER.CombatExtended.Action.ChargeDesc": "Acurta la distància i fa un atac Fort. En cas d'impacte, tirada oposada de Físic contra l'objectiu per fer-lo caure a terra.",
  "WITCHER.CombatExtended.Action.Chokehold": "Estrangulament",
  "WITCHER.CombatExtended.Action.ChokeholdDesc": "Requereix un agafament actiu. L'objectiu pateix dany per asfíxia = 3 + el teu modificador de dany cos a cos, repetit cada torn que es mantingui la subjecció. Es pot combinar amb Immobilització.",
  "WITCHER.CombatExtended.Action.Clinch": "Agafada",
  "WITCHER.CombatExtended.Action.ClinchDesc": "Gasta el moviment per apropar-te fins a l'agafada amb un enemic — no és una aferrada, però permet que les armes de curt abast arribin. L'oponent no queda subjectat i es pot allunyar.",
  "WITCHER.CombatExtended.Action.Disarm": "Desarmar",
  "WITCHER.CombatExtended.Action.DisarmDesc": "Causa dany de cop de puny al braç de l'objectiu i li llança l'arma lluny. Pots fer una tirada opcional de Baralla DC18 per atrapar-la; si no, cau 1d6m en una direcció aleatòria. La víctima per tornar-la a agafar: Percepció DC16 aquesta ronda, gratuït la ronda següent.",
  "WITCHER.CombatExtended.Action.Dodge": "Esquivar",
  "WITCHER.CombatExtended.Action.DodgeDesc": "Esquiva/Escapar contra l'atac. La reserva d'esquiva per ronda és igual a la teva VEL total, separada del moviment normal.",
  "WITCHER.CombatExtended.Action.Escape": "Escapar",
  "WITCHER.CombatExtended.Action.EscapeDesc": "Si estàs agafat, immobilitzat o estrangulat, gasta la teva Acció per tirar Esquiva/Escapar contra la Baralla del que et subjecta. Una Fugida per subjecció.",
  "WITCHER.CombatExtended.Action.Fast": "Atac ràpid",
  "WITCHER.CombatExtended.Action.FastDesc": "Fes dos cops seguits contra el mateix objectiu. Arcs sí; ballestes no.",
  "WITCHER.CombatExtended.Action.Feint": "Finta",
  "WITCHER.CombatExtended.Action.FeintDesc": "Fintar: tira la teva habilitat d'arma contra la Percepció de l'objectiu. En cas d'èxit, el teu proper atac contra aquest objectiu és a +3 per impactar.",
  "WITCHER.CombatExtended.Action.Grapple": "Aferrar",
  "WITCHER.CombatExtended.Action.GrappleDesc": "Tira Baralla contra la Baralla de l'objectiu. Mentre s'està aferrat, tots dos pateixen −2 a totes les proves físiques (excepte l'un contra l'altre). Les armes són utilitzables, l'habilitat es manté Baralla.",
  "WITCHER.CombatExtended.Action.Impale": "Empalar",
  "WITCHER.CombatExtended.Action.ImpaleDesc": "Només armes perforants. Rebs −3 per fer un únic atac; en cas d'impacte, guanyes Perforació d'Armadura X. Les armes que ja tenen PA passen a Perforació d'Armadura Millorada.",
  "WITCHER.CombatExtended.Action.Joint": "Atac conjunt",
  "WITCHER.CombatExtended.Action.JointDesc": "Ataca amb les dues armes empunyades a −3. El defensor només pot parar / bloquejar el primer atac tret que també empunyi doble; el segon només es pot evitar amb Esquivar o Reposicionar.",
  "WITCHER.CombatExtended.Action.Lunge": "Envestida",
  "WITCHER.CombatExtended.Action.LungeDesc": "Acurta la distància i fa un atac d'Empalar.",
  "WITCHER.CombatExtended.Action.Parry": "Parada",
  "WITCHER.CombatExtended.Action.ParryDesc": "A −3, la teva arma/cos a cos/baralla contra l'atac. En cas d'èxit, l'atacant queda Trontollant.",
  "WITCHER.CombatExtended.Action.Pin": "Fixar",
  "WITCHER.CombatExtended.Action.PinDesc": "Requereix un agafament actiu. Immobilitza contra una paret o el fa caure a terra. Causa dany de puntada al tors; tots dos combatents queden immobilitzats. L'objectiu pateix un −3 addicional als tests físics (s'acumula amb el −2 de l'agafament).",
  "WITCHER.CombatExtended.Action.Pommel": "Cop de mànec",
  "WITCHER.CombatExtended.Action.PommelDesc": "Atac únic amb el pom de l'arma — mig dany, no letal.",
  "WITCHER.CombatExtended.Action.Push": "Empènyer",
  "WITCHER.CombatExtended.Action.PushDesc": "Causa dany de cop de puny al tors de l'objectiu i l'empeny enrere 1/5 del teu valor base de Físic en metres. Escuts, armes de mànec llarg i contundents també poden empènyer usant Cos a Cos o Bastó/Llança, causant dany de cop d'escut o de pom en lloc de cop de puny.",
  "WITCHER.CombatExtended.Action.Relocate": "Reubicar",
  "WITCHER.CombatExtended.Action.RelocateDesc": "Atletisme contra l'atac; en cas d'èxit, mou-te fins a ½ VEL. VEL mínima 1 per usar. Comparteix la reserva de moviment per ronda amb l'Esquiva.",
  "WITCHER.CombatExtended.Action.ReverseGrapple": "Invertir agafada",
  "WITCHER.CombatExtended.Action.ReverseGrappleDesc": "Intenta invertir un agafament existent. En cas d'èxit, els papers es canvien i l'atacant passa a ser l'agafat.",
  "WITCHER.CombatExtended.Action.Ride": "Cavalcar",
  "WITCHER.CombatExtended.Action.RideDesc": "Requereix una aferrada o terreny elevat. Munta un enemic més gran; queden en el seu punt cec. Han de superar la teva prova de Cavalcar amb Baralla per atacar-te; un impacte et fa caure amb un cop de cua o extremitat davantera.",
  "WITCHER.CombatExtended.Action.Single": "Atac únic",
  "WITCHER.CombatExtended.Action.SingleDesc": "Realitza un únic atac sense penalització.",
  "WITCHER.CombatExtended.Action.Strong": "Atac fort",
  "WITCHER.CombatExtended.Action.StrongDesc": "Rebs −3 per fer un únic atac; en cas d'impacte, duplica els daus de dany de l'arma. Els arcs també poden fer servir aquest cop.",
  "WITCHER.CombatExtended.Action.Trip": "Fer la traveta",
  "WITCHER.CombatExtended.Action.TripDesc": "Causa dany de cop de puny a una localització aleatòria i fa caure l'objectiu a terra. Si l'estàs agafant, fa el doble de dany, el fa rodolar 1d6m i força una Salvació d'Atordiment.",
  "WITCHER.CombatExtended.ActionsEditor.Hint": "Aquestes descripcions són visibles per als jugadors al panell d'accions especials. Manteniu-les curtes i mecàniques.",
  "WITCHER.CombatExtended.ActionsEditor.Name": "Configurar el combat estès",
