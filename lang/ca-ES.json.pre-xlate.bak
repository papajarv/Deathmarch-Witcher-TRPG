  "WITCHER.App.SpecialActionSlotPicker.Dialog.Body": "<div style=\"padding:6px 2px;display:flex;flex-direction:column;gap:6px;\"><div>{intro} <strong>{label}</strong>?</div>{hints}</div>",
  "WITCHER.App.SpecialActionSlotPicker.Dialog.Button.UseAction": "Usar acció",
  "WITCHER.App.SpecialActionSlotPicker.Dialog.Button.UseExtraActionXSTA": "Fer servir acció extra ({extraStaCost} STA)",
  "WITCHER.App.SpecialActionSlotPicker.Dialog.Button.UseMovement": "Usar moviment",
  "WITCHER.App.SpecialActionSlotPicker.Dialog.Hint.UseAction": "Gasta la teva única acció aquest torn. No costarà Aguant.",
  "WITCHER.App.SpecialActionSlotPicker.Dialog.Hint.UseMovement": "Gasta l'acció de moviment del teu torn (no es fa cap moviment real). No costarà Aguant.",
  "WITCHER.App.SpecialActionSlotPicker.Dialog.Title": "{label} — tria una ranura",
  "WITCHER.App.SpecialActionSlotPicker.Text.SpecialAction": "Acció especial",
  "WITCHER.App.SpecialActionSlotPicker.Text.WhichResourceDoYouWantToSpendFor": "Quin recurs vols gastar per a",
  "WITCHER.App.StatusEffectsEditor.Aria.RimColorPicker": "Selector de color de vora",
  "WITCHER.App.StatusEffectsEditor.Blurb": "Personalitza els estats de combat. Cada targeta edita un estat: el seu nom, icona, descripció i la clàusula RAW sencera — modificadors d'atribut i tirada, dany continu, bloquejos d'acció/defensa, la DC d'impacte automàtic, la prova de final, l'autoneteja i les salvacions periòdiques. Els estats sense tocar mantenen els valors per defecte. En desar es recarrega el món per aplicar-ho.",
  "WITCHER.App.StatusEffectsEditor.Button.AddStatus": "Afegir estat",
  "WITCHER.App.StatusEffectsEditor.Button.RestoreRAWDefaults": "Restaurar valors RAW per defecte",
