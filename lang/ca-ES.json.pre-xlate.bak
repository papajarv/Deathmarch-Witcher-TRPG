  "WITCHER.App.StatusEffectsEditor.Dialog.Button.None": "Cap",
  "WITCHER.App.StatusEffectsEditor.Dialog.Button.SkillCheckDC": "Prova d'habilitat (DC)",
  "WITCHER.App.StatusEffectsEditor.Dialog.Button.StunSave": "Salvació d'atordiment",
  "WITCHER.App.StatusEffectsEditor.Dialog.Button.VerbalCombat": "Combat verbal",
