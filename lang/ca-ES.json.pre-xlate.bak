  "WITCHER.Effect.CustomStatus.Description": "Descripció",
  "WITCHER.Effect.CustomStatus.Dot": "Dany continu",
  "WITCHER.Effect.CustomStatus.DotAblateArmor": "Desgastar SP d'armadura / torn",
  "WITCHER.Effect.CustomStatus.DotAblateArmorHint": "Erosiona aquesta quantitat de poder d'aturada de l'armadura en cada tic de DoT (estats Àcid / corrosius). 0 = sense ablació.",
  "WITCHER.Effect.CustomStatus.DotAblateWeapon": "Erosionar arma / torn",
