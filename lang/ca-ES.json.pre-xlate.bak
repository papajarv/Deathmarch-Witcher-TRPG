  "WITCHER.WR.LightningFast.NotOwner": "{name} no té l'acció heroica Ràpid com un Llamp.",
  "WITCHER.WR.LightningFast.OutOfCombat": "Fulminant només funciona durant el combat.",
  "WITCHER.WR.Perserver.Banner": "{name} guanya {gained} d'adrenalina ({severity}).",
  "WITCHER.WR.Perserver.BannerCapped": "{name} guanya {gained} d'adrenalina ({severity}) — n'hauria estat {grant}, limitat per COS {cap}.",
  "WITCHER.WR.Perserver.NoGain": "{name} ja estava a COS {cap} o per sobre — cap adrenalina guanyada ({severity}, n'hauria estat {grant}).",
  "WITCHER.Weapon.Bomb.Shape.Circle": "Cercle",
  "WITCHER.Weapon.Bomb.Shape.Cone": "Con",
  "WITCHER.Weapon.Bomb.Shape.Line": "Línia",
  "WITCHER.Weapon.Bomb.Shape.Rect": "Rectangle",
  "WITCHER.Weapon.Draw": "Desembeinar arma (ràpid)",
  "WITCHER.Weapon.HandLeft": "Esquerra",
  "WITCHER.Weapon.HandRight": "Dreta",
  "WITCHER.Weapon.HandTwoHanded": "A dues mans",
  "WITCHER.Weapon.Hands.one": "A una mà",
  "WITCHER.Weapon.Hands.two": "A dues mans",
  "WITCHER.Weapon.Slot.left": "Mà secundària",
  "WITCHER.Weapon.Slot.quick": "Ràpid / Mà secundària",
  "WITCHER.Weapon.Slot.right": "Mà principal",
  "WITCHER.Weapon.TypeBomb": "Bomba",
  "WITCHER.Weapon.TypeMelee": "Cos a cos",
  "WITCHER.Weapon.TypeRanged": "A distància",
  "WITCHER.Weapon.TypeThrown": "Llançat",
  "WITCHER.WeaponQuality.Ablating.Description": "En un impacte penetrant, fa un dany addicional d'1d6/2 SP a l'armadura de l'objectiu (tirat per impacte, 0–3 SP extres treta al valor de la localització, a més del desgast estàndard de −1 SP que causa cada impacte penetrant).",
  "WITCHER.WeaponQuality.Ablating.Label": "Desgastant",
  "WITCHER.WeaponQuality.ArcheryShield.Description": "Cordat a l'avantbraç, et permet empunyar un arc o una ballesta sense penalització. Les tirades de Bloqueig / Parada amb l'escut reben −1, i qualsevol arma de cos a cos usada amb el braç de l'escut rep −1 als atacs, Bloquejos i Parades. (Resolt pel GM — no hi ha −1 automàtic per aquesta qualitat en el Bloqueig/Parada de l'escut; l'excepció de +a distància amb escut requereix un flux específic de CE encara no cablejat.)",
  "WITCHER.WeaponQuality.ArcheryShield.Label": "Escut d'arqueria",
  "WITCHER.WeaponQuality.ArmorPiercing.Description": "Ignora la resistència al dany de l'armadura de l'objectiu.",
  "WITCHER.WeaponQuality.ArmorPiercing.Label": "Perforació d'armadura",
  "WITCHER.WeaponQuality.Balanced.Description": "Millors crítics: tira 2d6+2 (o 1d6+1 si apuntes) per a la severitat.",
  "WITCHER.WeaponQuality.Balanced.Label": "Equilibrat",
  "WITCHER.WeaponQuality.BladeCatcher.Description": "Quan bloqueges un atac cos a cos amb ella, les dues armes queden bloquejades juntes i inutilitzables fins que l'atacant supera la teva prova de Fulles Curtes amb una prova de Constitució o Prestidigitació, o fins que la deixes anar.",
  "WITCHER.WeaponQuality.BladeCatcher.Label": "Atrapa-fulles",
  "WITCHER.WeaponQuality.Bleeding.Description": "En causar dany, hi ha possibilitat d'infligir Sagnat (vegeu Efectes d'Estat).",
  "WITCHER.WeaponQuality.Bleeding.Label": "Sagnant",
  "WITCHER.WeaponQuality.Brawling.Description": "El dany de l'arma s'afegeix al teu dany normal de cop de puny o puntada, i canvia el teu dany de cop de puny o puntada al tipus indicat.",
  "WITCHER.WeaponQuality.Brawling.Label": "Baralla",
  "WITCHER.WeaponQuality.Cavalry.Description": "Quan s'usa per atacar mentre es cavalca, l'arma afegeix un dau de dany per cada 1 m de moviment en lloc de 2 m. (Rebateig d'Equipment Overhaul per a la qualitat antiga del Bàsic 'Charging'.)",
  "WITCHER.WeaponQuality.Cavalry.Label": "Cavalleria",
  "WITCHER.WeaponQuality.Charging.Description": "Quan s'usa per carregar, aquesta arma fa un dau addicional de dany per cada 2 m recorreguts, fins al màxim indicat. Això s'afegeix al dany extra guanyat pel moviment durant el combat muntat. (El 'Charging' redefinit d'EO — diferent de l'entrada antiga del Bàsic que es manté a la clau `charging`.)",
  "WITCHER.WeaponQuality.Charging.Label": "Carregant",
  "WITCHER.WeaponQuality.CharginglegacyCore.Description": "\"Càrrega\" del Core llegat — s'utilitza des d'una muntura en moviment: afegeix 1d6 de dany extra per metre carregat, en lloc de la meitat habitual. Equipment Overhaul canvia el nom a \"Cavalleria\" (vegeu més avall); fes servir aquesta clau per a objectes nous.",
  "WITCHER.WeaponQuality.CharginglegacyCore.Label": "Carregar (Bàsic antic)",
  "WITCHER.WeaponQuality.CloseQuarters.Description": "Obté els beneficis indicats quan s'utilitza per atacar un enemic que està involucrat en un agafament, immobilització, estrangulament o estrenyiment amb l'atacant.",
  "WITCHER.WeaponQuality.CloseQuarters.Label": "Distància curta",
  "WITCHER.WeaponQuality.Concealment.Description": "+2 als tests fets per amagar aquesta arma al cos. (Resolt pel DJ — sense interfície automàtica de test d'Amagar.)",
  "WITCHER.WeaponQuality.Concealment.Label": "Ocultació",
  "WITCHER.WeaponQuality.Crafting.Description": "Compta com a eina per a les construccions o activitats llistades, reduint penalitzacions si no tens Eines de Fabricació.",
  "WITCHER.WeaponQuality.Crafting.Label": "Fabricació",
  "WITCHER.WeaponQuality.CrewReload.Description": "Recarregar requereix 2 accions, que dues persones poden dividir entre elles. (Resolt pel DJ — sense flux de recàrrega multi-actor.)",
  "WITCHER.WeaponQuality.CrewReload.Label": "Recàrrega de tripulació",
  "WITCHER.WeaponQuality.CriticalBlock.Description": "Quan superes l'atacant en més de 4 en un Bloqueig o Parada amb el teu escut Manticora, fas immediatament un Cop d'Escut que el fa retrocedir 4 m i el fa caure a terra, sense penalització extra ni Aguant.",
  "WITCHER.WeaponQuality.CriticalBlock.Label": "Bloqueig crític",
  "WITCHER.WeaponQuality.CriticalDecimation.Description": "Quan causes una ferida crítica amb una arma de witcher, tracta-la com un nivell més severa (un crític Simple es converteix en Complex, etc.).",
  "WITCHER.WeaponQuality.CriticalDecimation.Label": "Delmació crítica",
  "WITCHER.WeaponQuality.CriticalFlurry.Description": "Quan causes una ferida crítica amb una arma de witcher, intenta immediatament un Desarmament o Traveta sense penalització ni Aguant addicionals.",
  "WITCHER.WeaponQuality.CriticalFlurry.Label": "Ràfega crítica",
  "WITCHER.WeaponQuality.CriticalMomentum.Description": "Quan causes una ferida crítica amb una arma de witcher, fes immediatament un únic Cop amb una arma empunyada sense penalització ni Aguant addicionals.",
  "WITCHER.WeaponQuality.CriticalMomentum.Label": "Impuls crític",
  "WITCHER.WeaponQuality.CriticalRiposte.Description": "Quan superes un atacant per més de 4 en una Parada amb una arma de witcher, fes immediatament un Cop amb una arma empunyada sense penalització ni Aguant addicionals.",
  "WITCHER.WeaponQuality.CriticalRiposte.Label": "Rèplica crítica",
  "WITCHER.WeaponQuality.CriticalSpellcasting.Description": "Quan aconsegueixes una ferida crítica amb una arma witcher, fas immediatament una prova de Llançament per llançar un Signe sense penalització extra ni gastar Aguant més enllà del cost propi del Signe.",
  "WITCHER.WeaponQuality.CriticalSpellcasting.Label": "Llançament crític",
  "WITCHER.WeaponQuality.CrushingForce.Description": "No es pot parar; duplica el desgast estàndard de −1 SP a −2 en cada impacte penetrant (en armes, escuts i armadures).",
  "WITCHER.WeaponQuality.CrushingForce.Label": "Força d'aixafament",
  "WITCHER.WeaponQuality.Deployable.Description": "Pots gastar una Acció per aixecar aquest escut com a fortificació portàtil. (Resolt pel DJ — sense estat de token de cobertura portàtil.)",
  "WITCHER.WeaponQuality.Deployable.Label": "Desplegable",
  "WITCHER.WeaponQuality.Difficult.Description": "Aquesta peça d'armadura s'ha de portar amb un Gambesó i no es pot equipar sense ajuda.",
  "WITCHER.WeaponQuality.Difficult.Label": "Difícil",
  "WITCHER.WeaponQuality.Disease.Description": "En un impacte amb dany, hi ha possibilitat d'infligir la condició Malaltia (vegeu Efectes d'Estat).",
  "WITCHER.WeaponQuality.Disease.Label": "Malaltia",
  "WITCHER.WeaponQuality.Entangling.Description": "En un impacte, l'objectiu queda enredat: -5 SPD i -2 a totes les accions físiques; cada torn una prova de DC 18 d'Esquivar/Escapar o Contorsionisme l'allibera, o un aliat pot gastar una acció per treure-ho.",
  "WITCHER.WeaponQuality.Entangling.Label": "Enredant",
  "WITCHER.WeaponQuality.ExtremeReach.Description": "Pots atacar objectius de 2 a 6 metres més enllà del teu Abast cos a cos normal (2-4 caselles de quadrícula) amb aquesta arma. Reps −5 per Bloquejar o Parar oponents adjacents, i no els pots atacar, ni tan sols amb cops de pom.",
  "WITCHER.WeaponQuality.ExtremeReach.Label": "Abast extrem",
  "WITCHER.WeaponQuality.Feeble.Description": "Aquesta arma només pot Parar altres armes Frèvoles, i si s'utilitza per Bloquejar una arma no Frèvola, el defensor pateix igualment la meitat del dany si té èxit. Si s'utilitza per Bloquejar una arma Pesant, el defensor rep la meitat del dany com a letal i la meitat com a no letal.",
  "WITCHER.WeaponQuality.Feeble.Label": "Feble",
  "WITCHER.WeaponQuality.Fire.Description": "En un impacte amb dany, hi ha possibilitat d'encendre l'objectiu (vegeu l'estat Encès).",
  "WITCHER.WeaponQuality.Fire.Label": "Foc",
  "WITCHER.WeaponQuality.Fireproof.Description": "Redueix el dany de foc a la meitat i concedeix immunitat a l'estat Encès.",
  "WITCHER.WeaponQuality.Fireproof.Label": "Ignífug",
  "WITCHER.WeaponQuality.Focus.Description": "Llançar sortilegis a través d'aquesta arma redueix el cost d'STA pel seu valor de Focus.",
  "WITCHER.WeaponQuality.Focus.Label": "Focus",
  "WITCHER.WeaponQuality.Foraging.Description": "Quan s'utilitza per collir el tipus de recurs indicat, guanyes +1 unitat d'aquest recurs.",
  "WITCHER.WeaponQuality.Foraging.Label": "Recol·lecció",
  "WITCHER.WeaponQuality.FreeAmmunition.Description": "Aquesta arma pot utilitzar pedres, pals o altres projectils improvisats de l'entorn com a munició sense cost.",
  "WITCHER.WeaponQuality.FreeAmmunition.Label": "Munició gratuïta",
  "WITCHER.WeaponQuality.Freeze.Description": "En un impacte amb dany, hi ha possibilitat de congelar l'objectiu (vegeu l'estat Congelat).",
  "WITCHER.WeaponQuality.Freeze.Label": "Congelar",
  "WITCHER.WeaponQuality.FullCoverdeprecated.Description": "Equipment Overhaul retira aquesta qualitat — mecànicament està subsumida per qualsevol escut amb un Valor de Cobertura de 6 o més. Es manté al catàleg per compatibilitat retroactiva amb objectes estil pavès; els escuts nous haurien de configurar VC ≥ 6.",
  "WITCHER.WeaponQuality.FullCoverdeprecated.Label": "Cobertura total (obsolet)",
  "WITCHER.WeaponQuality.Grappling.Description": "Es pot utilitzar per agafar i fer caure oponents a l'abast. (Fes servir l'acció d'Agafament del CE; el prerequisit és a actions.mjs, no en aquesta qualitat.)",
  "WITCHER.WeaponQuality.Grappling.Label": "Agafada",
  "WITCHER.WeaponQuality.GreaterFocus.Description": "Els sortilegis llançats a través d'aquesta arma tracten la DC com a +2.",
  "WITCHER.WeaponQuality.GreaterFocus.Label": "Focus major",
  "WITCHER.WeaponQuality.Grounded.Description": "No pots carregar ni disparar aquesta arma si cavalques un animal o condueixes un vehicle. Encara pots carregar i disparar com a passatger en un vaixell, carro o carreta, però has d'estar dret i pots patir penalitzacions.",
  "WITCHER.WeaponQuality.Grounded.Label": "A terra",
  "WITCHER.WeaponQuality.Guard.Description": "L'arma dóna un bonus de +1 a les tirades de defensa quan s'utilitza per Bloquejar o Parar.",
  "WITCHER.WeaponQuality.Guard.Label": "Guàrdia",
  "WITCHER.WeaponQuality.HalfDamage.Description": "Aquesta munició fa la meitat del dany base de l'arma (arrodonit avall). Habitualment aparellat amb un debuff o un afegit d'estat en lloc de dany.",
  "WITCHER.WeaponQuality.HalfDamage.Label": "Dany a la meitat",
  "WITCHER.WeaponQuality.Hefty.Description": "Massa pesada per a un Cop Ràpid — el Cop Ràpid no està disponible amb aquesta arma (fes servir Atac Únic). Els seus atacs no es poden Parar, i fa la meitat del dany com a no letal quan es Bloqueja amb èxit.",
  "WITCHER.WeaponQuality.Hefty.Label": "Feixuc",
  "WITCHER.WeaponQuality.Hidden.Description": "Ocult sota la roba: requereix una prova de Percepció al DC indicat per detectar-ho. (Resolt pel GM — no hi ha superfície automàtica de detecció per Percepció; el xip de DC és per a referència manual.)",
  "WITCHER.WeaponQuality.Hidden.Label": "Amagat",
  "WITCHER.WeaponQuality.ImprovedArmorPiercing.Description": "Ignora la resistència al dany de l'armadura, redueix el SP de l'armadura a la meitat en impactar, i sobrepassa les resistències i immunitats per tipus dels monstres. NO sobrepassa les portes de debilitat 'només vulnerable a plata' o 'només vulnerable a meteorit'.",
  "WITCHER.WeaponQuality.ImprovedArmorPiercing.Label": "Perforació d'armadura millorada",
  "WITCHER.WeaponQuality.ImprovedRange.Description": "Aquesta munició millora el rang de l'arma en un 50%.",
  "WITCHER.WeaponQuality.ImprovedRange.Label": "Abast millorat",
  "WITCHER.WeaponQuality.Indirect.Description": "La flexibilitat o corbatura de l'arma li permet arribar per darrere de la guàrdia de l'oponent. Els intents de Bloquejar o Parar els seus atacs es tiren sempre a −2. No obstant això, això la fa maldestra en defensa, així que també Bloqueja i Para a −2.",
  "WITCHER.WeaponQuality.Indirect.Label": "Indirecte",
  "WITCHER.WeaponQuality.Injector.Description": "Es pot carregar (una acció) amb una dosi de verí o elixir; un impacte amb dany clava la dosi profundament, fent que un verí sigui 3 més difícil de resistir o que un elixir duri 3 rondes més. (Resolt pel DJ — sense UI de carregar-amb-verí; la nota de complement es publica en l'impacte.)",
  "WITCHER.WeaponQuality.Injector.Label": "Injector",
  "WITCHER.WeaponQuality.KnockDown.Description": "En un impacte amb dany, hi ha possibilitat de fer caure l'objectiu.",
  "WITCHER.WeaponQuality.KnockDown.Label": "Fer caure",
  "WITCHER.WeaponQuality.LanceRest.Description": "Et permet fer servir tot el teu Torn per fer un atac de càrrega a una mà amb una llança mentre estàs muntat, sense la penalització habitual per atacar a una mà amb una arma a dues mans. (Resolt pel DJ — sense flux de primera classe per a muntura + llança.)",
  "WITCHER.WeaponQuality.LanceRest.Label": "Suport de llança",
  "WITCHER.WeaponQuality.LongReach.Description": "Pots atacar objectius 2 metres més enllà del teu Abast cos a cos normal (2 caselles de graella) amb aquesta arma. Reps −1 a Bloquejar, Parar o atacar oponents adjacents.",
  "WITCHER.WeaponQuality.LongReach.Label": "Abast llarg",
  "WITCHER.WeaponQuality.MagicallyAnchoring.Description": "Mentre una criatura toca l'arma no pot tornar-se invisible o intangible ni teleportar-se; qualsevol criatura ja invisible o intangible es fa visible i sòlida per força.",
  "WITCHER.WeaponQuality.MagicallyAnchoring.Label": "Ancoratge màgic",
  "WITCHER.WeaponQuality.Meteorite.Description": "Dany complet contra monstres vulnerables al meteorit. Segons Equipment Overhaul, si no fas servir les regles opcionals alternatives per a les susceptibilitats de monstres, aquesta qualitat concedeix a l'arma (o escut) una ranura d'encantament extra per a runes (fins a 3 en total). La regla de la casa antiga es mantenia com a Fiabilitat +5 per compatibilitat.",
  "WITCHER.WeaponQuality.Meteorite.Label": "Meteorit",
  "WITCHER.WeaponQuality.MeteoriteContact.Description": "Els monstres susceptibles al meteorit queden trontollant sempre que impacten aquesta peça d'armadura amb les seves armes naturals, o sempre que us impacteu mútuament amb, o mantingueu, maniobres de baralla. A més, si s'aplica a braços o cames, atorga als teus cops de puny o puntades l'efecte de Meteorit.",
  "WITCHER.WeaponQuality.MeteoriteContact.Label": "Contacte de meteorit",
  "WITCHER.WeaponQuality.MonsterResistance.Description": "Resistència integrada d'escola witcher a un perfil de dany de monstre concret (p. ex. Necròfags, Espectres). El paràmetre registra el conjunt de resistència; el consumidor del motor el llegeix durant la resolució del dany. (Resolt pel GM — no hi ha un registre de dany per conjunt de monstres; el text del paràmetre surt al xip.)",
  "WITCHER.WeaponQuality.MonsterResistance.Label": "Resistència del monstre",
  "WITCHER.WeaponQuality.Mounted.Description": "Fixada al lloc; s'ha de muntar abans de fer-la servir i desmuntar (una acció cadascun) abans de poder-la moure. (Resolt pel DJ — sense superfície d'acció de muntatge/desmuntatge; chargeBonusPerMeter en cavalleria/càrrega SÍ que està connectat al motor.)",
  "WITCHER.WeaponQuality.Mounted.Label": "Muntat",
  "WITCHER.WeaponQuality.Nimble.Description": "Quan fas servir una Acció Extra per desembeinar o atacar amb aquesta arma, el cost d'Aguant es redueix en 2.",
  "WITCHER.WeaponQuality.Nimble.Label": "Àgil",
  "WITCHER.WeaponQuality.NonLethaldeprecated.Description": "Equipment Overhaul retira aquesta qualitat — les armes elegibles reben ara N(o-letal) com a opció de tipus de dany. Es manté al catàleg per compatibilitat retroactiva amb objectes que encara la referencien; els objectes nous haurien de configurar el tipus de dany com a No-letal.",
  "WITCHER.WeaponQuality.NonLethaldeprecated.Label": "No letal (obsolet)",
  "WITCHER.WeaponQuality.Options.Description": "Pots obtenir una variació d'aquesta armadura que no cobreix els braços i que redueix les seves penalitzacions d'EV segons la quantitat entre parèntesis. Si normalment cobreix les cames, també la pots obtenir en una versió més curta que no ho fa, reduint-ne igualment l'EV en la mateixa quantitat. Fer servir qualsevol de les dues opcions redueix el pes i el preu en un 20%, i fer servir totes dues opcions redueix el pes i el preu en un 40%. (Resolt pel GM — el GM crea manualment l'objecte variant; no hi ha derivació automàtica.)",
  "WITCHER.WeaponQuality.Options.Label": "Opcions",
  "WITCHER.WeaponQuality.Parrying.Description": "Parar amb aquesta arma redueix la penalització de parada en 2.",
  "WITCHER.WeaponQuality.Parrying.Label": "Parant",
  "WITCHER.WeaponQuality.Physique.Description": "Si la teva base d'habilitat de Físic és inferior al número indicat, les teves tirades d'atac pateixen una penalització igual a la diferència.",
  "WITCHER.WeaponQuality.Physique.Label": "Constitució",
  "WITCHER.WeaponQuality.Poison.Description": "En un impacte amb dany, hi ha possibilitat d'enverinar l'objectiu (vegeu l'estat Enverinat).",
  "WITCHER.WeaponQuality.Poison.Label": "Verí",
  "WITCHER.WeaponQuality.PoorVision.Description": "Tens un camp de visió reduït i perds la capacitat de rastrejar per olor, i només recuperes LA MEITAT del teu aguant normal amb la recuperació en combat (Prendre alè). Amb Mala Visió, també tens un −2 a Percepció i als atacs a distància, i un −1 a totes les altres proves dependents de la vista. En molts elms pots obrir la visera o la màscara com a acció per anul·lar-ho, però això elimina qualsevol resistència a atacs perforants que tingui l'elm i redueix el SP en 5.",
  "WITCHER.WeaponQuality.PoorVision.Label": "Mala visió",
  "WITCHER.WeaponQuality.RangedPenalty.Description": "L'armadura pesada o restrictiva als braços imposa una penalització fixa a les tirades d'atac a distància. El paràmetre registra el valor de la penalització (-1, -2, …).",
  "WITCHER.WeaponQuality.RangedPenalty.Label": "Penalització a distància",
  "WITCHER.WeaponQuality.ReducedRange.Description": "Aquesta munició redueix el rang de l'arma a la meitat.",
  "WITCHER.WeaponQuality.ReducedRange.Label": "Abast reduït",
  "WITCHER.WeaponQuality.ResistancetoBleeding.Description": "Redueix la possibilitat que l'estat Sagnat s'estableixi en la quantitat indicada (-25% per defecte).",
  "WITCHER.WeaponQuality.ResistancetoBleeding.Label": "Resistència a sagnat",
  "WITCHER.WeaponQuality.RestrictedVision.Description": "Tens un camp de visió reduït i perds la capacitat de rastrejar per olor, i només recuperes LA MEITAT del teu aguant normal amb la recuperació en combat (Prendre alè). En molts elms pots obrir la visera o la màscara com a acció per anul·lar-ho, però això elimina qualsevol resistència a atacs perforants que tingui l'elm i redueix el SP en 5.",
  "WITCHER.WeaponQuality.RestrictedVision.Label": "Visió restringida",
  "WITCHER.WeaponQuality.SPDPenalty.Description": "L'armadura pesada o restrictiva a les cames imposa una penalització fixa a la teva estadística VEL. El paràmetre registra el valor de la penalització (-1, -2, …).",
  "WITCHER.WeaponQuality.SPDPenalty.Label": "Penalització de SPD",
  "WITCHER.WeaponQuality.SetBonus.Description": "L'objecte forma part d'un conjunt amb nom (equipament d'escola witcher, etc.). Portar el conjunt complet desbloqueja la bonificació distintiva del conjunt — codificada a la definició del conjunt, no aquí. (El motor emet una nota d'efecte quan totes les peces portades comparteixen un paràmetre de conjunt; la BONIFICACIÓ per conjunt encara requereix una consulta a la definició, que és resolta pel GM.)",
  "WITCHER.WeaponQuality.SetBonus.Label": "Bonificació de conjunt",
  "WITCHER.WeaponQuality.Silver.Description": "Compta com a plata contra les resistències dels monstres; fa la fórmula de dany indicada quan s'utilitza com a atac de plata.",
  "WITCHER.WeaponQuality.Silver.Label": "Argent",
  "WITCHER.WeaponQuality.SilverContact.Description": "Els monstres susceptibles a l'argent queden trontollant sempre que impacten aquesta peça d'armadura amb les seves armes naturals, o sempre que us impacteu mútuament amb, o mantingueu, maniobres de baralla. A més, si s'aplica a braços o cames, atorga als teus cops de puny o puntades l'efecte d'Argent.",
  "WITCHER.WeaponQuality.SilverContact.Label": "Contacte amb argent",
  "WITCHER.WeaponQuality.SlowReload.Description": "Requereix una recàrrega d'1 acció entre trets.",
  "WITCHER.WeaponQuality.SlowReload.Label": "Recàrrega lenta",
  "WITCHER.WeaponQuality.StableAim.Description": "Quan aquesta arma impacta una Ferida Crítica, afegeixes el bonus de la teva acció Apuntar, si en tens, a la tirada de crític.",
  "WITCHER.WeaponQuality.StableAim.Label": "Punteria estable",
  "WITCHER.WeaponQuality.Stagger.Description": "En un impacte amb dany, hi ha possibilitat de desequilibrar l'objectiu (vegeu l'estat Trontollant).",
  "WITCHER.WeaponQuality.Stagger.Label": "Fer trontollar",
  "WITCHER.WeaponQuality.Stifling.Description": "No pots descansar mentre portes aquesta peça d'armadura i no es pot combinar amb altres peces d'armadura sufocant.",
  "WITCHER.WeaponQuality.Stifling.Label": "Sufocant",
  "WITCHER.WeaponQuality.Strangling.Description": "L'arma es pot fer servir per executar un estrangulament, obtenint els beneficis indicats.",
  "WITCHER.WeaponQuality.Strangling.Label": "Estrangulant",
  "WITCHER.WeaponQuality.Stun.Description": "Els impactes al cap/tors forcen una salvació d'Atordiment amb la penalització indicada.",
  "WITCHER.WeaponQuality.Stun.Label": "Atordir",
  "WITCHER.WeaponQuality.Sturdy.Description": "Les armes Robustes poden Bloquejar i Parar atacs d'armes Pesants normalment.",
  "WITCHER.WeaponQuality.Sturdy.Label": "Robust",
  "WITCHER.WeaponQuality.SuperiorGuard.Description": "L'arma dóna un bonus de +2 a les tirades de defensa quan s'utilitza per Bloquejar o Parar.",
  "WITCHER.WeaponQuality.SuperiorGuard.Label": "Guàrdia superior",
  "WITCHER.WeaponQuality.SuperiorLanceRest.Description": "Com Suport de Llança, i a més elimina la penalització de Cop Fort mentre ho fas. (Resolt pel DJ.)",
  "WITCHER.WeaponQuality.SuperiorLanceRest.Label": "Suport de llança superior",
  "WITCHER.WeaponQuality.SuperiorReach.Description": "Pots atacar objectius de 2 a 4 metres més enllà del teu Abast cos a cos normal (2-3 caselles de quadrícula) amb aquesta arma. Reps −3 per Bloquejar, Parar o atacar oponents adjacents, i només els pots atacar amb cops de pom.",
  "WITCHER.WeaponQuality.SuperiorReach.Label": "Abast superior",
  "WITCHER.WeaponQuality.Throwing.Description": "Quan es llança, aquesta arma obté els beneficis indicats.",
  "WITCHER.WeaponQuality.Throwing.Label": "Llançar",
  "WITCHER.WeaponQuality.TwoHand.Description": "Quan s'utilitza com a arma a dues mans en lloc d'a una mà, aquesta arma obté els beneficis indicats.",
  "WITCHER.WeaponQuality.TwoHand.Label": "A dues mans",
  "WITCHER.WeaponQuality.VerySturdy.Description": "Els escuts Molt Robustos poden Bloquejar i Parar atacs d'armes Pesants normalment, i també poden Parar atacs de monstres amb l'efecte Força Aixafadora.",
