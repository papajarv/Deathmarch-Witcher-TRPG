  "WITCHER.Mech.FoodAndDrink.BleakDiet.Description": "Aquest menjar et mantindrà viu. Però és depriment. Pots acumular tantes càrregues de Dieta Ombrívola com la teva Voluntat, i després reps un punt d'ESTRÈS. Menja o beu menjar de millor qualitat per reduir-ho.",
  "WITCHER.Mech.FoodAndDrink.Chat.FamishedDepth": "<div style=\"border-left:3px solid {color};padding:4px 8px\"><b>{name}</b> — {verb} (sacietat ara <b>{satiety}</b>). <b>{sign}{delta} d'estrès</b>.</div>",
  "WITCHER.Mech.FoodAndDrink.Chat.FoodSpoiled": "<div style=\"border-left:3px solid #a83232;padding:4px 8px\"><b>{actor}</b> — food has spoiled:<ul style=\"margin:4px 0 0 14px;padding:0;\">{lines}</ul></div>",
  "WITCHER.Mech.FoodAndDrink.Chat.HungerStressNote": "Hunger Stress cannot be removed by meditation, WILL saves, therapy, or roleplay. Eat back UP through the satiety tier that granted it.",
  "WITCHER.Mech.FoodAndDrink.Chat.IntermediateTierPassed": "<b>{name}</b> · passed {list} · <b>{sign}{delta}</b> stress",
  "WITCHER.Mech.FoodAndDrink.Chat.PoisoningDeath": "<b>{name}</b> · Endurance <b>{roll}</b> vs DC <b>{dc}</b> · alcohol poisoning (<b>{deathRoll}</b>/{deathChance}%) · <b style=\"color:#8b0000\">DEAD</b>.",
  "WITCHER.Mech.FoodAndDrink.Chat.PoisoningHeld": "<b>{name}</b> · Endurance <b>{roll}</b> vs DC <b>{dc}</b> · holds their liquor.",
  "WITCHER.Mech.FoodAndDrink.Chat.PoisoningUnconscious": "<b>{name}</b> · Endurance <b>{roll}</b> vs DC <b>{dc}</b> · passes out for <b>{hours}</b> hours.",
  "WITCHER.Mech.FoodAndDrink.Chat.StaMaxLoss": " · max STA −{n}",
  "WITCHER.Mech.FoodAndDrink.Chat.StarvationEases": "la inanició s'alleugereix",
