  "WITCHER.Weather.Config.Hint.tempSwing": "Quant es tornen més calents els estius i més freds els hiverns.",
  "WITCHER.Weather.Config.HoursUnit": "hores",
  "WITCHER.Weather.Config.Landsites": "Localitzacions",
  "WITCHER.Weather.Config.LatitudeSpan": "Diferència de temperatura nord-sud",
  "WITCHER.Weather.Config.LatitudeSpanHint": "Quant més fred és l'extrem nord del mapa que el sud, de banda a banda. 0 desactiva el gradient de latitud.",
  "WITCHER.Weather.Config.Level1": "Qualsevol (lleu o pitjor)",
  "WITCHER.Weather.Config.Level2": "Moderat o pitjor",
  "WITCHER.Weather.Config.Level3": "Només greu",
  "WITCHER.Weather.Config.MapScene": "Escena del mapa del món",
  "WITCHER.Weather.Config.MapSceneHint": "L'escena el terreny pintat i el marcador del grup del qual controla el clima multi-regió.",
  "WITCHER.Weather.Config.MenuHint": "Totes les opcions de temps i hora en un sol lloc: els interruptors, l'automatització, el clima i la velocitat del rellotge, més els biomes, estacions, localitzacions del terreny, penalitzacions de condicions i llum diürna/lluna — tot amb formularis fàcils. Els valors per defecte són originals d'aquest sistema; pots editar, afegir o eliminar el que vulguis.",
  "WITCHER.Weather.Config.MenuLabel": "Configurar",
  "WITCHER.Weather.Config.MenuName": "Temps i calendari",
  "WITCHER.Weather.Config.ModLabel": "Descripció",
  "WITCHER.Weather.Config.ModLabelPlaceholder": "p. ex. Difícil de veure a la boira",
  "WITCHER.Weather.Config.ModMinLevel": "S'aplica quan",
