  "WITCHER.App.QualitiesEditor.Dialog.Button.PercentRollsD100VsParameter": "Percentatge (tira d100 contra paràmetre)",
  "WITCHER.App.QualitiesEditor.Dialog.Button.ReliabilityBonus": "Bonificació de fiabilitat",
  "WITCHER.App.QualitiesEditor.Dialog.Button.SpellDCBonus": "Bonificació de DC de sortilegi",
  "WITCHER.App.QualitiesEditor.Dialog.Button.StunSaveTargetRollsStunAt": "Salvació d'atordiment (l'objectiu tira Atordiment al paràmetre)",
  "WITCHER.App.QualitiesEditor.Dialog.Button.TextFormula": "Text / fórmula",
  "WITCHER.App.QualitiesEditor.Dialog.ResetConfirm": "<p>Descartar les teves personalitzacions a les qualitats de {name} i restaurar els valors per defecte del sistema? Només té efecte quan Desis.</p>",
  "WITCHER.App.QualitiesEditor.Hint.ChargeBonusPerMeter": "Daus de dany extra per metre de càrrega des d'una muntura (Càrrega = 1, és a dir +1d6/m).",
  "WITCHER.App.QualitiesEditor.Hint.ParryPenaltyDelta": "Redueix en N la penalització de −3 en parada quan DEFENSES amb aquesta arma (Parada = 2).",
  "WITCHER.App.QualitiesEditor.Hint.ReliabilityBonus": "S'afegeix a la Fiabilitat màxima de l'arma quan aquesta qualitat és present (Meteorit = 5).",
  "WITCHER.App.QualitiesEditor.Hint.SkillOverride": "Força la tirada d'impacte de l'arma a usar aquesta clau de skillMap (rarament utilitzat — la skillKey pròpia de l'arma cobreix la major part de casos). En blanc = fa servir el valor per defecte de l'arma.",
  "WITCHER.App.QualitiesEditor.Hint.SpellDCBonus": "Els sortilegis llançats a través d'aquesta arma tracten la DC de l'objectiu com a +N (Focus Superior = 2).",
  "WITCHER.App.QualitiesEditor.Text.AddsDamageToUnarmedBrawlingCestusSpikedG": "Afegeix Dany al Desarmat (Baralla — el cestus / manopla amb punxes suma el seu dany a cops de puny/puntades)",
  "WITCHER.App.QualitiesEditor.Text.DamageFlags": "Etiquetes de dany",
  "WITCHER.App.QualitiesEditor.Text.Description": "Descripció",
  "WITCHER.App.QualitiesEditor.Text.IgnoresRepositionDistanceLongReachWeapon": "Ignora la Distància de Reposicionament (arma d'abast llarg — el Reposicionament del defensor no anul·la els cops següents)",
  "WITCHER.App.QualitiesEditor.Text.Kind": "Tipus",
