  "WITCHER.Mech.FoodAndDrink.Chat.TooStuffedForMore": "<div style=\"border-left:3px solid #8b6f3a;padding:4px 8px\"><b>{actor}</b> is too stuffed for {more} of <b>{item}</b>.</div>",
  "WITCHER.Mech.FoodAndDrink.Dialog.DrainPerHour": "Drain: {drain} / hour",
