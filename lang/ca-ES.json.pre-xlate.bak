  "WITCHER.Chrome.Dissect.Text.DerivedLine": "Derivat · {label}: {value}",
  "WITCHER.Chrome.Dissect.Text.Dissecting": "Dissecant <b>{name}</b> — dificultat <b>{diff}</b> (DC <b>{dc}</b>).",
  "WITCHER.Chrome.Dissect.Text.DissectingWithComplexity": "Dissecant <b>{name}</b> — dificultat <b>{diff}</b> · complexitat <b>{complex}</b>{bonus} (DC <b>{dc}</b>).",
  "WITCHER.Chrome.Dissect.Text.Fail": "Fracàs",
  "WITCHER.Chrome.Dissect.Text.FasterEvery2": "(més ràpid — cada <b>2</b> per sobre de la DC = +1 encert)",
  "WITCHER.Chrome.Dissect.Text.HowAutopsyBody": "Tria l'entorn on es realitza la dissecció (afegeix una bonificació fixa a la teva tirada), després fes clic en un dels botons de categoria de sota. Si la categoria té més d'una habilitat, un segon diàleg et permetrà triar quina tirar. Assoleix la DC per a <b>1 impacte</b>. Cada <b>divisor</b> addicional de punts per sobre de la DC = <b>+1 impacte</b>. Cada impacte revela un fet aleatori desconegut emmagatzemat al bestiari d'aquest personatge; els fets ja coneguts es tornen a tirar fins a trobar-ne un de nou, i els impactes extres es dissipen un cop la categoria és completament coneguda.",
  "WITCHER.Chrome.Dissect.Text.HowAutopsyWorks": "Com funciona l'autòpsia.",
  "WITCHER.Chrome.Dissect.Text.LeastEfficient": "(menys eficient)",
  "WITCHER.Chrome.Dissect.Text.MostEfficient": "(més eficient)",
  "WITCHER.Chrome.Dissect.Text.NoNewInformation": "Cap informació nova.",
  "WITCHER.Chrome.Dissect.Text.NoRpGained": "Cap PR obtingut.",
  "WITCHER.Chrome.Dissect.Text.OnlyOption": "(única opció per a aquesta categoria)",
  "WITCHER.Chrome.Dissect.Text.Pass": "Passar",
  "WITCHER.Chrome.Dissect.Text.PerformingBumpsTier": "Realitzar la dissecció ja puja una entrada de bestiari totalment nova del nivell de recerca 0 → 1.",
  "WITCHER.Chrome.Dissect.Text.Research": "Recerca",
  "WITCHER.Chrome.Dissect.Text.ResearchDesc": "atorga <b>+1 PR</b> per encert cap al nivell de recerca de l'entrada de bestiari d'aquest monstre. Sense revelació de fet aleatori — només punts de recerca.",
  "WITCHER.Chrome.Dissect.Text.RpEarnedLine": "<b>+{rp} PR</b> obtinguts per a aquesta entrada de bestiari.",
  "WITCHER.Chrome.Dissect.Text.Setting": "Ambientació",
  "WITCHER.Chrome.Dissect.Text.SkillRankLine": "Rang d'habilitat · {skill} ({stat}): {value}",
  "WITCHER.Chrome.Dissect.Text.Skills": "Habilitats",
  "WITCHER.Chrome.Dissect.Text.SkillsDesc": "els <b>rangs</b> d'habilitat del monstre (només el valor de l'habilitat, <i>no</i> el total tirat d'atribut + rang).",
  "WITCHER.Chrome.Dissect.Text.SlowerEvery4": "(més lent — cada <b>4</b> per sobre de la DC = +1 encert)",
