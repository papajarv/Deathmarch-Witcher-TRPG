  "WITCHER.Mech.FoodAndDrink.BleakDiet.Description": "Ця їжа збереже вам життя. Але вона гнітюча. Ви можете накопичити стаки Похмурої Дієти, що дорівнюють вашій Волі, а потім отримуєте очко СТРЕСУ. Їжте або пийте їжу кращої якості, щоб знизити це.",
  "WITCHER.Mech.FoodAndDrink.Chat.FamishedDepth": "<div style=\"border-left:3px solid {color};padding:4px 8px\"><b>{name}</b> — {verb} (ситість тепер <b>{satiety}</b>). <b>{sign}{delta} стресу</b>.</div>",
  "WITCHER.Mech.FoodAndDrink.Chat.FoodSpoiled": "<div style=\"border-left:3px solid #a83232;padding:4px 8px\"><b>{actor}</b> — food has spoiled:<ul style=\"margin:4px 0 0 14px;padding:0;\">{lines}</ul></div>",
  "WITCHER.Mech.FoodAndDrink.Chat.HungerStressNote": "Hunger Stress cannot be removed by meditation, WILL saves, therapy, or roleplay. Eat back UP through the satiety tier that granted it.",
  "WITCHER.Mech.FoodAndDrink.Chat.IntermediateTierPassed": "<b>{name}</b> · passed {list} · <b>{sign}{delta}</b> stress",
  "WITCHER.Mech.FoodAndDrink.Chat.PoisoningDeath": "<b>{name}</b> · Endurance <b>{roll}</b> vs DC <b>{dc}</b> · alcohol poisoning (<b>{deathRoll}</b>/{deathChance}%) · <b style=\"color:#8b0000\">DEAD</b>.",
  "WITCHER.Mech.FoodAndDrink.Chat.PoisoningHeld": "<b>{name}</b> · Endurance <b>{roll}</b> vs DC <b>{dc}</b> · holds their liquor.",
  "WITCHER.Mech.FoodAndDrink.Chat.PoisoningUnconscious": "<b>{name}</b> · Endurance <b>{roll}</b> vs DC <b>{dc}</b> · passes out for <b>{hours}</b> hours.",
  "WITCHER.Mech.FoodAndDrink.Chat.StaMaxLoss": " · max STA −{n}",
  "WITCHER.Mech.FoodAndDrink.Chat.StarvationEases": "голод відступає",
  "WITCHER.Mech.FoodAndDrink.Chat.StarvationGnaws": "голод шматує глибше",
  "WITCHER.Mech.FoodAndDrink.Chat.TooStuffedForMore": "<div style=\"border-left:3px solid #8b6f3a;padding:4px 8px\"><b>{actor}</b> is too stuffed for {more} of <b>{item}</b>.</div>",
  "WITCHER.Mech.FoodAndDrink.Dialog.DrainPerHour": "Drain: {drain} / hour",
  "WITCHER.Mech.FoodAndDrink.Dialog.GmSetSatiety": "GM · Set satiety",
  "WITCHER.Mech.FoodAndDrink.Dialog.HungerStressLine": "Hunger Stress: {n} (only cleared by eating)",
  "WITCHER.Mech.FoodAndDrink.Dialog.HungerTickEnabled": "Track hunger on this character",
