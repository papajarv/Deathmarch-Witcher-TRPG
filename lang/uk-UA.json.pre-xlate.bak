  "WITCHER.Mech.StatusEngine.Chat.RollUnderStat": "{status} — кинь нижче {stat} ({target}): {verdict}",
  "WITCHER.Mech.StatusEngine.Chat.ShakesOff": "<em>{actor} струшує <strong>{status}</strong>.</em>",
