  "WITCHER.Mech.FoodAndDrink.Dialog.Title": "Satiety",
  "WITCHER.Mech.FoodAndDrink.DietTier.BlandTriggerReason": "Bleak diet — {sittings} sittings of poor food caught up with {actor}",
  "WITCHER.Mech.FoodAndDrink.DietTier.ChatCard": "<div style=\"border-left:3px solid {color};padding:4px 8px;color:{color}\"><b>{actor}</b> — {label} {kind}{deltaSuffix}.{stressLine}</div>",
  "WITCHER.Mech.FoodAndDrink.DietTier.DeltaSuffix": " (bleak count: <b>{sign}{delta}</b>, now <b>{next}</b>)",
