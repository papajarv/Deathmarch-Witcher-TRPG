  "WITCHER.WR.FlowAndEbb.NotOwner": "У {name} немає героїчної дії Приплив і Відплив.",
  "WITCHER.WR.FlowAndEbb.Nothing": "{name} не витратив жодного вигору цього раунду — нічого регенерувати.",
  "WITCHER.WR.FlowAndEbb.OutOfCombat": "Приплив і Відплив працює лише під час бою.",
  "WITCHER.WR.ForcefulBlow.Button": "Потужний удар (5 ВИТ — перекинути, зберегти вище)",
  "WITCHER.WR.ForcefulBlow.Header": "Потужний удар — перекинути",
  "WITCHER.WR.ForcefulBlow.NoAttacker": "Потужний удар: нападник більше недоступний.",
  "WITCHER.WR.ForcefulBlow.NoStamina": "Потужному удару потрібно 5 ВИТ — у {name} є {sta}.",
  "WITCHER.WR.Fumble.DialogTitle": "Witchers Reborn — Ігнорувати невдачу?",
  "WITCHER.WR.Fumble.SkipNo": "Кинути невдачу",
  "WITCHER.WR.Fumble.SkipYes": "Витратити 5 ВИТ — Пропустити",
  "WITCHER.WR.Fumble.SkippedBanner": "Невдачу пропущено — {name} витратив 5 ВИТ.",
  "WITCHER.WR.LightningFast.Banner": "Блискавично швидкий — {name} отримує {meters}м руху цього раунду ({dice} адреналіну).",
  "WITCHER.WR.LightningFast.NotOwner": "У {name} немає героїчної дії Блискавично швидкий.",
  "WITCHER.WR.LightningFast.OutOfCombat": "Блискавично швидкий працює лише під час бою.",
  "WITCHER.WR.Perserver.Banner": "{name} отримує {gained} адреналіну ({severity}).",
  "WITCHER.WR.Perserver.BannerCapped": "{name} отримує {gained} адреналіну ({severity}) — було б {grant}, обмежено ТІЛОМ {cap}.",
  "WITCHER.WR.Perserver.NoGain": "{name} вже був на або вище ТІЛА {cap} — адреналін не отримано ({severity}, було б {grant}).",
  "WITCHER.Weapon.Bomb.Shape.Circle": "Коло",
  "WITCHER.Weapon.Bomb.Shape.Cone": "Конус",
  "WITCHER.Weapon.Bomb.Shape.Line": "Лінія",
  "WITCHER.Weapon.Bomb.Shape.Rect": "Прямокутник",
  "WITCHER.Weapon.Draw": "Витягнути зброю (Швидке витягування)",
  "WITCHER.Weapon.HandLeft": "Ліворуч",
  "WITCHER.Weapon.HandRight": "Праворуч",
  "WITCHER.Weapon.HandTwoHanded": "Дворучне",
  "WITCHER.Weapon.Hands.one": "Одноручне",
  "WITCHER.Weapon.Hands.two": "Дворучне",
  "WITCHER.Weapon.Slot.left": "Друга рука",
  "WITCHER.Weapon.Slot.quick": "Швидко / Друга рука",
  "WITCHER.Weapon.Slot.right": "Основна рука",
  "WITCHER.Weapon.TypeBomb": "Бомба",
  "WITCHER.Weapon.TypeMelee": "Ближній бій",
  "WITCHER.Weapon.TypeRanged": "Дальнобійний",
  "WITCHER.Weapon.TypeThrown": "Кинуто",
  "WITCHER.WeaponQuality.Ablating.Description": "On a penetrating hit, deals an additional 1d6/2 SP damage to the target's armor (rolled per hit, 0–3 extra SP off the location's value, on top of the standard −1 SP chip every penetrating hit causes).",
  "WITCHER.WeaponQuality.Ablating.Label": "Стирання броні",
  "WITCHER.WeaponQuality.ArcheryShield.Description": "Прив'язаний до передпліччя, дозволяє володіти луком або арбалетом без штрафу. Кидки Блоку / Парирування зі щитом мають -1, а будь-яка близька зброя, використана рукою зі щитом, отримує -1 до атак, Блоків і Парирувань. (Вирішується ГМ — авто-кол -1 на Блок/Парирування щитом від цієї якості немає; звільнення +дальнього-зі-щитом потребує потоку CE, ще не підключеного.)",
  "WITCHER.WeaponQuality.ArcheryShield.Label": "Лучний щит",
  "WITCHER.WeaponQuality.ArmorPiercing.Description": "Ігнорує опір шкоді броні цілі.",
  "WITCHER.WeaponQuality.ArmorPiercing.Label": "Бронебійність",
  "WITCHER.WeaponQuality.Balanced.Description": "Кращі крити: кинь 2d6+2 (або 1d6+1 при прицілюванні) для тяжкості.",
  "WITCHER.WeaponQuality.Balanced.Label": "Збалансований",
  "WITCHER.WeaponQuality.BladeCatcher.Description": "When you block a melee attack with it, both weapons lock together and are useless until the attacker beats your Small Blades check with a Physique or Sleight of Hand check, or you let go.",
  "WITCHER.WeaponQuality.BladeCatcher.Label": "Ловець клинка",
  "WITCHER.WeaponQuality.Bleeding.Description": "При шкоді — шанс завдати Кровотечу (див. Ефекти статусу).",
  "WITCHER.WeaponQuality.Bleeding.Label": "Кровотеча",
  "WITCHER.WeaponQuality.Brawling.Description": "Шкода зброї додається до звичайної шкоди твого удару кулаком або ногою, і змінює тип цієї шкоди на вказаний.",
  "WITCHER.WeaponQuality.Brawling.Label": "Бійка",
  "WITCHER.WeaponQuality.Cavalry.Description": "When used to attack while mounted, the weapon adds a damage die for every 1m of movement instead of 2m. (Equipment Overhaul's rename of the legacy Core ‘Charging’ quality.)",
  "WITCHER.WeaponQuality.Cavalry.Label": "Кавалерія",
  "WITCHER.WeaponQuality.Charging.Description": "When used to Charge, this weapon deals an extra damage die per 2m moved, up to the maximum shown. This is in addition to the extra damage gained from movement during mounted combat. (EO's redefined ‘Charging’ — distinct from the legacy Core entry kept at the `charging` key.)",
  "WITCHER.WeaponQuality.Charging.Label": "Ривок",
  "WITCHER.WeaponQuality.CharginglegacyCore.Description": "Legacy Core ‘Charging’ — used from a mount in motion: add 1d6 bonus damage per meter charged, rather than the usual half. Equipment Overhaul renames this to ‘Cavalry’ (see below); use that key for new items.",
  "WITCHER.WeaponQuality.CharginglegacyCore.Label": "Ривок (застарілий Core)",
  "WITCHER.WeaponQuality.CloseQuarters.Description": "Отримує вказані переваги при атаці ворога, який у захопленні, притисненні, задушливому захваті чи клінчі з атакуючим.",
  "WITCHER.WeaponQuality.CloseQuarters.Label": "Ближній бій",
  "WITCHER.WeaponQuality.Concealment.Description": "+2 до перевірок на приховування цієї зброї на собі. (Вирішується ГМ — авто-поверхні перевірки Приховування немає.)",
  "WITCHER.WeaponQuality.Concealment.Label": "Прикриття",
  "WITCHER.WeaponQuality.Crafting.Description": "Рахується як інструмент для перелічених споруд чи активностей, знижуючи штрафи, якщо тобі бракує Ремісничих інструментів.",
  "WITCHER.WeaponQuality.Crafting.Label": "Ремесло",
  "WITCHER.WeaponQuality.CrewReload.Description": "Перезарядка займає 2 дії, які дві особи можуть розділити між собою. (Вирішується ГМ — немає конвеєра перезарядки з кількома персонажами.)",
  "WITCHER.WeaponQuality.CrewReload.Label": "Перезарядка екіпажем",
  "WITCHER.WeaponQuality.CriticalBlock.Description": "When you beat an attacker by more than 4 on a Block or Parry with your Manticore shield, immediately make a Shield Strike that knocks them back 4m and prone, at no extra penalty or Stamina.",
  "WITCHER.WeaponQuality.CriticalBlock.Label": "Критичний Блок",
  "WITCHER.WeaponQuality.CriticalDecimation.Description": "Коли ти завдаєш критичну рану відьмачою зброєю, вважай її на один рівень тяжчою (Проста критична стає Складною тощо).",
  "WITCHER.WeaponQuality.CriticalDecimation.Label": "Критичне Знищення",
  "WITCHER.WeaponQuality.CriticalFlurry.Description": "Коли ти завдаєш критичну рану відьмачою зброєю, негайно спробуй Обеззброїти або Підніжку без додаткового штрафу і без витрачання додаткової ВИТ.",
  "WITCHER.WeaponQuality.CriticalFlurry.Label": "Критичний Шквал",
  "WITCHER.WeaponQuality.CriticalMomentum.Description": "Коли ти завдаєш критичну рану відьмачою зброєю, негайно зроби один Удар зброєю в руках без додаткового штрафу чи ВИТ.",
  "WITCHER.WeaponQuality.CriticalMomentum.Label": "Критичний Імпульс",
  "WITCHER.WeaponQuality.CriticalRiposte.Description": "Коли ти перемагаєш нападника більш ніж на 4 у Парируванні відьмачою зброєю, негайно Удар зброєю в руках без додаткового штрафу чи ВИТ.",
  "WITCHER.WeaponQuality.CriticalRiposte.Label": "Критична Ріпоста",
  "WITCHER.WeaponQuality.CriticalSpellcasting.Description": "When you score a critical wound with a witcher weapon, immediately make a Spellcasting check to cast a Sign at no extra penalty and without spending Stamina beyond the Sign's own cost.",
  "WITCHER.WeaponQuality.CriticalSpellcasting.Label": "Критичне Чаклунство",
  "WITCHER.WeaponQuality.CrushingForce.Description": "Не можна парирувати; подвоює стандартну сколюючу −1 ЗБ до −2 на кожному проникному влучанні (на зброї, щитах, броні).",
  "WITCHER.WeaponQuality.CrushingForce.Label": "Нищівна Сила",
  "WITCHER.WeaponQuality.Deployable.Description": "Ти можеш використати Дію, щоб підперти цей щит як переносне укріплення. (Вирішується ГМ — немає стану токена переносного укриття.)",
  "WITCHER.WeaponQuality.Deployable.Label": "Розгортається",
  "WITCHER.WeaponQuality.Difficult.Description": "Цей елемент броні має носитися з піддоспішником і не може бути спорядженим без допомоги.",
  "WITCHER.WeaponQuality.Difficult.Label": "Складно",
  "WITCHER.WeaponQuality.Disease.Description": "При влучанні зі шкодою — шанс наслати стан Хвороба (див. Ефекти статусу).",
  "WITCHER.WeaponQuality.Disease.Label": "Хвороба",
  "WITCHER.WeaponQuality.Entangling.Description": "On a hit the target is entangled: -5 SPD and -2 to all physical actions; each turn a DC 18 Dodge/Escape or Contortionist check breaks free, or an ally may spend an action to remove it.",
  "WITCHER.WeaponQuality.Entangling.Label": "Заплутування",
  "WITCHER.WeaponQuality.ExtremeReach.Description": "You can attack targets 2-6 meters beyond your normal melee Reach (2-4 grid squares away) with this weapon. You take −5 to Block or Parry adjacent opponents, and can't attack them, even with pommel strikes.",
  "WITCHER.WeaponQuality.ExtremeReach.Label": "Екстремальна досяжність",
  "WITCHER.WeaponQuality.Feeble.Description": "Ця зброя може Парирувати лише іншу Слабку зброю, а при використанні для Блоку не-Слабкої зброї захисник усе одно отримує половину шкоди при успіху. При Блокуванні Громіздкої зброї захисник отримує половину шкоди як смертельну, а половину — як не смертельну.",
  "WITCHER.WeaponQuality.Feeble.Label": "Слабкий",
  "WITCHER.WeaponQuality.Fire.Description": "При влучанні з шкодою — шанс підпалити ціль (див. статус Горіння).",
  "WITCHER.WeaponQuality.Fire.Label": "Вогонь",
  "WITCHER.WeaponQuality.Fireproof.Description": "Зменшує вогняну шкоду навпіл і дає імунітет до статусу Горіння.",
  "WITCHER.WeaponQuality.Fireproof.Label": "Вогнестійкий",
  "WITCHER.WeaponQuality.Focus.Description": "Застосування через цю зброю зменшує вартість ВИТ на її значення Фокусу.",
  "WITCHER.WeaponQuality.Focus.Label": "Фокус",
  "WITCHER.WeaponQuality.Foraging.Description": "При використанні для збору вказаного типу ресурсу ти отримуєш +1 одиницю цього ресурсу.",
  "WITCHER.WeaponQuality.Foraging.Label": "Збиральництво",
  "WITCHER.WeaponQuality.FreeAmmunition.Description": "Ця зброя може використовувати каміння, палки або інші імпровізовані снаряди з довкілля як безкоштовні боєприпаси.",
  "WITCHER.WeaponQuality.FreeAmmunition.Label": "Безкоштовний боєприпас",
  "WITCHER.WeaponQuality.Freeze.Description": "При влучанні з шкодою — шанс заморозити ціль наглухо (див. статус Заморожений).",
  "WITCHER.WeaponQuality.Freeze.Label": "Заморозити",
  "WITCHER.WeaponQuality.FullCoverdeprecated.Description": "Equipment Overhaul retires this quality — it is mechanically subsumed by any shield with a Cover Value of 6 or more. Kept in the catalog for backward compatibility with pavise-style items; new shields should set CV ≥ 6 instead.",
  "WITCHER.WeaponQuality.FullCoverdeprecated.Label": "Повне укриття (застаріле)",
  "WITCHER.WeaponQuality.Grappling.Description": "Можна використати для захоплення й підніжок опонентів у межах досяжності. (Використай дію Захоплення РБ; перевірка передумов у actions.mjs, а не в цій якості.)",
  "WITCHER.WeaponQuality.Grappling.Label": "Захоплення",
  "WITCHER.WeaponQuality.GreaterFocus.Description": "Заклинання, застосовані через цю зброю, трактують СК як +2.",
  "WITCHER.WeaponQuality.GreaterFocus.Label": "Більший фокус",
  "WITCHER.WeaponQuality.Grounded.Description": "You can't load or shoot this weapon if riding an animal or driving a vehicle. You can still load and shoot as a passenger on a boat, wagon, or cart, but you must stand upright and may be penalized.",
  "WITCHER.WeaponQuality.Grounded.Label": "На землі",
  "WITCHER.WeaponQuality.Guard.Description": "Зброя дає +1 бонус до кидків захисту, коли використовується для Блоку або Парирування.",
  "WITCHER.WeaponQuality.Guard.Label": "Стійка",
  "WITCHER.WeaponQuality.HalfDamage.Description": "Цей боєприпас завдає половину базової шкоди зброї (округлюючи вниз). Зазвичай поєднується з дебафом або статус-модифікатором замість шкоди.",
  "WITCHER.WeaponQuality.HalfDamage.Label": "Половина шкоди",
  "WITCHER.WeaponQuality.Hefty.Description": "Занадто важка для Швидкого удару — Швидкий удар недоступний з цією зброєю (використай Одну атаку). Її атаки не можна Парирувати, а вона завдає половину шкоди як не смертельну при успішному Блокуванні.",
  "WITCHER.WeaponQuality.Hefty.Label": "Громіздкий",
  "WITCHER.WeaponQuality.Hidden.Description": "Concealed under clothing: requires an Awareness check at the listed DC to detect. (GM-resolved — no automatic Awareness detection surface; the DC chip is for hand-roll reference.)",
  "WITCHER.WeaponQuality.Hidden.Label": "Прихований",
  "WITCHER.WeaponQuality.ImprovedArmorPiercing.Description": "Ignores armor's damage resistance, halves the armor's SP on hit, and bypasses monster per-type resistances + immunities. Does NOT bypass the 'vulnerable only to silver' or 'vulnerable only to meteorite' weakness gates.",
  "WITCHER.WeaponQuality.ImprovedArmorPiercing.Label": "Покращена Бронебійність",
  "WITCHER.WeaponQuality.ImprovedRange.Description": "Цей боєприпас покращує дальність зброї на 50%.",
  "WITCHER.WeaponQuality.ImprovedRange.Label": "Покращена дальність",
  "WITCHER.WeaponQuality.Indirect.Description": "Гнучкість або вигин зброї дозволяє дістати позаду захисту опонента. Спроби Блоку або Парирування її атак завжди кидаються при −2. Однак це робить її незручною в захисті, тож вона теж Блокує і Парирує при −2.",
  "WITCHER.WeaponQuality.Indirect.Label": "Опосередкований",
  "WITCHER.WeaponQuality.Injector.Description": "Can be charged (an action) with a dose of poison or elixir; a damaging hit drives the dose deep, making a poison 3 harder to resist or an elixir last 3 rounds longer. (GM-resolved — no charge-with-poison UI; rider note posts on hit.)",
  "WITCHER.WeaponQuality.Injector.Label": "Ін'єктор",
  "WITCHER.WeaponQuality.KnockDown.Description": "При влучанні з шкодою — шанс збити ціль з ніг.",
  "WITCHER.WeaponQuality.KnockDown.Label": "Збиття з ніг",
  "WITCHER.WeaponQuality.LanceRest.Description": "Allows you to use your Full Turn to make a one-handed charging attack with a lance while mounted, without the usual penalty for attacking one-handed with a two-handed weapon. (GM-resolved — no first-class mount + lance flow.)",
  "WITCHER.WeaponQuality.LanceRest.Label": "Ліжко для списа",
  "WITCHER.WeaponQuality.LongReach.Description": "You can attack targets 2 meters beyond your normal melee Reach (2 grid squares away) with this weapon. You take −1 to Block, Parry, or attack adjacent opponents.",
  "WITCHER.WeaponQuality.LongReach.Label": "Довга досяжність",
  "WITCHER.WeaponQuality.MagicallyAnchoring.Description": "While a creature touches the weapon it cannot turn invisible or intangible or teleport away; any already invisible or intangible creature is forced visible and solid.",
  "WITCHER.WeaponQuality.MagicallyAnchoring.Label": "Магічне заякорення",
  "WITCHER.WeaponQuality.Meteorite.Description": "Full damage vs meteorite-vulnerable monsters. Per Equipment Overhaul, if you don't use the alternate optional rules for monster susceptibilities, this quality instead grants the weapon (or shield) an extra enchantment slot for runes (up to 3 total). Legacy house-rule kept Reliability +5 for backward compatibility.",
  "WITCHER.WeaponQuality.Meteorite.Label": "Метеорит",
  "WITCHER.WeaponQuality.MeteoriteContact.Description": "Meteorite-susceptible monsters become staggered whenever they hit this armor piece with their natural weapons, or whenever either of you hit each other with, or maintain, brawling maneuvers. Additionally, if applied to arms or legs, it grants your punches or kicks the Meteorite effect.",
  "WITCHER.WeaponQuality.MeteoriteContact.Label": "Метеоритний контакт",
  "WITCHER.WeaponQuality.MonsterResistance.Description": "Built-in witcher-school resistance to a listed monster damage profile (e.g. Necrophages, Specters). Parameter records the resistance set; engine consumer reads it during damage resolution. (GM-resolved — no per-monster-set damage ledger; parameter text surfaces on the chip.)",
  "WITCHER.WeaponQuality.MonsterResistance.Label": "Опір монстра",
  "WITCHER.WeaponQuality.Mounted.Description": "Fixed in place; it must be set up before use and packed away (an action each) before it can be moved. (GM-resolved — no setup/pack-away action surface; chargeBonusPerMeter on cavalry/charging IS engine-wired.)",
  "WITCHER.WeaponQuality.Mounted.Label": "Верхи",
  "WITCHER.WeaponQuality.Nimble.Description": "Коли ти використовуєш Додаткову дію, щоб витягти або атакувати цією зброєю, вартість ВИТ знижується на 2.",
  "WITCHER.WeaponQuality.Nimble.Label": "Спритний",
  "WITCHER.WeaponQuality.NonLethaldeprecated.Description": "Equipment Overhaul retires this quality — eligible weapons are now given N(on-lethal) as a damage type option instead. Kept in the catalog for backward compatibility with items that still reference it; new items should set damage type to Non-lethal.",
  "WITCHER.WeaponQuality.NonLethaldeprecated.Label": "Не смертельно (застаріле)",
  "WITCHER.WeaponQuality.Options.Description": "You can get a variation of this armor that doesn't cover the arms and has its EV penalties mitigated by the parenthetical amount. If it normally covers the legs you can also get it in a shorter version that doesn't, also reducing its EV by the same amount. Using either option reduces the weight and price by 20%, and using both options reduces the weight and price by 40%. (GM-resolved — the GM hand-creates the variant item; no auto-derive.)",
  "WITCHER.WeaponQuality.Options.Label": "Опції",
  "WITCHER.WeaponQuality.Parrying.Description": "Парирування цією зброєю знижує штраф парирування на 2.",
  "WITCHER.WeaponQuality.Parrying.Label": "Парирування",
  "WITCHER.WeaponQuality.Physique.Description": "Якщо база твоєї Фізичної сили нижча за вказане число, твої кидки атаки отримують штраф, рівний різниці.",
  "WITCHER.WeaponQuality.Physique.Label": "Фізична сила",
  "WITCHER.WeaponQuality.Poison.Description": "При влучанні з шкодою — шанс отруїти ціль (див. статус Отруєний).",
  "WITCHER.WeaponQuality.Poison.Label": "Отрута",
  "WITCHER.WeaponQuality.PoorVision.Description": "You have a reduced field of vision and lose scent tracking abilities, and you only recover HALF your normal Stamina from in-combat recovery (Take Breath). With Poor Vision, you also take a −2 to Awareness and ranged attacks, and a −1 penalty to all other vision-dependent checks. On many helms you can open a visor or mask as an Action to negate this, but that removes any resistance to piercing attacks the helmet has and reduces SP by 5.",
  "WITCHER.WeaponQuality.PoorVision.Label": "Погана видимість",
  "WITCHER.WeaponQuality.RangedPenalty.Description": "Важка або обмежувальна броня на руках дає плоский штраф до кидків дальніх атак. Параметр записує значення штрафу (-1, -2, …).",
  "WITCHER.WeaponQuality.RangedPenalty.Label": "Штраф дальнього бою",
  "WITCHER.WeaponQuality.ReducedRange.Description": "Цей боєприпас половинить дальність зброї.",
  "WITCHER.WeaponQuality.ReducedRange.Label": "Знижена дальність",
  "WITCHER.WeaponQuality.ResistancetoBleeding.Description": "Знижує шанс закріплення статусу Кровотеча на вказану величину (за замовч. -25%).",
  "WITCHER.WeaponQuality.ResistancetoBleeding.Label": "Опір кровотечі",
  "WITCHER.WeaponQuality.RestrictedVision.Description": "You have a reduced field of vision and lose scent tracking abilities, and you only recover HALF your normal Stamina from in-combat recovery (Take Breath). On many helms you can open a visor or mask as an Action to negate this, but that removes any resistance to piercing attacks the helmet has and reduces SP by 5.",
  "WITCHER.WeaponQuality.RestrictedVision.Label": "Обмежений огляд",
  "WITCHER.WeaponQuality.SPDPenalty.Description": "Важка або обмежувальна броня на ногах дає плоский штраф до твоєї хар. ШВ. Параметр записує значення штрафу (-1, -2, …).",
  "WITCHER.WeaponQuality.SPDPenalty.Label": "Штраф ШВ",
  "WITCHER.WeaponQuality.SetBonus.Description": "Item is part of a named set (witcher school kit, etc.). Wearing the complete set unlocks the set's signature bonus — encoded on the set definition, not here. (Engine fires a rider note when all worn pieces share a set parameter; the per-set BONUS still requires a set-definition lookup, which is GM-resolved.)",
  "WITCHER.WeaponQuality.SetBonus.Label": "Бонус набору",
  "WITCHER.WeaponQuality.Silver.Description": "Рахується як срібло проти опору монстрів; завдає вказану формулу шкоди при використанні як срібна атака.",
  "WITCHER.WeaponQuality.Silver.Label": "Срібло",
  "WITCHER.WeaponQuality.SilverContact.Description": "Silver-susceptible monsters become staggered whenever they hit this armor piece with their natural weapons, or whenever either of you hit each other with, or maintain, brawling maneuvers. Additionally, if applied to arms or legs, it grants your punches or kicks the Silver effect.",
  "WITCHER.WeaponQuality.SilverContact.Label": "Срібний контакт",
  "WITCHER.WeaponQuality.SlowReload.Description": "Потребує перезарядки на 1 дію між пострілами.",
  "WITCHER.WeaponQuality.SlowReload.Label": "Повільне перезарядження",
  "WITCHER.WeaponQuality.StableAim.Description": "Коли ця зброя влучає в Критичну Рану, ти додаєш бонус дії Прицілювання, якщо є, до кидка критичного влучання.",
  "WITCHER.WeaponQuality.StableAim.Label": "Стійкий приціл",
  "WITCHER.WeaponQuality.Stagger.Description": "При влучанні зі шкодою — шанс позбавити ціль рівноваги (див. статус Похитнутий).",
  "WITCHER.WeaponQuality.Stagger.Label": "Похитнути",
  "WITCHER.WeaponQuality.Stifling.Description": "Ти не можеш відпочивати, поки носиш цей елемент броні, і він не може шаруватися з іншими задушливими елементами.",
  "WITCHER.WeaponQuality.Stifling.Label": "Задушливо",
  "WITCHER.WeaponQuality.Strangling.Description": "Зброю можна використати для задушливого захвату, отримуючи вказані переваги.",
  "WITCHER.WeaponQuality.Strangling.Label": "Задушення",
  "WITCHER.WeaponQuality.Stun.Description": "Влучання в голову/тулуб змушують кинути рятівний кидок від оглушення зі вказаним штрафом.",
  "WITCHER.WeaponQuality.Stun.Label": "Оглушення",
  "WITCHER.WeaponQuality.Sturdy.Description": "Міцна зброя може Блокувати та Парирувати атаки Громіздкої зброї як зазвичай.",
  "WITCHER.WeaponQuality.Sturdy.Label": "Міцний",
  "WITCHER.WeaponQuality.SuperiorGuard.Description": "Зброя дає +2 бонус до кидків захисту, коли використовується для Блоку або Парирування.",
  "WITCHER.WeaponQuality.SuperiorGuard.Label": "Краща стійка",
  "WITCHER.WeaponQuality.SuperiorLanceRest.Description": "Як Ліжко для списа, і додатково нівелює штраф Сильного удару під час цього. (Вирішується ГМ.)",
  "WITCHER.WeaponQuality.SuperiorLanceRest.Label": "Краще ліжко для списа",
  "WITCHER.WeaponQuality.SuperiorReach.Description": "You can attack targets 2-4 meters beyond your normal melee Reach (2-3 grid squares away) with this weapon. You take −3 to Block, Parry, or attack adjacent opponents, and can only attack them with pommel strikes.",
  "WITCHER.WeaponQuality.SuperiorReach.Label": "Найвища досяжність",
  "WITCHER.WeaponQuality.Throwing.Description": "При кидку ця зброя отримує вказані переваги.",
  "WITCHER.WeaponQuality.Throwing.Label": "Метальне",
  "WITCHER.WeaponQuality.TwoHand.Description": "При використанні як дворучна зброя замість одноручної ця зброя отримує вказані переваги.",
  "WITCHER.WeaponQuality.TwoHand.Label": "Дворучне",
  "WITCHER.WeaponQuality.VerySturdy.Description": "Дуже міцні щити можуть Блокувати і Парирувати атаки Громіздкої зброї як зазвичай, і також можуть Парирувати атаки монстрів з ефектом Нищівна Сила.",
  "WITCHER.WeaponQuality.VerySturdy.Label": "Дуже міцний",
