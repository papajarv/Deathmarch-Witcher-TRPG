  "WITCHER.Mech.Stress.Chat.PointsLeft": "{n} очок залишилось",
  "WITCHER.Mech.Stress.Chat.SelfHarm": "<div style=\"border-left:3px solid #6b3f3f;padding:4px 8px\"><b>{name}</b> — самопошкодження: <b>{base}</b>{mult} = <b>{damage}</b> шкоди до <b>{loc}</b>.</div>",
  "WITCHER.Mech.Stress.Chat.SmileAtDeath": "<i>{name} посміхається Смерті — Тимч. ОЗ +<b>{hp}</b>, Тимч. ВИТ +<b>{sta}</b>.</i>",
