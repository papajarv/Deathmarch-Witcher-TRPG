  "WITCHER.Mech.StatusEngine.Chat.StressOnApply": "<div style=\"border-left:3px solid {colour}; padding:4px 8px; margin:2px 0;\">{icon} <b>{name}</b> — Стрес <b>{sign}{delta}</b> <small style=\"opacity:0.75;\">({before} → {after})</small><div style=\"opacity:0.85; font-size:0.8125rem;\">{sources}</div></div>",
