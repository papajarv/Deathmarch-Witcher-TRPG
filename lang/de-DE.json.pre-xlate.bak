  "WITCHER.Mech.Stress.Boon.Optimistic.Effect": "So schlimm ist es nicht. Baue 1 STRESS ab.",
  "WITCHER.Mech.Stress.Boon.Optimistic.Name": "Optimistisch",
  "WITCHER.Mech.Stress.Boon.SmileAtDeath.Effect": "Du machst deinen Frieden mit deinem Ende. Baue allen STRESS ab. Ignoriere alle Wund-Malus bis zum Kampfende. Du erhältst 2w6 temporäre TP und 2w6 temporäre AUS. Du erhältst +2 REF bis zum Kampfende. Wenn der Kampf",
  "WITCHER.Mech.Stress.Boon.SmileAtDeath.Name": "Dem Tod ins Auge blicken",
  "WITCHER.Mech.Stress.Boon.Stalwart.Effect": "Du baust 2 STRESS ab. Du wirst das überstehen.",
  "WITCHER.Mech.Stress.Boon.Stalwart.Name": "Standhaft",
  "WITCHER.Mech.Stress.Boon.Stoic.Effect": "Das ist nichts für dich. Du ignorierst die nächsten 1w6 Punkte STRESS.",
  "WITCHER.Mech.Stress.Boon.Stoic.Name": "Stoisch",
  "WITCHER.Mech.Stress.Boon.Unbreakable.Effect": "Dein gesamter STRESS ist abgebaut. Du bist entschlossen. Nichts hält dich auf. Du bestehst automatisch 3 Todesrettungswürfe im Kampf und ignorierst Malus dafür, unter deiner Wundschwelle oder im Todeszustand zu sein, für 3",
  "WITCHER.Mech.Stress.Boon.Unbreakable.Name": "Unzerbrechlich",
  "WITCHER.Mech.Stress.Break.Depressive.Effect": "Nichts scheint mehr wichtig zu sein. Wozu das alles. −2 WIL.",
  "WITCHER.Mech.Stress.Break.Depressive.Name": "Depressiv",
  "WITCHER.Mech.Stress.Break.Impulsive.Effect": "Tu einfach irgendetwas. Nicht die Zeit, nachzudenken.",
  "WITCHER.Mech.Stress.Break.Impulsive.Name": "Impulsiv",
  "WITCHER.Mech.Stress.Break.Indulgent.Effect": "Das ist zu viel. Du brauchst dein Laster. Du brauchst Trost. Iss, bis du vollgefressen bist.",
  "WITCHER.Mech.Stress.Break.Indulgent.Name": "Nachgiebig",
  "WITCHER.Mech.Stress.Break.Paranoid.Effect": "Kannst du wirklich jemandem außer dir selbst trauen? Wirst du beobachtet? Etwas hat es auf dich abgesehen. Isoliere dich.",
  "WITCHER.Mech.Stress.Break.Paranoid.Name": "Paranoid",
  "WITCHER.Mech.Stress.Break.Scared.Effect": "Du bist in Gefahr. Alles ist ungewiss. −1 auf jeden Wurf.",
  "WITCHER.Mech.Stress.Break.Scared.Name": "Ängstlich",
  "WITCHER.Mech.Stress.Break.SelfHarming.Effect": "Dumm, dumm, dumm. Das ist alles deine Schuld. Du hast das getan. Erhalte 1w6 Schaden an einem zufälligen Körperteil.",
  "WITCHER.Mech.Stress.Break.SelfHarming.Name": "Selbstverletzend",
  "WITCHER.Mech.Stress.Break.Selfish.Effect": "Nicht die Zeit, an andere zu denken. Du musst auf dich selbst achten.",
  "WITCHER.Mech.Stress.Break.Selfish.Name": "Selbstsüchtig",
  "WITCHER.Mech.Stress.Break.Violent.Effect": "Du hast genug. Gewalt ist die einzige Antwort. +1 REF für den unmittelbaren Kampf.",
  "WITCHER.Mech.Stress.Break.Violent.Name": "Gewalttätig",
  "WITCHER.Mech.Stress.Chat.BoonAbsorb": "<div style=\"border-left:3px solid {tint};padding:4px 8px\"><b>{name}</b> — <b>{boon}</b> absorbierte <b>{absorbed}</b> STRESS<br><small>{detail}</small></div>",
  "WITCHER.Mech.Stress.Chat.CriticalRider": "<div class=\"wdm-attack-rider\" style=\"border-left:3px solid {tint}\"><i class=\"fa-solid fa-brain\"></i> <strong>{name}</strong> · <strong>{label}</strong> kritische Wunde — Stress <b>+{delta}</b>.</div>",
  "WITCHER.Mech.Stress.Chat.CriticalStandalone": "<div style=\"border-left:3px solid {tint};padding:4px 8px\"><b>{name}</b> — erlitt <b>{label}</b> kritische Wunde.<br>Stress <b>+{delta}</b> durch den Schock der Verletzung.</div>",
  "WITCHER.Mech.Stress.Chat.Depleted": "erschöpft",
  "WITCHER.Mech.Stress.Chat.HopefulDetail": "1 Quelle ausgegeben — {left}",
  "WITCHER.Mech.Stress.Chat.PointsLeft": "{n} Punkte übrig",
  "WITCHER.Mech.Stress.Chat.SelfHarm": "<div style=\"border-left:3px solid #6b3f3f;padding:4px 8px\"><b>{name}</b> — Selbstverletzung: <b>{base}</b>{mult} = <b>{damage}</b> Schaden an <b>{loc}</b>.</div>",
  "WITCHER.Mech.Stress.Chat.SmileAtDeath": "<i>{name} lächelt dem Tod ins Auge — Temp-TP +<b>{hp}</b>, Temp-AUS +<b>{sta}</b>.</i>",
