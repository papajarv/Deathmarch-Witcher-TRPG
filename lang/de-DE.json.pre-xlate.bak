  "WITCHER.App.QualitiesEditor.Tooltip.DiscardYourOverrideRevertToSystemDefault": "Eigene Überschreibung verwerfen; auf Systemstandard zurücksetzen",
  "WITCHER.App.QualitiesEditor.Tooltip.RemoveThisQuality": "Diese Qualität entfernen",
  "WITCHER.App.RaiseShieldDialog.Dialog.Button.LowerShield": "Schild senken",
  "WITCHER.App.RaiseShieldDialog.Text.BodyZonesClickToCoverWithShield": "Körperzonen — klicken, um mit dem Schild abzudecken",
  "WITCHER.App.RaiseShieldDialog.Text.Covering": "Deckt ab",
  "WITCHER.App.RaiseShieldDialog.Text.HeadCoveredWarn": "Kopf abgedeckt → Eingeschränkte Sicht (−2 auf Blocken / Parieren / Ausweichen bis zu deinem nächsten Zug).",
  "WITCHER.App.RaiseShieldDialog.Text.NoLocationsPicked": "(keine Zonen ausgewählt)",
