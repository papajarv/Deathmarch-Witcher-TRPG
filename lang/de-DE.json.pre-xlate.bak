  "WITCHER.EditImage": "Porträt ändern",
  "WITCHER.Effect.ActionAdrCostDelta": "Delta der Adrenalin-STA-Kosten",
  "WITCHER.Effect.ActionAdrCostDeltaHint": "Vorzeichenbehaftete ganze Zahl, die zu den Grund-STA-Kosten pro eingesetztem Adrenalinwürfel addiert wird. Negativ = günstiger, positiv = teurer. Wird über alle Effekte des Akteurs summiert.",
  "WITCHER.Effect.ActionAdrCostDeltaLabel": "Δ STA pro Adrenalinwürfel",
  "WITCHER.Effect.ActionClearHangover": "Kater beenden",
  "WITCHER.Effect.ActionClearHangoverHint": "Beim Anwenden dieses Effekts wird sofort jeder Kater, an dem der Träger leidet, entfernt. Der auslösende Effekt selbst bleibt bestehen — überlasse dessen Dauer oder Entfernung die Aufräumarbeit. Nutze ihn für Katertränke, kräftigende Mahlzeiten, Anrufungen eines Klerikers usw.",
  "WITCHER.Effect.ActionDamage": "Jede Runde Schaden verursachen",
  "WITCHER.Effect.ActionHeal": "Heilen",
  "WITCHER.Effect.ActionImmunity": "Status-Immunität gewähren",
  "WITCHER.Effect.ActionImmunityStatus": "Immun gegen Status",
  "WITCHER.Effect.ActionModify": "Einen Wert verändern",
  "WITCHER.Effect.ActionPurge": "Alle Alchemie-Effekte löschen",
  "WITCHER.Effect.ActionPurgeHint": "Wenn dieser Effekt eintritt, endet jeder andere toxizitätstragende Trank-/Dekokt-Effekt am Träger (deren Toxizität wird zusammen mit ihnen zurückgewonnen). So funktioniert Weißer Honig.",
  "WITCHER.Effect.ActionStressShield": "Stress-Schild",
  "WITCHER.Effect.ActionStressShieldHint": "Beim Anwenden wird der Wert als Roll-Formel (Würfel oder feste Zahl) ausgewertet und der Puffer gesetzt. PUNKTE: jeder Stressanstieg wird um den Puffer reduziert (ein 4-Punkte-Puffer schluckt 4 eines 5-Punkte-Anstiegs). QUELLEN: jedes Stressanstiegs-Ereignis verbraucht EINEN Pufferpunkt unabhängig von der Höhe (ein 1-Quellen-Puffer schluckt einen ganzen Anstieg). Der Effekt bleibt ohne Timer bestehen, bis der Puffer aufgebraucht ist, und löscht sich dann selbst. Trage ihn auf Tränken, Vorteilen oder beliebigen Buffs ein.",
  "WITCHER.Effect.ActionStressShieldKind": "Schildart",
  "WITCHER.Effect.ActionStressShieldKindPoints": "Absorbiert N Stresspunkte",
  "WITCHER.Effect.ActionStressShieldKindSources": "Absorbiert N Stressquellen",
  "WITCHER.Effect.ActionStressShieldValue": "Wert",
  "WITCHER.Effect.ActionStressShieldValueHint": "Puffergröße, die beim Anwenden gewürfelt wird. Akzeptiert jede Roll-Formel — Würfel (1W6, 2W6, 3W6+1) oder eine feste Zahl (z. B. 3).",
  "WITCHER.Effect.ActionSuppress": "Einen Abzug unterdrücken",
  "WITCHER.Effect.ActionSuppressWhat": "Zu ignorierender Abzug",
  "WITCHER.Effect.ActionTempHp": "Temporäre TP gewähren (einmalig)",
