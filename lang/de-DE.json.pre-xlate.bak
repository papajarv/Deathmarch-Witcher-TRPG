  "WITCHER.Mech.CastRiders.Text.Promise": "Versprechen",
  "WITCHER.Mech.FoodAndDrink.BleakDiet.Description": "Dieses Essen hält dich am Leben. Aber es ist deprimierend. Du kannst so viele Trübkost-Stapel sammeln wie deine Willenskraft, dann erhältst du einen STRESS-Punkt. Iss oder trink Nahrung besserer Qualität, um dies zu senken.",
  "WITCHER.Mech.FoodAndDrink.Chat.FamishedDepth": "<div style=\"border-left:3px solid {color};padding:4px 8px\"><b>{name}</b> — {verb} (Sättigung jetzt <b>{satiety}</b>). <b>{sign}{delta} Stress</b>.</div>",
  "WITCHER.Mech.FoodAndDrink.Chat.FoodSpoiled": "<div style=\"border-left:3px solid #a83232;padding:4px 8px\"><b>{actor}</b> — food has spoiled:<ul style=\"margin:4px 0 0 14px;padding:0;\">{lines}</ul></div>",
  "WITCHER.Mech.FoodAndDrink.Chat.HungerStressNote": "Hunger Stress cannot be removed by meditation, WILL saves, therapy, or roleplay. Eat back UP through the satiety tier that granted it.",
  "WITCHER.Mech.FoodAndDrink.Chat.IntermediateTierPassed": "<b>{name}</b> · passed {list} · <b>{sign}{delta}</b> stress",
