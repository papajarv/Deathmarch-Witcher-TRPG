  "WITCHER.Weather.Config.Hint.tempOffset": "Wird zur Temperatur der umliegenden Region hinzugefügt.",
  "WITCHER.Weather.Config.Hint.tempSwing": "Wie viel heißer die Sommer und wie viel kälter die Winter werden.",
  "WITCHER.Weather.Config.HoursUnit": "Stunden",
  "WITCHER.Weather.Config.Landsites": "Landmarken",
  "WITCHER.Weather.Config.LatitudeSpan": "Nord-Süd-Temperaturspreizung",
  "WITCHER.Weather.Config.LatitudeSpanHint": "Wie viel kälter der Nordrand der Karte im Vergleich zum Süden ist, Kante zu Kante. 0 schaltet den Breitengrad-Gradienten aus.",
  "WITCHER.Weather.Config.Level1": "Beliebig (leicht oder schlechter)",
