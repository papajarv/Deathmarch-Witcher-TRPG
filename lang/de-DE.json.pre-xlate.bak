  "WITCHER.Mech.FumbleTable.Dialog.Button.MeleeDefenseArmed": "Nahkampfverteidigung (bewaffnet)",
  "WITCHER.Mech.FumbleTable.Dialog.Button.RangedAttack": "Fernkampfangriff",
