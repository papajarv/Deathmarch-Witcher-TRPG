  "WITCHER.Setup.SocketHook.Chat.GiftGave": "<div class=\"wdm-gift-card\"><i class=\"fa-solid fa-gift\"></i> <strong>{sender}</strong> gab <strong>{item}</strong> an <strong>{target}</strong>.</div>",
  "WITCHER.Setup.SocketHook.Chat.GiftGaveQty": "<div class=\"wdm-gift-card\"><i class=\"fa-solid fa-gift\"></i> <strong>{sender}</strong> gab <strong>{item}{qty}</strong> an <strong>{target}</strong>.</div>",
  "WITCHER.Setup.SocketHook.Chat.ShieldAbsorbs": "<div class=\"wdm-attack-rider\"><i class=\"fa-solid fa-shield-halved\"></i> <strong>{label}</strong> — {target}s aktiver Schild absorbiert den {status}-Effekt.</div>",
  "WITCHER.Setup.SocketHook.Chat.TookCoin": "<div class=\"wdm-gift-card\"><i class=\"fa-solid fa-coins\"></i> <strong>{sender}</strong> nahm <strong>{move} {coin}{plural}</strong> von <strong>{source}</strong>.</div>",
  "WITCHER.Setup.SocketHook.Chat.TookEverything": "<div class=\"wdm-gift-card\"><i class=\"fa-solid fa-hand-holding-dollar\"></i> <strong>{sender}</strong> nahm alles von <strong>{source}</strong>.</div>",
  "WITCHER.Setup.SocketHook.Dialog.Button.BodyBlock": "Körperblock",
  "WITCHER.Setup.SocketHook.Dialog.Button.Reposition": "Neu positionieren",
  "WITCHER.Setup.SocketHook.Dialog.Button.ResistMagic": "Magie widerstehen",
  "WITCHER.Setup.SocketHook.Notify.GiftFailedOnXInternalId": "Geschenk an {target} fehlgeschlagen: interne ID fehlt beim neuen Gegenstand (siehe Konsole).",
  "WITCHER.Setup.SocketHook.Notify.GiftFailedOnXXSee": "Geschenk an {target} fehlgeschlagen: {val0} (siehe Konsole).",
  "WITCHER.Setup.SocketHook.Notify.GiftLinkContentsFailed": "Geschenk an {target}: '{item}' konnte Inhalte nicht verknüpfen (siehe Konsole).",
  "WITCHER.Setup.SocketHook.Notify.GiftPartialCreated": "Geschenk teilweise erstellt {created}/{total} Gegenstände auf {target} — Abbruch, damit die Kopie des Gebers nicht verloren geht.",
  "WITCHER.Setup.SocketHook.Notify.GiftWrongContents": "Geschenk an {target}: '{item}' mit falschen Inhalten gespeichert (siehe Konsole).",
  "WITCHER.Setup.SocketHook.Text.AppliedTo": "Angewendet auf",
  "WITCHER.Setup.SocketHook.Text.CastShield": "Schild wirken",
  "WITCHER.Setup.SocketHook.Text.CoinPlural": "s",
  "WITCHER.Setup.SocketHook.Text.MagicShieldStoppedCrit": "{shield} stoppte die kritische Wunde",
  "WITCHER.Setup.StatusClauses.Dialog.Button.PurgeOverdose": "Überdosis ausleiten",
  "WITCHER.Setup.StatusClauses.Dialog.Button.PutOutFire": "Feuer löschen",
  "WITCHER.Setup.StatusClauses.Dialog.Button.Stand": "Stehen bleiben",
  "WITCHER.Setup.StatusClauses.Dialog.Button.WashOffAcid": "Säure abwaschen",
  "WITCHER.Setup.StatusClauses.acid.Description": "4 Schaden zu Beginn jedes Zuges — frisst durch Rüstung (ignoriert SP). Eine Aktion aufwenden, um sie abzuwaschen, oder der Quelle entkommen.",
  "WITCHER.Setup.StatusClauses.aim.Description": "Zielen N: Eine Volle-Runden-Aktion gewährt +1 auf deinen nächsten Fernkampfangriff, stapelbar bis +3 über aufeinanderfolgende Runden. Automatisch angewendet und beim Feuern gelöscht.",
  "WITCHER.Setup.StatusClauses.bleed.Description": "2 Schaden zu Beginn jedes Zuges — Rüstung absorbiert ihn NICHT. Ein Heilungszauber oder eine SG-15-Erste-Hilfe-Probe (1 Aktion) stoppt es.",
  "WITCHER.Setup.StatusClauses.blinded.Description": "−3 auf alle Angriffs- und Verteidigungswürfe, −5 auf sichtbasierte Wahrnehmung. Eine Aktion aufwenden, um die Augen zu klären.",
  "WITCHER.Setup.StatusClauses.burning.Description": "5 Schaden an jede Körperzone pro Zug (Rüstung absorbiert den Treffer) und die Flammen fressen 1 SP von der Rüstung jeder Zone. Eine Aktion aufwenden, um es zu löschen (Wasser gießen / stopp-fall-roll).",
  "WITCHER.Setup.StatusClauses.charging.Description": "Stürmt an — der nächste Angriff ist auf Starker Schlag festgelegt (RAW: -3 auf Treffer, ×2 Schaden). Wird der Angriff geblockt, würfle Physis vs. Physis des Verteidigers, um ihn zu Boden zu werfen.",
  "WITCHER.Setup.StatusClauses.dead.Description": "Erschlagen.",
  "WITCHER.Setup.StatusClauses.diseased.Description": "−2 auf jede Aktion und die maximale Ausdauer um ein Viertel gekürzt, solange krank. Regelmäßige Widerstandsfähigkeits-Proben halten Übelkeit fern. Nur die Behandlung eines Arztes (Heilende-Hände-Probe) plus eine volle Nachtruhe beseitigt es.",
  "WITCHER.Setup.StatusClauses.drunk-3.StressNote": " Loosens the chest: clears 1 STRESS on apply.",
  "WITCHER.Setup.StatusClauses.drunk-4.StressNote": " Clears 1 STRESS on apply.",
  "WITCHER.Setup.StatusClauses.drunk-5.StressNote": " Clears 1 STRESS on apply.",
  "WITCHER.Setup.StatusClauses.drunk-6.StressNote": " Clears 1 STRESS on apply.",
  "WITCHER.Setup.StatusClauses.entangled.Description": "Umschlungen: −5 GES und −2 auf alle körperlichen Aktionen. In deinem Zug bricht eine SG-18-Ausweichen/Flucht- oder Verrenker-Probe frei; ein Verbündeter kann eine Aktion aufwenden, um es zu entfernen.",
  "WITCHER.Setup.StatusClauses.exhausted.Description": "−1 auf jeden Wurf, bis du ruhst.",
  "WITCHER.Setup.StatusClauses.famished-1.Description": "Very Hungry — −12.5% max STA.",
  "WITCHER.Setup.StatusClauses.famished-1.StressNote": " +1 Hunger Stress from this depth — only cleared by eating.",
  "WITCHER.Setup.StatusClauses.famished-2.Description": "Weakening — −25% max STA.",
  "WITCHER.Setup.StatusClauses.famished-2.StressNote": " +2 Hunger Stress from this depth — only cleared by eating.",
  "WITCHER.Setup.StatusClauses.famished-3.Description": "Famished — −37.5% max STA, −1 all rolls.",
  "WITCHER.Setup.StatusClauses.famished-3.StressNote": " +3 Hunger Stress from this depth — only cleared by eating.",
  "WITCHER.Setup.StatusClauses.famished-4.Description": "Starving — −50% max STA, −2 all rolls. Collapse below −MAX.",
  "WITCHER.Setup.StatusClauses.famished-4.StressNote": " +4 Hunger Stress from this depth — only cleared by eating.",
  "WITCHER.Setup.StatusClauses.famished.Description": "Ausgehungert — am Verhungern. Max. AUS um zwei Fünftel reduziert, −1 auf jeden Wurf.",
  "WITCHER.Setup.StatusClauses.famished.StressNote": " Hunger Stress is granted by the hunger cascade.",
  "WITCHER.Setup.StatusClauses.fastDraw.Description": "Du hast eine Waffe schnappgezogen und MUSST in diesem Zug einen Angriff damit machen (RAW Kern S. 165). Wirf mit +3 in die Initiative und nimm −3 auf diesen Angriff. Endet der Zug ohne Angriff, ist das Schnappziehen verschwendet",
  "WITCHER.Setup.StatusClauses.fed.Description": "Satt — angenehm. Kein mechanischer Effekt.",
  "WITCHER.Setup.StatusClauses.freeze.Description": "−3 GES und −1 REF. Eine SG 16 Physis-Probe (1 Aktion) bricht das Eis.",
  "WITCHER.Setup.StatusClauses.full.Description": "Voll — gut genährt. Kein mechanischer Effekt.",
  "WITCHER.Setup.StatusClauses.gorged.Description": "Vollgefressen — übervoll. −1 REF, −1 DEX (träge). Der volle Magen treibt die tägliche Erholung — zählt als +2 REC für Heilzwecke (dein angezeigter REC-Wert bleibt unverändert).",
  "WITCHER.Setup.StatusClauses.gorged.StressNote": " The heavy meal clears 2 STRESS on apply.",
  "WITCHER.Setup.StatusClauses.grappled.Description": "In einem Griff gehalten: −2 auf alle körperlichen Aktionen und du kannst dich nicht wegbewegen. Nutze die Flucht-Aktion (Ausweichen/Flucht vs. Raufen des Ringkämpfers), um dich zu befreien. Wenn nicht auch festgehalten oder gewürgt, kannst du den Griff umkehren",
  "WITCHER.Setup.StatusClauses.hallucinating.Description": "SL-gesteuerte falsche Sinneseindrücke. Eine SG-15-Deduktionsprobe erkennt jede Illusion für das, was sie ist.",
  "WITCHER.Setup.StatusClauses.hangover.Description": "Kater — die Rechnung für letzte Nacht. Dein Kopf hämmert, dein Magen ist ein Knoten, und jeder REC-Wurf fühlt sich an wie das Herausklettern aus einem Brunnen. Schlaf es in den nächsten Tagen aus.",
  "WITCHER.Setup.StatusClauses.hungry.Description": "Hungrig — nur noch auf Reserve. Max. AUS um ein Fünftel reduziert.",
  "WITCHER.Setup.StatusClauses.hungry.StressNote": " +1 Hunger Stress on descent — only cleared by eating back past Peckish.",
  "WITCHER.Setup.StatusClauses.intoxicated.Description": "−2 REF / DEX / INT und −3 auf Verbalen Kampf; 25%ige Chance, dass du nicht erinnerst, was du getan hast.",
  "WITCHER.Setup.StatusClauses.isChoking.Description": "Wendet einen Würgegriff an: Das Ziel erhält jeden Zug, in dem du ihn aufrechterhältst, 3 + deinen Nahkampf-Schadensbonus als Erstickungsschaden. (Nur CE.)",
  "WITCHER.Setup.StatusClauses.isGrappling.Description": "Ringt mit jemandem: Du kannst dich nicht wegbewegen, ohne den Griff zu lösen. Unter Kampf erweitert erhältst du außerdem −2 auf alle körperlichen Aktionen außer gegen den/die Akteure, die du hältst.",
  "WITCHER.Setup.StatusClauses.isMounted.Description": "Reitet auf einem größeren Feind: Du kannst dich nicht selbstständig bewegen — du bewegst dich, wohin sie sich bewegen. Du bist in ihrem blinden Fleck; sie müssen eine Bewegung + Raufen-Probe gegen dein Reiten aufwenden, um dich anzugreifen. (Nur CE.)",
  "WITCHER.Setup.StatusClauses.isPinning.Description": "Hält jemanden fest: −3 auf alle körperlichen Aktionen außer gegen den festgehaltenen Feind; du kannst dich nicht wegbewegen, bis du das Festhalten löst. (Nur CE.)",
  "WITCHER.Setup.StatusClauses.mounted.Description": "Ein Reiter klammert sich an deinen Rücken — er ist in deinem blinden Fleck. Um ihn anzugreifen, musst du eine Bewegung aufwenden und seine Reiten-Probe mit Raufen schlagen. (Nur CE.)",
  "WITCHER.Setup.StatusClauses.nausea.Description": "Alle 3 Runden unter BOD würfeln, sonst verbringst du die Runde erbrechend und würgend.",
  "WITCHER.Setup.StatusClauses.overdosed.Description": "Toxizität über der Obergrenze (Kern S. 248): 3 Schaden zu Beginn jedes Zuges — Rüstung absorbiert ihn NICHT. Er hebt sich, sobald deine Toxizität wieder auf deine Obergrenze fällt. Du kannst auch das Aktionsmenü nutzen (1 Aktion",
  "WITCHER.Setup.StatusClauses.paralyzed.Description": "Kann weder handeln noch verteidigen; ein hilfloses Ziel wird ab 10+ getroffen.",
  "WITCHER.Setup.StatusClauses.peckish.Description": "Ein wenig hungrig — wird hungrig. Noch kein mechanischer Effekt, aber Hungrig ist einen Tick entfernt.",
  "WITCHER.Setup.StatusClauses.pinned.Description": "Festgehalten nach erfolgreichem Griff: bewegungsunfähig — du kannst dich weder bewegen noch handeln. Angriffe gegen dich treffen ab 10+. Fluchtwurf mit Ausweichen/Flucht gegen Raufen des Ringkämpfers.",
  "WITCHER.Setup.StatusClauses.poisoned.Description": "3 Schaden zu Beginn jedes Zuges — Rüstung absorbiert ihn NICHT. Eine SG-15-Widerstandsfähigkeitsprobe (1 Aktion) beendet es.",
  "WITCHER.Setup.StatusClauses.prone.Description": "Zu Boden geworfen: −2 auf Angriff und Verteidigung, bis du eine Aktion aufwendest, um aufzustehen.",
  "WITCHER.Setup.StatusClauses.restrained.Description": "Bewegung ist blockiert. Befreie dich mit einer Athletik- oder Raufen-Probe.",
  "WITCHER.Setup.StatusClauses.restrictedVision.Description": "Sicht eingeschränkt (Visier heruntergeklappt oder Schild bedeckt den Kopf): −2 auf Blocken, Parieren und Ausweichen bis zu deinem nächsten Zug oder bis das Hindernis entfernt wird.",
  "WITCHER.Setup.StatusClauses.staggered.Description": "−2 auf Angriff und Verteidigung; erholt sich automatisch zu Beginn deines nächsten Zuges.",
  "WITCHER.Setup.StatusClauses.stunned.Description": "Du kannst keine Aktionen ausführen und kannst dich nicht verteidigen; Angriffe treffen ab 10+. Zu Beginn deines Zuges legst du einen Betäubungswurf ab, um es zu beenden — auch wenn du im Betäubtsein getroffen wirst, reißt es dich heraus.",
  "WITCHER.Setup.StatusClauses.suffocation.Description": "3 Schaden zu Beginn jedes Zuges — Rüstung absorbiert ihn NICHT. Endet in dem Moment, in dem Luft wieder verfügbar ist (Auftauchen, Entkommen aus einem Würgegriff).",
  "WITCHER.Setup.StatusClauses.unconscious.Description": "Ausgeknockt: wie betäubt behandelt — keine Aktionen, keine Verteidigung, automatischer Treffer. Wacht bei 20+ AUS mit bestandenem Betäubungswurf auf.",
  "WITCHER.Setup.StatusClauses.yrden.Description": "Gefangen im Yrden-Kreis — REF- und GES-Malus skalieren mit der AUS, die der Zauberer in das Zeichen investierte (Errata: -1 bei 1 AUS, -2 bei 3 AUS, -3 bei 5 AUS, -4 bei 7 AUS).",
  "WITCHER.Setup.StatusEffects.Dialog.Button.AimX": "Zielen {n}",
