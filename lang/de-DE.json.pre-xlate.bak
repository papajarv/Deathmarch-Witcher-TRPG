  "WITCHER.App.EffectTargetPicker.Text.SearchParameters": "Suchparameter…",
  "WITCHER.App.FoodAndDrinkConfig.Blurb.DrunkTier": "Standardwerte pro Stufe, auf die der Alkohol-Ausdauerwurf zurückgreift. Stufen VI–VIII können den Träger bewusstlos schlagen; VII–VIII enthalten eine Todeschance in Prozent bei K.o. Die Statusänderungen und Beschreibungen pro Stufe befinden sich in",
  "WITCHER.App.FoodAndDrinkConfig.Blurb.HungerTier": "Mindestsättigungswert, ab dem die Stufe greift (von oben nach unten lesen). Ausgezehrt hat keinen Mindestwert — alles unterhalb von Hungrig landet dort. Bereich −100 bis 125.",
  "WITCHER.App.FoodAndDrinkConfig.Blurb.Intro": "Numerische Stellschrauben für die Nahrungs- &amp; Getränke-Homebrew. Änderungen erfordern ein Neuladen der Welt (die Abfrage erscheint beim Speichern). Die Standardwerte entsprechen der Originalvorgabe — durch Leeren eines Feldes wird beim Speichern der Standardwert wiederhergestellt.",
  "WITCHER.App.FoodAndDrinkConfig.Blurb.SatietyDecay": "How fast a character gets hungry. Every hour they lose (base) + (their BODY divided by the divisor, rounded up) satiety points. The default gives a BODY 7 character 3 satiety lost per hour, so their pool of 72 empties in a day. Combat hunger scales with body size so a huge warrior and a small scholar lose the same PROPORTION of their pool per Stamina spent.",
  "WITCHER.App.FoodAndDrinkConfig.Chat.SpoilageNotifications": "Announce in chat when food goes bad",
  "WITCHER.App.FoodAndDrinkConfig.Dialog.Button.Fed": "Gesättigt",
  "WITCHER.App.FoodAndDrinkConfig.Dialog.Button.Full": "Voll",
  "WITCHER.App.FoodAndDrinkConfig.Dialog.Button.Gorged": "Übersättigt",
  "WITCHER.App.FoodAndDrinkConfig.Dialog.Button.Hungry": "Hungrig",
  "WITCHER.App.FoodAndDrinkConfig.Dialog.Button.Peckish": "Angeknabbert",
  "WITCHER.App.FoodAndDrinkConfig.Hint.CombatSatietyPctPerSta": "How much of the character's satiety pool burns per point of Stamina spent in combat. 0.0025 = 0.25% — a typical character loses about 0.25 satiety per Stamina. Any legacy value above 0.1 is auto-reset to this default (old versions used absolute satiety, new version uses % of pool).",
  "WITCHER.App.FoodAndDrinkConfig.Section.Chat": "Chat announcements",
  "WITCHER.App.FoodAndDrinkConfig.Section.ChatHint": "Choose which food events send a message to the chat log. Turning these off doesn't change the game — food still spoils, characters still get sick — you just won't get an announcement when it happens.",
  "WITCHER.App.FoodAndDrinkConfig.Text.BaseHour": "Basis / Stunde",
  "WITCHER.App.FoodAndDrinkConfig.Text.BodyDivisor": "KÖR-Teiler",
  "WITCHER.App.FoodAndDrinkConfig.Text.CombatSatietyPctPerSta": "Combat drain (fraction of pool per Stamina)",
  "WITCHER.App.FoodAndDrinkConfig.Text.Death": "Tod %",
  "WITCHER.App.FoodAndDrinkConfig.Text.DefaultDc": "Standard-SG",
  "WITCHER.App.FoodAndDrinkConfig.Text.DrunkTierMetadata": "Betrunkenheitsstufen-Metadaten",
  "WITCHER.App.FoodAndDrinkConfig.Text.Famished": "Ausgezehrt",
  "WITCHER.App.FoodAndDrinkConfig.Text.FoodDrinkConfiguration": "Nahrung & Getränke-Konfiguration",
  "WITCHER.App.FoodAndDrinkConfig.Text.HungerTierThresholds": "Hungerstufen-Schwellenwerte",
  "WITCHER.App.FoodAndDrinkConfig.Text.LevelJump": "Stufensprung",
  "WITCHER.App.FoodAndDrinkConfig.Text.SatietyDecay": "Sättigungsabbau",
  "WITCHER.App.FoodAndDrinkConfig.Text.SatietyPerStaSpentCombat": "Sättigung pro ausgegebener STA (Kampf)",
  "WITCHER.App.FoodAndDrinkConfig.Text.StatusEffectsEditStatusEffects": "Statuseffekte → Statuseffekte bearbeiten",
  "WITCHER.App.FoodAndDrinkConfig.Text.Tier": "Stufe",
  "WITCHER.App.FoodAndDrinkConfig.Text.UnconsciousDc": "Bewusstlos-SG",
  "WITCHER.App.GuardConfig.Text.AutoAppliedAtTheStartOfEveryCombat": "Wird automatisch zu Beginn jedes Kampfes angewendet.",
  "WITCHER.App.GuardConfig.Text.ChangePreferredGuard": "Bevorzugte Haltung ändern",
  "WITCHER.App.GuardConfig.Text.CurrentGuardCanOnlyBeChangedInCombatOutO": "Die aktuelle Kampfhaltung lässt sich nur im Kampf ändern — außerhalb des Kampfes wird sie beim nächsten Gefecht auf deine bevorzugte zurückgesetzt.",
  "WITCHER.App.GuardConfig.Text.WardingLocations": "Geschützte Trefferzonen (pro ausgerüsteter Waffe)",
  "WITCHER.App.HomebrewContentEditor.Blurb": "Aktiviere oder deaktiviere die mitgelieferten Homebrew-Subsysteme. Anpassungen von Hausregeln findest du in der Haupteinstellungsliste; hier geht es um zusätzliche Inhalte. Das Schema wird nie entfernt, daher ist das erneute Einschalten eines Systems nicht zerstörend. Änderungen fordern einen Neuladen an.",
  "WITCHER.App.HomebrewContentEditor.Text.HomebrewContent": "Homebrew-Inhalte",
  "WITCHER.App.HouseRulesConfig.Blurb": "Globale Stellschrauben für Kampfmechaniken, die RAW hart einprogrammiert. Pro-Aktor-Überschreibungen via Aktive Effekte liegen weiterhin obendrauf — diese Werte setzen die weltweite Grundlinie. Die Verbraucher lesen live, sodass die meisten Änderungen bei der nächsten Probe wirksam werden, ohne die Welt neu zu laden.",
  "WITCHER.App.HouseRulesConfig.ResetConfirmBody": "Alle Hausregel-Überschreibungen verwerfen und die ausgelieferten Standardwerte wiederherstellen? Wirksam beim Speichern.",
  "WITCHER.App.HouseRulesConfig.ResetConfirmTitle": "Hausregeln zurücksetzen?",
  "WITCHER.App.HouseRulesConfig.ResetToDefaults": "Auf Standard zurücksetzen",
  "WITCHER.App.HouseRulesConfig.Save": "Speichern",
  "WITCHER.App.HouseRulesConfig.Saved": "Hausregeln gespeichert.",
  "WITCHER.App.HouseRulesConfig.Section.ActionEconomy": "Aktionsökonomie",
  "WITCHER.App.HouseRulesConfig.Section.AlchemyToxicity": "Alchemie & Toxizität",
  "WITCHER.App.HouseRulesConfig.Section.CritWounds": "Kritische Wunden",
  "WITCHER.App.HouseRulesConfig.Section.DiceRules": "Würfelregeln",
  "WITCHER.App.HouseRulesConfig.Section.Movement": "Bewegung",
  "WITCHER.App.HouseRulesConfig.Section.Strikes": "Schlag-Beschränkungen",
  "WITCHER.App.HouseRulesConfig.Section.WeaponsDamage": "Waffen & Schaden",
  "WITCHER.App.HouseRulesConfig.Text.BowsNoStrongDesc": "Entfernt die Option Starker Schlag aus dem Angriffsdialog für Waffen vom Typ Bogen. Armbrüste und Wurfwaffen werden bereits vom ausgelieferten Code blockiert; diese Option ordnet Bögen derselben Kategorie zu.",
  "WITCHER.App.HouseRulesConfig.Text.BowsNoStrongName": "Bögen können keine Starken Schläge ausführen",
  "WITCHER.App.HouseRulesConfig.Text.CritBonusBlurb": "Fester Bonusschaden, der zusätzlich zum Schadenswurf der Waffe für jede Schwere einer kritischen Wunde addiert wird. RAW: normale Ziele 3 / 5 / 8 / 10; Elementar- & Spektralziele (organimmun) 5 / 10 / 15 / 20. Null deaktiviert den Bonus dieser Stufe.",
  "WITCHER.App.HouseRulesConfig.Text.CritBonusComplex": "Bonus Komplex",
  "WITCHER.App.HouseRulesConfig.Text.CritBonusDeadly": "Bonus Tödlich",
  "WITCHER.App.HouseRulesConfig.Text.CritBonusDifficult": "Bonus Schwierig",
  "WITCHER.App.HouseRulesConfig.Text.CritBonusNeedsSpBreakDesc": "Wenn EIN, wird der Bonusschaden eines kritischen Treffers ebenfalls unterdrückt, wenn der Grundschaden der Waffe die Aufhaltekraft des Ziels an der Trefferstelle nicht durchbrechen konnte. RAW-Standard: Der Bonusschaden des Kritischen umgeht die Rüstung und trifft unabhängig davon. Hausregel: Wenn der Schlag selbst vollständig von der Rüstung abgefangen wurde, wird auch der „Nachschlag\" des Kritischen abgefangen.",
  "WITCHER.App.HouseRulesConfig.Text.CritBonusNeedsSpBreakName": "Bonusschaden des Kritischen erfordert Durchbruch der SP",
  "WITCHER.App.HouseRulesConfig.Text.CritBonusNoOrgansHeading": "Organimmune Ziele (Elementare, Spektren)",
  "WITCHER.App.HouseRulesConfig.Text.CritBonusNormalHeading": "Normale Ziele",
  "WITCHER.App.HouseRulesConfig.Text.CritBonusSimple": "Bonus Einfach",
  "WITCHER.App.HouseRulesConfig.Text.CritBracketComplex": "Komplex (übertreffen um)",
  "WITCHER.App.HouseRulesConfig.Text.CritBracketDeadly": "Tödlich (übertreffen um)",
  "WITCHER.App.HouseRulesConfig.Text.CritBracketDifficult": "Schwierig (übertreffen um)",
  "WITCHER.App.HouseRulesConfig.Text.CritBracketSimple": "Einfach (übertreffen um)",
  "WITCHER.App.HouseRulesConfig.Text.CritBracketsBlurb": "Angriff-gegen-Verteidigung-Differenz, die zum Erzielen jeder Schwere einer kritischen Wunde erforderlich ist. RAW: 7 / 10 / 13 / 15. Werte werden beim Speichern automatisch sortiert, sodass stets einfach < komplex < schwierig < tödlich gilt.",
  "WITCHER.App.HouseRulesConfig.Text.CritSpDowngradeDesc": "Wenn der eingehende Schaden die Aufhaltekraft des Ziels an der Trefferstelle nicht durchbrochen hat, wird die gewürfelte Schwere der kritischen Wunde herabgestuft. Aus = RAW-Verhalten. Schwerer→Leichter = Schwierige/Tödliche Wunden fallen eine Stufe. Jeder→Einfach = jeder Krit, der nicht durchdringt, landet als Einfach, unabhängig von der gewürfelten Stufe.",
  "WITCHER.App.HouseRulesConfig.Text.CritSpDowngradeMode": "Kritische Wunde herabstufen, wenn Schaden SP nicht durchdringt",
  "WITCHER.App.HouseRulesConfig.Text.CritSpModeAnyToSimple": "Jeden auf Einfach herabstufen",
  "WITCHER.App.HouseRulesConfig.Text.CritSpModeGreaterToLesser": "Schwereren auf Leichteren herabstufen",
  "WITCHER.App.HouseRulesConfig.Text.CritSpModeOff": "Aus (RAW)",
  "WITCHER.App.HouseRulesConfig.Text.D10CollapseDesc": "Wenn EIN (RAW-Standard), löst eine natürliche 1 die Patzer-Tabelle aus UND würfelt eine weitere W10, die vom Gesamtwert abgezogen wird, mit Verkettung bei weiteren 10ern. Wenn AUS, löst eine natürliche 1 weiterhin die Patzer-Tabelle aus, aber der Abzugswürfel wird übersprungen — keine zusätzliche negative Kette.",
  "WITCHER.App.HouseRulesConfig.Text.D10CollapseName": "W10-Würfe kollabieren bei einer natürlichen 1 (bad day)",
  "WITCHER.App.HouseRulesConfig.Text.D10ExplodeDesc": "Wenn EIN (RAW-Standard), löst eine natürliche 10 bei jedem Fertigkeits- / Probe- / Angriffswurf eine weitere W10 aus, die zum Gesamtwert hinzugefügt wird und sich bei weiteren 10ern wiederholt. Wenn AUS, ist eine 10 einfach nur eine 10 — keine Bonus-Kette.",
  "WITCHER.App.HouseRulesConfig.Text.D10ExplodeName": "W10-Würfe explodieren bei einer natürlichen 10 (kickass)",
  "WITCHER.App.HouseRulesConfig.Text.ExtraActionStaCost": "STA-Kosten für Zusatzaktion",
  "WITCHER.App.HouseRulesConfig.Text.ExtraActionStaCostDesc": "Fester STA-Abzug bei der Rundenabrechnung, wenn eine Zusatzaktion auslöst (RAW: 3).",
  "WITCHER.App.HouseRulesConfig.Text.ExtraActionToHit": "Trefferabzug für Zusatzaktion",
  "WITCHER.App.HouseRulesConfig.Text.ExtraActionToHitDesc": "Trefferabzug für jeden als Zusatzaktion markierten Schuss — zweiter Schuss eines Schnellen Angriffs, zweiter Verbundener Schuss, Zauberaktion nach Waffenaktion usw. (RAW: -3.)",
  "WITCHER.App.HouseRulesConfig.Text.ExtraDefenseStaCost": "STA-Kosten für Zusatzverteidigung (pro Verteidigung nach der ersten)",
  "WITCHER.App.HouseRulesConfig.Text.ExtraDefenseStaCostDesc": "Kumulativer STA-Abzug pro Verteidigung nach der ersten kostenlosen der Runde (RAW: 1). Auf 0 setzen, um die kumulativen Kosten vollständig zu deaktivieren.",
  "WITCHER.App.HouseRulesConfig.Text.NewSilverRulesDesc": "R. Talsorian-Regelupdate vom 7.11.25. AN: Waffen erhalten eine Checkbox \"Silber-Waffenmerkmal\" — Waffen mit dem Merkmal verursachen vollen Schaden gegen silber-anfällige Monster und die Hälfte gegen alle anderen. Das legacy Waffenmerkmal \"Silber\" wird ausgeblendet und deaktiviert (kein isSilver-Stempel, kein separater Silber-Schadenswurf). AUS: Das Merkmal ist inaktiv (verstecktes UI, keine Wirkung) und die legacy Silber-Qualität verhält sich wie immer.",
  "WITCHER.App.HouseRulesConfig.Text.NewSilverRulesName": "Neue Silber-Regeln (RTG 7/11/25)",
  "WITCHER.App.HouseRulesConfig.Text.OffhandPenalty": "Abzug für Angriff mit Zweithand",
  "WITCHER.App.HouseRulesConfig.Text.OffhandPenaltyDesc": "Basisabzug für Waffenangriffe mit der Zweithand (RAW: -3). Gilt für den zweiten Schuss eines Verbundenen Angriffs, beidhändige Wechsel und jede als Zweithand markierte Waffe. Pro-Aktor-Reduktionen liegen weiterhin obendrauf.",
  "WITCHER.App.HouseRulesConfig.Text.RawToxicityDesc": "Wenn EIN (RAW, Kern S. 248), verursacht die kombinierte Trank- / Absud-Toxizität über deiner Obergrenze den Überdosiert-Zustand — ein giftartiger DoT, der anhält, bis die Toxizität wieder auf die Obergrenze fällt oder eine SG-18-Widerstandsfähigkeitsprobe den letzten Trank ausspült. Wenn AUS, wird die Toxizität weiterhin auf dem Bogen mitgeführt, schadet dir jedoch nie.",
  "WITCHER.App.HouseRulesConfig.Text.RawToxicityName": "RAW-Toxizitäts-Überdosis",
  "WITCHER.App.HouseRulesConfig.Text.SplitMovementDesc": "Wenn EIN, kann die Bewegung über den Zug verteilt und mit Aktionen bis zur Gesamt-GES verwoben werden. Wenn AUS (RAW), muss die gesamte Bewegung vor jeder Aktion erfolgen — sobald gehandelt wird, verfällt die restliche Bewegung der Runde.",
  "WITCHER.App.HouseRulesConfig.Text.SplitMovementName": "Bewegung über Aktionen verteilen",
  "WITCHER.App.HouseRulesConfig.Text.StrongStrikePenalty": "Trefferabzug für Starken Schlag",
  "WITCHER.App.HouseRulesConfig.Text.StrongStrikePenaltyDesc": "Basisabzug auf Angriffswürfe des Starken Schlags (RAW: -3). Pro-Aktor-Reduktionen (Vorteile / Talente) liegen weiterhin obendrauf.",
  "WITCHER.App.HouseRulesConfig.Title": "Hausregeln",
  "WITCHER.App.OpenCategoryConfigDialog.Label.DamageDice": "Schadenswürfel",
  "WITCHER.App.OpenCategoryConfigDialog.Label.WA": "WA",
  "WITCHER.App.OpenCategoryConfigDialog.Text.FilterQualities": "Qualitäten filtern…",
  "WITCHER.App.OpenCategoryConfigDialog.Text.FlatBonuses": "Feste Boni",
