  "WITCHER.App.QualitiesEditor.Dialog.Button.CountsAsSilverVsMonsterResists": "Zählt als Silber (gegen Monsterresistenzen)",
  "WITCHER.App.QualitiesEditor.Dialog.Button.DoubleAblationDoublesTheStandardChip": "Doppelte Absplitterung (verdoppelt den Standard-Chip auf −2 SP, z. B. Wuchtwaffen)",
  "WITCHER.App.QualitiesEditor.Dialog.Button.ImprovedAPNegatesDRHalvesSP": "Verbesserter Rüstungsbrecher (hebt SR auf + halbiert SP)",
