  "WITCHER.App.RaiseShieldDialog.Text.Reset": "Zurücksetzen",
  "WITCHER.App.RaiseShieldDialog.Text.ThisShieldHasACoverValueOf0SetItsCVOnThe": "Dieser Schild hat einen Deckungswert von 0. Setze seinen DW im Item-Sheet des Schildes (Combat Extended).",
  "WITCHER.App.RingPortraitCropper.Blurb": "Ziehe das Bild zum Schwenken, verwende Mausrad oder Regler zum Zoomen. Der schattierte Bereich außerhalb des gestrichelten Kreises wird beim Anwenden transparent, sodass Foundrys Ring rundherum sichtbar wird.",
  "WITCHER.App.RingPortraitCropper.Button.ApplyCrop": "Zuschnitt anwenden",
  "WITCHER.App.RingPortraitCropper.Button.Reset": "Zurücksetzen",
  "WITCHER.App.RingPortraitCropper.Text.NoPortraitSetOnThisActor": "Für diesen Akteur ist kein Porträt festgelegt.",
  "WITCHER.App.RingPortraitCropper.Text.Zoom": "Zoom",
  "WITCHER.App.SpecialActionSlotPicker.Dialog.Body": "<div style=\"padding:6px 2px;display:flex;flex-direction:column;gap:6px;\"><div>{intro} <strong>{label}</strong>?</div>{hints}</div>",
  "WITCHER.App.SpecialActionSlotPicker.Dialog.Button.UseAction": "Handlung nutzen",
  "WITCHER.App.SpecialActionSlotPicker.Dialog.Button.UseExtraActionXSTA": "Zusatzhandlung nutzen ({extraStaCost} STA)",
  "WITCHER.App.SpecialActionSlotPicker.Dialog.Button.UseMovement": "Bewegung nutzen",
  "WITCHER.App.SpecialActionSlotPicker.Dialog.Hint.UseAction": "Gib deine einzige Handlung in diesem Zug aus. Kostet keine STA.",
  "WITCHER.App.SpecialActionSlotPicker.Dialog.Hint.UseMovement": "Gib deine Bewegungshandlung des Zuges aus (es wird keine tatsächliche Bewegung ausgeführt). Kostet keine STA.",
  "WITCHER.App.SpecialActionSlotPicker.Dialog.Title": "{label} — Slot wählen",
  "WITCHER.App.SpecialActionSlotPicker.Text.SpecialAction": "Sonderhandlung",
  "WITCHER.App.SpecialActionSlotPicker.Text.WhichResourceDoYouWantToSpendFor": "Welche Ressource möchtest du ausgeben für",
  "WITCHER.App.StatusEffectsEditor.Aria.RimColorPicker": "Randfarbe wählen",
  "WITCHER.App.StatusEffectsEditor.Blurb": "Passe die Kampfstatus an. Jede Karte bearbeitet einen Status: Name, Symbol, Beschreibung und die vollständige RAW-Klausel — Attributs- und Wurfmodifikatoren, Schaden über Zeit, Handlungs- und Verteidigungssperren, den Auto-Treffer-SG, die Endprobe, Auto-Löschung und periodische Würfe. Unangetastete Status behalten die eingebauten Standardwerte. Beim Speichern wird die Welt neu geladen.",
  "WITCHER.App.StatusEffectsEditor.Button.AddStatus": "Status hinzufügen",
  "WITCHER.App.StatusEffectsEditor.Button.RestoreRAWDefaults": "RAW-Standards wiederherstellen",
  "WITCHER.App.StatusEffectsEditor.Dialog.Button.AllRolls": "Alle Würfe",
  "WITCHER.App.StatusEffectsEditor.Dialog.Button.Attack": "Angriff",
  "WITCHER.App.StatusEffectsEditor.Dialog.Button.AwarenessSight": "Wahrnehmung (Sicht)",
