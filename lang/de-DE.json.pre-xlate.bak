  "WITCHER.Chrome.Dissect.Text.DerivedLine": "Abgeleitet · {label}: {value}",
  "WITCHER.Chrome.Dissect.Text.Dissecting": "Seziere <b>{name}</b> — Schwierigkeit <b>{diff}</b> (SG <b>{dc}</b>).",
  "WITCHER.Chrome.Dissect.Text.DissectingWithComplexity": "Seziere <b>{name}</b> — Schwierigkeit <b>{diff}</b> · Komplexität <b>{complex}</b>{bonus} (SG <b>{dc}</b>).",
  "WITCHER.Chrome.Dissect.Text.Fail": "Fehlschlag",
  "WITCHER.Chrome.Dissect.Text.FasterEvery2": "(schneller — alle <b>2</b> über SG = +1 Treffer)",
  "WITCHER.Chrome.Dissect.Text.HowAutopsyBody": "Wähle die Umgebung, in der die Sektion durchgeführt wird (sie gibt einen festen Bonus auf deinen Wurf), und klicke dann unten auf eine der Kategorie-Schaltflächen. Hat die Kategorie mehr als eine Fertigkeit, lässt dich ein zweiter Dialog wählen, welche du würfeln möchtest. Erreiche den SG für <b>1 Treffer</b>. Jeder zusätzliche <b>Teiler</b>-Wert über dem SG = <b>+1 Treffer</b>. Jeder Treffer enthüllt eine zufällige unbekannte Information aus dem Bestiarium dieses Charakters; bereits bekannte Informationen werden neu gewürfelt, bis etwas Neues auftaucht, und zusätzliche Treffer verpuffen, sobald die Kategorie vollständig bekannt ist.",
  "WITCHER.Chrome.Dissect.Text.HowAutopsyWorks": "So funktioniert die Sektion.",
  "WITCHER.Chrome.Dissect.Text.LeastEfficient": "(am wenigsten effizient)",
  "WITCHER.Chrome.Dissect.Text.MostEfficient": "(am effizientesten)",
  "WITCHER.Chrome.Dissect.Text.NoNewInformation": "Keine neuen Informationen.",
  "WITCHER.Chrome.Dissect.Text.NoRpGained": "Keine FP erhalten.",
  "WITCHER.Chrome.Dissect.Text.OnlyOption": "(einzige Option für diese Kategorie)",
  "WITCHER.Chrome.Dissect.Text.Pass": "Bestanden",
  "WITCHER.Chrome.Dissect.Text.PerformingBumpsTier": "Die Sektion selbst hebt einen brandneuen Bestiariumseintrag von Forschungsstufe 0 → 1.",
  "WITCHER.Chrome.Dissect.Text.Research": "Forschung",
  "WITCHER.Chrome.Dissect.Text.ResearchDesc": "gewährt <b>+1 FP</b> pro Treffer auf die Forschungsstufe des Bestiariumseintrags dieses Monsters. Keine zufällige Enthüllung — nur Forschungspunkte.",
  "WITCHER.Chrome.Dissect.Text.RpEarnedLine": "<b>+{rp} FP</b> für diesen Bestiariumseintrag erhalten.",
  "WITCHER.Chrome.Dissect.Text.Setting": "Umgebung",
  "WITCHER.Chrome.Dissect.Text.SkillRankLine": "Fertigkeitsrang · {skill} ({stat}): {value}",
  "WITCHER.Chrome.Dissect.Text.Skills": "Fertigkeiten",
  "WITCHER.Chrome.Dissect.Text.SkillsDesc": "die <b>Ränge</b> in den Fertigkeiten des Monsters (nur der Fertigkeitswert, <i>nicht</i> die gewürfelte Summe aus Attribut + Rang).",
  "WITCHER.Chrome.Dissect.Text.SlowerEvery4": "(langsamer — alle <b>4</b> über SG = +1 Treffer)",
