  "WITCHER.App.StatusEffectsEditor.Text.SkillWhenKindSkill": "Fertigkeit (wenn Art = Fertigkeit)",
  "WITCHER.App.StatusEffectsEditor.Text.StatModifiers": "Attributsmodifikatoren",
  "WITCHER.App.StatusEffectsEditor.Text.StatusEffects": "Statuseffekte",
  "WITCHER.App.StatusEffectsEditor.Text.StressShield": "Stress-Schild",
  "WITCHER.App.StatusEffectsEditor.Text.Value": "Wert",
  "WITCHER.App.StatusEffectsEditor.Text.VisibleOnToken": "Auf Token sichtbar",
  "WITCHER.App.StatusEffectsEditor.Tooltip.BufferSizeRolledOnApplyAcceptsAnyRollFor": "Buffergröße, die beim Anwenden gewürfelt wird. Akzeptiert jede Roll-Formel — Würfel (1W6, 2W6, 3W6+1) oder eine feste Zahl (3). Wird ignoriert, wenn die Art „Keine“ ist.",
  "WITCHER.App.StatusEffectsEditor.Tooltip.ChooseAnIcon": "Wähle ein Symbol",
  "WITCHER.App.StatusEffectsEditor.Tooltip.ClearOverrideAndFallBackToFamilyDefault": "Überschreibung löschen und zum Familienstandard zurückkehren",
  "WITCHER.App.StatusEffectsEditor.Tooltip.ColorOfTheCountdownRingOnTheChromeDockSt": "Farbe des Countdown-Rings am Chrome-Dock-Statussymbol. Leer lassen, um den Familienstandard zu verwenden (rot = Stressbruch, grün = Stresssegen, orange = Nahrung/Getränk, bernstein = alles Übrige).",
  "WITCHER.App.StatusEffectsEditor.Tooltip.ErodeThisMuchReliabilityOffEquippedWeapons": "So viel Zuverlässigkeit pro Zug von jeder ausgerüsteten Waffe abziehen (Rost / Säure).",
  "WITCHER.App.StatusEffectsEditor.Tooltip.ErodeThisMuchStoppingPowerOffTheArmorAtE": "Erodiert an jeder getroffenen Zone jede Runde diesen Wert an Stopping Power von der Rüstung (Feuer/Säure). 0 = keine.",
  "WITCHER.App.StatusEffectsEditor.Tooltip.RemoveThisStatus": "Diesen Status entfernen",
  "WITCHER.App.StatusEffectsEditor.Tooltip.VisibleOnToken": "Wenn aktiviert, zeigt das Token-Porträt einen Statusring für diesen Effekt. Wenn deaktiviert, wirkt der Effekt weiterhin normal, aber es erscheint kein Ring auf dem Token — für narrative oder Buchhaltungsstatus verwenden.",
  "WITCHER.App.StatusEffectsEditor.Tooltip.WhatTheBufferCountsPointsSubtractsFromEa": "Was der Buffer zählt. Punkte: zieht von jedem Anstieg ab, bis der Buffer aufgebraucht ist. Quellen: ignoriert ganze Anstiegs-Ereignisse, eines pro Bufferpunkt.",
  "WITCHER.App.StealthConfig.Band.Close": "Nah",
  "WITCHER.App.StealthConfig.Band.Extreme": "Extrem",
  "WITCHER.App.StealthConfig.Band.Long": "Weit",
  "WITCHER.App.StealthConfig.Band.Medium": "Mittel",
  "WITCHER.App.StealthConfig.Band.PointBlank": "Auf Tuchfühlung",
  "WITCHER.App.StealthConfig.Blurb": "Alles, was das Schleich-Subsystem nutzt, lässt sich hier feinjustieren. Die Verbraucher lesen live, sodass die meisten Änderungen mit der nächsten Erkennungsauswertung ohne Weltneustart wirksam werden.",
  "WITCHER.App.StealthConfig.Coverage.Full": "Vollständig sichtbar (100 % sichtbar)",
  "WITCHER.App.StealthConfig.Coverage.Half": "Halb sichtbar (50–74 % sichtbar)",
  "WITCHER.App.StealthConfig.Coverage.Quarter": "Viertel sichtbar (25–49 % sichtbar)",
  "WITCHER.App.StealthConfig.Coverage.Sliver": "Fast verdeckt (<25 % sichtbar)",
  "WITCHER.App.StealthConfig.Coverage.ThreeQuarter": "Drei Viertel sichtbar (75–99 % sichtbar)",
  "WITCHER.App.StealthConfig.ResetConfirmBody": "Alle Schleich-Konfigurationsüberschreibungen verwerfen und die Standardwerte wiederherstellen? Wird beim Speichern wirksam.",
  "WITCHER.App.StealthConfig.ResetConfirmTitle": "Schleich-Konfiguration zurücksetzen?",
  "WITCHER.App.StealthConfig.ResetToDefaults": "Auf Standard zurücksetzen",
  "WITCHER.App.StealthConfig.Save": "Speichern",
  "WITCHER.App.StealthConfig.Saved": "Schleich-Konfiguration gespeichert.",
  "WITCHER.App.StealthConfig.Section.Core": "Grundverhalten",
  "WITCHER.App.StealthConfig.Section.Coverage": "Körper-Sichtbarkeits-Modifikatoren",
  "WITCHER.App.StealthConfig.Section.RangeBands": "Entfernungsbereiche",
  "WITCHER.App.StealthConfig.Section.Rendering": "Kegel-Darstellung",
  "WITCHER.App.StealthConfig.Section.Sight": "Sichtweite",
  "WITCHER.App.StealthConfig.Section.Zones": "Sichtzonen-Modifikatoren",
  "WITCHER.App.StealthConfig.Text.AlphaFloor": "Minimale Kegelhelligkeit (0–1)",
  "WITCHER.App.StealthConfig.Text.AlphaFloorDesc": "Wird nur genutzt, wenn „Kegelhelligkeit nach Entdeckungschance skalieren“ aktiv ist. Kegel harmloser Späher verblassen auf diesen Wert; Kegel gefährlicher Späher bleiben nahe voller Deckkraft.",
  "WITCHER.App.StealthConfig.Text.AlphaScaleDesc": "Kegel von Spähern ohne realistische Chance, dich zu sehen, verblassen zur Mindesthelligkeit; Kegel von Spähern auf Messers Schneide bleiben voll aufgedreht.",
  "WITCHER.App.StealthConfig.Text.AlphaScaleName": "Kegelhelligkeit nach Entdeckungschance skalieren",
  "WITCHER.App.StealthConfig.Text.AutoSpot": "Auto-Entdeckung",
  "WITCHER.App.StealthConfig.Text.Band": "Bereich",
  "WITCHER.App.StealthConfig.Text.BaseSightMetres": "Basis-Sichtweite (Meter)",
  "WITCHER.App.StealthConfig.Text.Coverage": "Sichtbarkeit",
  "WITCHER.App.StealthConfig.Text.CoverageDesc": "Wie viel vom Token des Schleichers für den Späher tatsächlich sichtbar ist (Stichproben aus der Bounding-Box des Tokens, die im Sicht-Polygon des Spähers liegen, ohne die Wände, die den Rest blockieren, mitzuzählen). 100 % sichtbar = neutral; weniger sichtbar = schwerer zu entdecken.",
  "WITCHER.App.StealthConfig.Text.CrossLevelDesc": "Erlaubt Spähern, Schleicher auf einer anderen Szenen-Ebene zu erkennen. Aus = etagenübergreifende Erkennung ist vollständig deaktiviert, unabhängig von Foundrys level.visibility.levels-Konfiguration.",
  "WITCHER.App.StealthConfig.Text.CrossLevelName": "Etagenübergreifende Erkennung",
  "WITCHER.App.StealthConfig.Text.DebugDesc": "Sende bei jeder Probe eine vollständige Modifikator-Aufschlüsselung als Chat-Karte an den SL (inkl. „noch verborgen“-Ergebnisse). Aus = nur ein kurzer „von X entdeckt“-Flüsterspruch an Besitzer des Schleichers + SL, wenn der Schleicher erstmals entdeckt wird.",
  "WITCHER.App.StealthConfig.Text.DebugName": "Debug-Chatausgabe",
  "WITCHER.App.StealthConfig.Text.EnableStealthDesc": "Hauptschalter. Aus = Erkennungsauswertung pausiert, das rote Kegel-Overlay zeichnet nichts, benutzerübergreifendes Token-Verstecken wird übersprungen und der Schleich-HUD-Button wird ausgeblendet. Bestehende Schleich-Flags auf Akteuren bleiben erhalten.",
  "WITCHER.App.StealthConfig.Text.EnableStealthName": "Schleich-System aktivieren",
  "WITCHER.App.StealthConfig.Text.FractionOfMaxSight": "Obergrenze (× max. Sicht)",
  "WITCHER.App.StealthConfig.Text.HideConeDesc": "Sobald ein Späher den Schleicher entdeckt hat, blende dessen Kegel im Overlay des Schleicher-Besitzers aus — sie wurden gesehen, der Kegel trägt also keine Information mehr.",
  "WITCHER.App.StealthConfig.Text.HideConeName": "Kegel des Spähers ausblenden, sobald er dich entdeckt hat",
  "WITCHER.App.StealthConfig.Text.Mod": "Mod",
  "WITCHER.App.StealthConfig.Text.OnlyCatchDesc": "Kegel zeigen NUR den Teilbereich, in dem der effektive SG des Spähers deine passive Schleichen-Wertung erreichen oder übertreffen würde — also Felder, auf denen ein Schritt garantiert entdeckt wird. Schwache Späher, die dich auf keiner Entfernung erwischen können, zeigen überhaupt keinen Kegel; starke Späher zeigen nur die tödlichen Sektoren ihres Sichtfelds.",
  "WITCHER.App.StealthConfig.Text.OnlyCatchName": "Nur Felder mit 100 % Entdeckungschance anzeigen",
  "WITCHER.App.StealthConfig.Text.PointBlankMetres": "„Auf Tuchfühlung“-Distanz (Meter)",
  "WITCHER.App.StealthConfig.Text.RangeBandFractionsDesc": "Wo jeder Bereich endet, als Anteil der effektiven maximalen Sicht des Spähers. Alles jenseits von „Extrem“ liegt außerhalb der Reichweite.",
  "WITCHER.App.StealthConfig.Text.RangeBandsDesc": "Modifikator auf den passiven SG des Spähers je nach Entfernung des Schleichers. Positiv = leichter zu entdecken; negativ = schwerer. Auf Tuchfühlung ist immer Auto-Entdeckung, unabhängig vom Zahlenwert.",
  "WITCHER.App.StealthConfig.Text.RenderMode": "Kegel-Renderstil",
  "WITCHER.App.StealthConfig.Text.RenderModeDesc": "Voll = gefüllte Kegel mit zonenweiser Schattierung (reichhaltig, aber GPU-lastiger). Kontur = nur dünne farbige Umrandung, grün→gelb→rot je nach Bedrohungsstufe eingefärbt (schlank; empfohlen für Szenen mit vielen Spähern).",
  "WITCHER.App.StealthConfig.Text.RenderModeFull": "Voll (gefüllte Kegel)",
  "WITCHER.App.StealthConfig.Text.RenderModeOutline": "Kontur (Bedrohungs-Färbung)",
  "WITCHER.App.StealthConfig.Text.SightFormula": "Die <b>maximale Sicht</b> jedes Spähers = Basis + <b>INT</b> des Spähers + <b>Wahrnehmungs</b>-Rang des Spähers. Eine Basis von 20 m mit einem Späher (INT-6, Wahrnehmung-3) sieht 29 m am äußeren Rand; alles darüber hinaus ist nicht mehr sichtbar.",
  "WITCHER.App.StealthConfig.Text.Zone": "Zone",
  "WITCHER.App.StealthConfig.Text.ZonesDesc": "Winkelposition des Schleichers innerhalb des Späher-Kegels. Inneres (fokussiert) liegt direkt voraus; nahe Peripherie liegt seitlich; ferne Peripherie liegt direkt am Rand des Sichtfelds.",
  "WITCHER.App.StealthConfig.Title": "Token-Schleich-Konfiguration",
  "WITCHER.App.StealthConfig.Tooltip.BaseSight": "20 m Standard. Die max. Sicht pro Späher addiert INT + Wahrnehmungs-Rang darüber.",
  "WITCHER.App.StealthConfig.Tooltip.PointBlankMetres": "Entfernung, innerhalb derer Späher den Schleicher unabhängig vom Schleichen-Wurf automatisch entdecken.",
  "WITCHER.App.StealthConfig.Zone.Far": "Ferne Peripherie (äußerste 10°)",
  "WITCHER.App.StealthConfig.Zone.Focused": "Fokussiert (Inneres)",
  "WITCHER.App.StealthConfig.Zone.Near": "Nahe Peripherie (10–20° vom Rand)",
  "WITCHER.App.StealthExplainer.Angle": "Winkel",
  "WITCHER.App.StealthExplainer.AngleDesc": "Wenn du direkt vor ihnen im Sichtfeld stehst, sehen sie klar. Seitlich (peripher) sehen sie weniger deutlich.",
  "WITCHER.App.StealthExplainer.Coverage": "Sichtbarkeit",
  "WITCHER.App.StealthExplainer.CoverageDesc": "Je mehr deines Körpers von Wänden oder Objekten verdeckt ist, desto schwerer bist du zu entdecken.",
  "WITCHER.App.StealthExplainer.EnemyPassive": "Jeder Gegner hat einen passiven Wert: 10 + INT + Wahrnehmungs-Rang + Wahrnehmungs-Modifikator. Er addiert situative Modifikatoren dazu und vergleicht mit deinem Schleichen-Wert. Erreicht oder überboten = entdeckt.",
  "WITCHER.App.StealthExplainer.Footer": "Dein SL kann jede Zahl hier — Entfernungsmodifikatoren, Sichtweite, Sichtbarkeitsstrafen — unter Einstellungen konfigurieren → Token-Schleichen ändern.",
  "WITCHER.App.StealthExplainer.Intro": "Schleichen ist eine passive Probe. Du würfelst einmal, wenn du in den Schleichmodus gehst; jeder Gegner vergleicht seine Wahrnehmung mit deiner einen Zahl, bis du das Schleichen verlässt oder sie dich sehen.",
  "WITCHER.App.StealthExplainer.OnTheMap": "Auf der Karte",
  "WITCHER.App.StealthExplainer.OnTheMapDesc": "Rote Kegel zeigen, wo Gegner sehen können. Umgehe sie, unterbrich die Sichtlinie oder nutze Deckung, um verborgen zu bleiben. Sobald ein Gegner dich entdeckt hat, verschwindet sein Kegel — er weiß, dass du da bist.",
  "WITCHER.App.StealthExplainer.OneRoll": "Diese Zahl ist dein Schleichen-Wert, solange du im Schleichmodus bleibst — du würfelst während des Schleichens nicht neu.",
  "WITCHER.App.StealthExplainer.Range": "Entfernung",
  "WITCHER.App.StealthExplainer.RangeDesc": "Auf Tuchfühlung entdeckt automatisch. Nah macht dich leicht zu sehen. Mittel ist neutral. Weit und Extrem machen dich schwerer zu sehen.",
  "WITCHER.App.StealthExplainer.SightDistance": "Wie weit Gegner sehen",
  "WITCHER.App.StealthExplainer.SightDistanceDesc": "Die maximale Sicht jedes Gegners entspricht der Basis-Sichtweite (Standard 20 m) PLUS seiner INT und seinem Wahrnehmungs-Fertigkeitsrang. Ein stumpfer Ork sieht ungefähr die Basisreichweite; ein scharfäugiger Elfenwaldläufer sieht weit darüber hinaus. Jenseits dieses Maximums bist du gar nicht sichtbar.",
  "WITCHER.App.StealthExplainer.Title": "So funktioniert Schleichen",
  "WITCHER.App.StealthExplainer.WhatChangesTheirScore": "Was ihren Wert verändert",
  "WITCHER.App.StealthExplainer.WhatEnemiesRoll": "Was Gegner gegen dich prüfen",
  "WITCHER.App.StealthExplainer.WhatYouRoll": "Was du würfelst",
  "WITCHER.App.StressConfig.Blurb": "Stellschrauben für die Stress-Homebrew. Standardwerte entsprechen der Originalvorgabe. Bruch- und Segenstabellen-Text sowie die Stress-Schild-Würfel werden im Statuseffekt-Editor bearbeitet.",
  "WITCHER.App.StressConfig.Dialog.Button.ResetToDefaults": "Auf Standard zurücksetzen",
  "WITCHER.App.StressConfig.Text.ComplexWound": "Komplexe Wunde",
  "WITCHER.App.StressConfig.Text.CriticalWounds": "Kritische Wunden",
  "WITCHER.App.StressConfig.Text.DeadlyWound": "Tödliche Wunde",
  "WITCHER.App.StressConfig.Text.DifficultWound": "Schwierige Wunde",
  "WITCHER.App.StressConfig.Text.DiscardAllStressConfigurationOverridesAn": "Alle Stress-Konfigurationsüberschreibungen verwerfen und die Homebrew-Standards wiederherstellen? Dies wird wirksam, wenn du speicherst.",
  "WITCHER.App.StressConfig.Text.HowHardEachPointOverWillHurtsTheSave": "Wie stark jeder Punkt über WIL den Wurf erschwert",
  "WITCHER.App.StressConfig.Text.MentalBreaksBeforeCharacterIsLost": "Mentale Brüche, bevor der Charakter verloren ist",
  "WITCHER.App.StressConfig.Text.SimpleWound": "Einfache Wunde",
  "WITCHER.App.StressConfig.Text.StressConfiguration": "Stress-Konfiguration",
  "WITCHER.App.StressConfig.Text.StressOverWillSlowsNaturalHealing": "Stress über WIL verlangsamt natürliche Heilung",
  "WITCHER.App.StressConfig.Text.StressRemainingAfterAWillSaveRelativeToW": "Verbleibender Stress nach einem WIL-Wurf (relativ zu WIL)",
  "WITCHER.App.StressConfig.Text.TakingACriticalWoundAddsStress": "Eine kritische Wunde zu erleiden erhöht Stress",
  "WITCHER.App.StressConfig.Text.WillSaveRecovery": "WIL-Wurf & Erholung",
  "WITCHER.App.StressConfig.Tooltip.AfterEveryWillSaveStressSettlesToWillThi": "Nach jedem WIL-Wurf pendelt sich der Stress auf (WIL + diese Zahl) ein. Standard =−1, sodass WIL 6 bei 5 landet. 0 nutzen, um genau bei WIL zu stoppen; −3 für ein stärkeres Zurücksetzen.",
  "WITCHER.App.StressConfig.Tooltip.EachPointOfStressOverWillHitsTheWillSave": "Jeder Stresspunkt über WIL erschwert den WIL-Wurf um diesen Wert. 1 = Standard (Stress 9 gegen WIL 6 → Zielwert 3). 0,5 = Würfe bleiben bei hohem Stress leichter; 2 = jeder Punkt über WIL verdoppelt den Schmerz.",
  "WITCHER.App.StressConfig.Tooltip.HowManyDistinctMentalBreaksACharacterCan": "Wie viele unterschiedliche mentale Brüche ein Charakter ansammeln kann, bevor die Kontrolle an den SL übergeht. Standard =8 (jeder Eintrag der Bruchtabelle). Kleinere Zahlen lassen den Charakter früher zerbrechen.",
  "WITCHER.App.WeatherControl.Text.Today": "Heute",
