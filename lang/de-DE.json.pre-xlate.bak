  "WITCHER.App.QualitiesEditor.Dialog.Button.ParryPenaltyReduction": "Parade-Abzugsminderung",
  "WITCHER.App.QualitiesEditor.Dialog.Button.Percent": "Prozent (%)",
  "WITCHER.App.QualitiesEditor.Dialog.Button.PercentRollsD100VsParameter": "Prozent (würfelt W100 gegen Parameter)",
  "WITCHER.App.QualitiesEditor.Dialog.Button.ReliabilityBonus": "Zuverlässigkeitsbonus",
  "WITCHER.App.QualitiesEditor.Dialog.Button.SpellDCBonus": "Zauber-SG-Bonus",
  "WITCHER.App.QualitiesEditor.Dialog.Button.StunSaveTargetRollsStunAt": "Betäubungswurf (Ziel würfelt Betäubung bei Parameter)",
  "WITCHER.App.QualitiesEditor.Dialog.Button.TextFormula": "Text / Formel",
  "WITCHER.App.QualitiesEditor.Dialog.ResetConfirm": "<p>Deine Anpassungen an den {name}-Qualitäten verwerfen und die Systemstandards wiederherstellen? Dies wird wirksam, wenn du speicherst.</p>",
  "WITCHER.App.QualitiesEditor.Hint.ChargeBonusPerMeter": "Bonus-Schadenswürfel pro Meter, den du im Sturm von einem Reittier zurücklegst (Sturm = 1, also +1W6/m).",
  "WITCHER.App.QualitiesEditor.Hint.ParryPenaltyDelta": "Verringert den −3 Paradeabzug um N, wenn du mit dieser Waffe VERTEIDIGST (Parade = 2).",
  "WITCHER.App.QualitiesEditor.Hint.ReliabilityBonus": "Wird zur maximalen Zuverlässigkeit der Waffe addiert, wenn diese Qualität vorliegt (Meteorit = 5).",
  "WITCHER.App.QualitiesEditor.Hint.SkillOverride": "Erzwingt, dass der Trefferwurf der Waffe diesen skillMap-Schlüssel verwendet (selten benutzt — der eigene skillKey der Waffe deckt die meisten Fälle ab). Leer = Standard der Waffe verwenden.",
  "WITCHER.App.QualitiesEditor.Hint.SpellDCBonus": "Zauber, die durch diese Waffe gewirkt werden, behandeln ihre Ziel-SG als +N (Verstärkter Fokus = 2).",
  "WITCHER.App.QualitiesEditor.Text.AddsDamageToUnarmedBrawlingCestusSpikedG": "Fügt unbewaffnetem Schaden Schaden hinzu (Handgemenge — Cestus / Stachelhandschuh rechnet seinen Schaden in Fauststöße/Tritte ein)",
  "WITCHER.App.QualitiesEditor.Text.DamageFlags": "Schadensflags",
  "WITCHER.App.QualitiesEditor.Text.Description": "Beschreibung",
  "WITCHER.App.QualitiesEditor.Text.IgnoresRepositionDistanceLongReachWeapon": "Ignoriert Repositionierungsdistanz (Waffe mit großer Reichweite — die Reposition des Verteidigers macht Folgeschläge nicht zunichte)",
  "WITCHER.App.QualitiesEditor.Text.Kind": "Art",
