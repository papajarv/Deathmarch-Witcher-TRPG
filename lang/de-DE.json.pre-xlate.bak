  "WITCHER.App.OpenCategoryConfigDialog.Text.GrantedQualities": "Gewährte Qualitäten",
  "WITCHER.App.OpenCategoryConfigDialog.Text.GrantedQualitiesSub": "(feuern nach dem Treffer, wenn {label} auslöst — trage bei Bedarf Parameterwerte ein)",
  "WITCHER.App.QualitiesEditor.Blurb": "Bearbeite den Laufzeitkatalog der Waffen- und Rüstungsqualitäten. Jede Karte ist eine Qualität: ihr Anzeigename, die Beschreibung und ein optionaler Parameter — der Wert, den ein Spieler direkt einträgt (Blutung",
  "WITCHER.App.QualitiesEditor.Button.Add": "Hinzufügen",
  "WITCHER.App.QualitiesEditor.Button.ResetToDefaults": "Auf Standard zurücksetzen",
  "WITCHER.App.QualitiesEditor.Dialog.Button.Ablating1d62SPDamageOn": "Absplitternd (+1W6/2 SP-Schaden bei Durchdringung, zusätzlich zum standardmäßigen −1 SP-Chip)",
  "WITCHER.App.QualitiesEditor.Dialog.Button.ArmorPiercingNegatesDR": "Rüstungsbrechend (hebt SR auf)",
  "WITCHER.App.QualitiesEditor.Dialog.Button.AttackSkillOverride": "Angriffs-Fertigkeit überschreiben",
  "WITCHER.App.QualitiesEditor.Dialog.Button.AutoAppliesOnEveryDamagingHit": "Automatisch (bei jedem Schadenstreffer)",
  "WITCHER.App.QualitiesEditor.Dialog.Button.BypassesNaturalArmor": "Umgeht natürliche Rüstung",
  "WITCHER.App.QualitiesEditor.Dialog.Button.BypassesShieldQuen": "Umgeht Schild (Quen)",
  "WITCHER.App.QualitiesEditor.Dialog.Button.BypassesWornArmor": "Umgeht getragene Rüstung",
  "WITCHER.App.QualitiesEditor.Dialog.Button.CannotBeParriedEGCrushing": "Kann nicht pariert werden (z. B. Wuchtwaffen)",
  "WITCHER.App.QualitiesEditor.Dialog.Button.ChargeBonusMeter": "Sturmbonus / Meter",
