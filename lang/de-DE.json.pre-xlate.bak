  "WITCHER.App.CarouselInitiativeConfig.Section.Layout": "Layout & Größe",
  "WITCHER.App.CarouselInitiativeConfig.Section.Motion": "Bewegung & Übergänge",
  "WITCHER.App.CarouselInitiativeConfig.Text.ActiveGlowColor": "Leuchten des aktiven Zugs",
  "WITCHER.App.CarouselInitiativeConfig.Text.ActiveScale": "Skalierung der aktiven Karte",
  "WITCHER.App.CarouselInitiativeConfig.Text.CardGap": "Kartenabstand",
  "WITCHER.App.CarouselInitiativeConfig.Text.CardHeight": "Kartenhöhe",
  "WITCHER.App.CarouselInitiativeConfig.Text.CardWidth": "Kartenbreite",
  "WITCHER.App.CarouselInitiativeConfig.Text.ContainerMaxWidth": "Maximale Containerbreite",
  "WITCHER.App.CarouselInitiativeConfig.Text.EnabledDesc": "Haupt-Aktivierungsschalter für den Karussell-Initiative-Tracker. Wenn AUS, wird der Tracker gar nicht gerendert — diese Option erfordert einen Weltneuladen, um vollständig wirksam zu werden.",
  "WITCHER.App.CarouselInitiativeConfig.Text.EnabledName": "Karussell-Initiative-Tracker aktivieren",
  "WITCHER.App.CarouselInitiativeConfig.Text.FriendlyColor": "Freundlich (grün)",
  "WITCHER.App.CarouselInitiativeConfig.Text.HideSecretDesc": "Kombattanten, deren Token-Gesinnung GEHEIM ist, werden vor Spielern sowohl im Karussell als auch im Seitenleisten-Tracker verborgen.",
  "WITCHER.App.CarouselInitiativeConfig.Text.HideSecretName": "GEHEIME Kombattanten vor Spielern verbergen",
  "WITCHER.App.CarouselInitiativeConfig.Text.HideStealthDesc": "Kombattanten, die über die Schleich-Mechanik dieses Systems geschlichen sind, werden vor Spielern verborgen — abhängig vom Späher-Sichtbarkeits-Schalter unten.",
  "WITCHER.App.CarouselInitiativeConfig.Text.HideStealthName": "Geschlichene Kombattanten vor Spielern verbergen",
  "WITCHER.App.CarouselInitiativeConfig.Text.HostileColor": "Feindlich (rot)",
  "WITCHER.App.CarouselInitiativeConfig.Text.NeutralColor": "Neutrale Farbe",
  "WITCHER.App.CarouselInitiativeConfig.Text.NeutralShowFrameDesc": "Wenn EIN, erhalten Kombattanten mit neutraler Gesinnung einen farbigen Rahmen in der unten gewählten Farbe. Wenn AUS (Standard), haben neutrale Kombattanten keinen sichtbaren Rahmen — die Rahmenbreite reserviert dennoch 2px, damit die Karten gleich groß bleiben.",
  "WITCHER.App.CarouselInitiativeConfig.Text.NeutralShowFrameName": "Rahmen für neutrale Kombattanten anzeigen",
  "WITCHER.App.CarouselInitiativeConfig.Text.PortraitHeight": "Porträthöhe",
  "WITCHER.App.CarouselInitiativeConfig.Text.SecretColor": "Geheim (violett)",
  "WITCHER.App.CarouselInitiativeConfig.Text.ShowForGMDesc": "Wenn AUS, wird das Karussell für SL-Nutzer verborgen. Nützlich für SLs, die nur den Seitenleisten-Tracker bevorzugen.",
  "WITCHER.App.CarouselInitiativeConfig.Text.ShowForGMName": "Karussell dem SL zeigen",
  "WITCHER.App.CarouselInitiativeConfig.Text.ShowForPlayersDesc": "Wenn AUS, wird das Karussell für Spieler-Nutzer verborgen. Der Seitenleisten-Tracker wird weiterhin gemäß dem normalen Verhalten von Foundry gerendert.",
  "WITCHER.App.CarouselInitiativeConfig.Text.ShowForPlayersName": "Karussell den Spielern zeigen",
  "WITCHER.App.CarouselInitiativeConfig.Text.ShowTheaterDesc": "Wenn EIN, wird das Karussell für Theater-of-the-Mind-Kämpfe angezeigt (bei denen kein Kombattant einen Szenen-Token besitzt). Schalte es aus, falls du für tokenlose Kämpfe den Seitenleisten-Tracker verwendest.",
  "WITCHER.App.CarouselInitiativeConfig.Text.ShowTheaterName": "Für Theater-of-the-Mind-Kampf anzeigen",
  "WITCHER.App.CarouselInitiativeConfig.Text.ShowTokenCombatDesc": "Wenn EIN, wird das Karussell für Kämpfe angezeigt, bei denen mindestens ein Kombattant einen Szenen-Token besitzt. Schalte es aus, falls du das Karussell nur für Theater-of-the-Mind-Kämpfe möchtest.",
  "WITCHER.App.CarouselInitiativeConfig.Text.ShowTokenCombatName": "Für token-basierten Kampf anzeigen",
  "WITCHER.App.CarouselInitiativeConfig.Text.SnapWrapDesc": "Wenn EIN, schnappt das Karussell sofort um (ohne Gleitanimation), wenn die Runde zum ersten Kombattanten zurückspringt. Andernfalls animiert der Streifen sich über die gesamte Breite zurück, was wie eine große Schleuder nach rechts wirkt.",
  "WITCHER.App.CarouselInitiativeConfig.Text.SnapWrapName": "Bei Rundenumbruch umschnappen",
  "WITCHER.App.CarouselInitiativeConfig.Text.SpotterVisibilityDesc": "Wenn EIN, sehen Spieler, die einen Späher besitzen, der einen geschlichenen Kombattanten entdeckt hat, diesen Kombattanten weiterhin im Karussell und in der Seitenleiste. Wenn AUS, werden geschlichene Kombattanten unabhängig vom Späher-Status stets vor Nicht-Besitzern verborgen.",
  "WITCHER.App.CarouselInitiativeConfig.Text.SpotterVisibilityName": "Späher-Sichtbarkeit berücksichtigen",
  "WITCHER.App.CarouselInitiativeConfig.Text.TransitionMs": "Gleitdauer",
  "WITCHER.App.CarouselInitiativeConfig.Title": "Karussell-Initiative-Konfiguration",
  "WITCHER.App.CarouselInitiativeConfig.Unit.Ms": "Millisekunden",
