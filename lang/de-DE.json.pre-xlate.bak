  "WITCHER.Combat.DamageBreakdown.Line.ActiveShield": "{shield} absorbierte <b>{drained}</b> (<i>{before} → {after}</i>); {remaining} verbleibend.",
  "WITCHER.Combat.DamageBreakdown.Line.BlockedBySp": "Treffer vollständig durch Rüstungs-SP abgefangen.",
  "WITCHER.Combat.DamageBreakdown.Line.CritActiveShield": "{shield} absorbierte <b>{drained}</b> vom Krit-Bonus (<i>{before} → {after}</i>); {remaining} verbleibend.",
  "WITCHER.Combat.DamageBreakdown.Line.CritBonus": "Kritischer Bonus <b>+{added}</b> jenseits der Rüstung hinzugefügt (Waffe {weapon} + Krit. {added} = {total}).",
  "WITCHER.Combat.DamageBreakdown.Line.CritMonsterImmune": "Kritischer Bonus auf 0 &mdash; Ziel gegen diese Schadensart immun (<i>{before} &rarr; 0</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.CritMonsterMeteoriteResist": "Kritischer Bonus halbiert &mdash; Ziel widersteht Nicht-Meteorit-Schaden (<i>{before} &rarr; {after}</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.CritMonsterResist": "Kritischer Bonus halbiert &mdash; Ziel widersteht Nicht-Silber-Schaden (<i>{before} &rarr; {after}</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.CritMonsterTypeResist": "Kritischer Bonus halbiert &mdash; Ziel widersteht dieser Schadensart (<i>{before} &rarr; {after}</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.CritShield": "{shield} absorbierte <b>{drained}</b> vom Krit-Bonus (<i>{before} → {after}</i>); {remaining} verbleibend.",
  "WITCHER.Combat.DamageBreakdown.Line.CritSilverPoorEdge": "Krit-Bonus halbiert — Silbers stumpfe Schneide gegen nicht-silber-anfällige Ziele (<i>{before} &rarr; {after}</i>).",
  "WITCHER.Combat.DamageBreakdown.Line.CritVulnerability": "Kritischer Bonus verdoppelt &mdash; Ziel gegen diese Schadensart verwundbar (<i>{before} &rarr; {after}</i>).",
