    "WITCHER.Combat.DamageBreakdown.Line.OilName": " ({name})",
    "WITCHER.Combat.DamageBreakdown.Line.OilVsTarget": " vs {label}",
    "WITCHER.Combat.DamageBreakdown.Line.Shield": "{shield} drained <b>{drained}</b> (<i>{before} → {after}</i>); {remaining} remaining.",
    "WITCHER.Combat.DamageBreakdown.Line.SilverPoorEdge": "Silver's poor edge &mdash; target isn't silver-weak, incoming damage halved (<i>{before} &rarr; {after}</i>).",
    "WITCHER.Combat.DamageBreakdown.Line.SpAblateBreakdown": " &mdash; base &minus;{base}{crushing} + Ablating &minus;{ablating} (rolled)",
    "WITCHER.Combat.DamageBreakdown.Line.SpAblated": "Armor SP <b>{sp}</b> subtracted (<i>{before} → {after}</i>), armor ablated &minus;{total} SP{breakdown}.",
    "WITCHER.Combat.DamageBreakdown.Line.SpDoubledCrushing": " &mdash; doubled by Crushing Force",
    "WITCHER.Combat.DamageBreakdown.Line.SpNoAblate": "Armor SP <b>{sp}</b> subtracted (<i>{before} → {after}</i>) &mdash; this armor can't be ablated.",
    "WITCHER.Combat.DamageBreakdown.Line.SpSoaked": "Armor SP <b>{sp}</b> fully soaked <i>{before}</i> &mdash; no penetration.",
    "WITCHER.Combat.DamageBreakdown.Line.SpSubtracted": "Armor SP <b>{sp}</b> subtracted (<i>{before} → {after}</i>).",
    "WITCHER.Combat.DamageBreakdown.Line.Vulnerability": "Target is <b>vulnerable</b> to this damage type &mdash; incoming damage doubled (<i>{before} &rarr; {after}</i>).",
    "WITCHER.Combat.DamageBreakdown.Text.ActiveShieldCollapsed": "Active Shield collapsed",
    "WITCHER.Combat.DamageBreakdown.Text.NoPipelineStagesFired": "No pipeline stages fired.",
    "WITCHER.Combat.TileTargeting.Prompt": "Click a highlighted target to attack — right-click or Esc to cancel.",
    "WITCHER.Combat.TileTargeting.ChooseTitle": "Choose target",
    "WITCHER.Combat.TileTargeting.ChooseBody": "More than one target on that tile — pick one:",
    "WITCHER.CombatExtended.Action.Bash": "Bash",
    "WITCHER.CombatExtended.Action.BashDesc": "Bash: Brawling roll to hit; defender picks Dodge or Reposition. On a hit, opposed Physique vs Physique — both sides add their equipped shield's Cover Value. Attacker wins → push BODY/2 metres back (cut short by walls). +7 delta → also Staggered.",
    "WITCHER.CombatExtended.Action.Block": "Block",
    "WITCHER.CombatExtended.Action.BlockDesc": "Your melee skill (or Brawling with bare arms) vs the attack. Your weapon or shield loses 1 Reliability per absorbed hit. Arm blocks suffer Bludgeoning to the arm.",
    "WITCHER.CombatExtended.Action.Charge": "Charge",
    "WITCHER.CombatExtended.Action.ChargeDesc": "Close the distance and make a Strong attack. On a hit, opposed Physique vs the target to knock them prone.",
    "WITCHER.CombatExtended.Action.Chokehold": "Chokehold",
    "WITCHER.CombatExtended.Action.ChokeholdDesc": "Requires an active grapple. Target takes suffocation damage = 3 + your melee damage modifier, repeated each turn the hold is maintained. Stackable with Pin.",
    "WITCHER.CombatExtended.Action.Clinch": "Clinch",
    "WITCHER.CombatExtended.Action.ClinchDesc": "Spend your movement to close into clinch range with an enemy — not a grapple, but lets short-range weapons reach. The opponent isn't held and can break away.",
    "WITCHER.CombatExtended.Action.Disarm": "Grapple Disarm",
    "WITCHER.CombatExtended.Action.DisarmDesc": "Deals punch damage to the target's arm and knocks their weapon away. Optional Brawling DC18 to catch it for yourself; otherwise it lands 1d6m in a random direction. Victim re-pickup: DC16 Awareness this round, free next round.",
    "WITCHER.CombatExtended.Action.MeleeDisarm": "Melee Disarm",
    "WITCHER.CombatExtended.Action.MeleeDisarmDesc": "Disarm with any melee weapon — no grapple needed. Made at −6. On a hit, the target's weapon is knocked 1d6m in a random direction. You cannot snatch it for yourself.",
    "WITCHER.CombatExtended.Action.Tackle": "Tackle",
    "WITCHER.CombatExtended.Action.TackleDesc": "Full round: smash into a target with opposed Physique. If you win, you BOTH go prone; if you lose, only YOU go prone. No damage.",
    "WITCHER.CombatExtended.Action.Dodge": "Dodge",
    "WITCHER.CombatExtended.Action.DodgeDesc": "Dodge/Escape vs the attack. Per-round dodge pool equals your total SPD, separate from normal movement.",
    "WITCHER.CombatExtended.Action.Escape": "Escape",
    "WITCHER.CombatExtended.Action.EscapeDesc": "If grappled, pinned, or in a chokehold, spend your Action to roll Dodge/Escape vs the holder's Brawling. One Escape per hold.",
    "WITCHER.CombatExtended.Action.Fast": "Fast Attack",
    "WITCHER.CombatExtended.Action.FastDesc": "Make two successive strikes against the same target. Bows yes; crossbows cannot.",
    "WITCHER.CombatExtended.Action.Feint": "Feint",
    "WITCHER.CombatExtended.Action.FeintDesc": "Feint: roll your weapon skill against the target's Awareness. On success, your next attack against that target is at +3 to hit.",
    "WITCHER.CombatExtended.Action.Grapple": "Grapple",
    "WITCHER.CombatExtended.Action.GrappleDesc": "Roll Brawling vs the target's Brawling. While grappled, both suffer −2 to all physical checks (except against each other). Weapons usable, skill stays Brawling.",
    "WITCHER.CombatExtended.Action.Impale": "Impale",
    "WITCHER.CombatExtended.Action.ImpaleDesc": "Piercing weapons only. Take −3 to make a single attack; on a hit, gain Armor Piercing X. Weapons already AP step up to Improved Armor Piercing.",
    "WITCHER.CombatExtended.Action.Joint": "Joint Attack",
    "WITCHER.CombatExtended.Action.JointDesc": "Attack with both wielded weapons at −3. Defender may only parry / block the first attack unless they're also dual-wielding; the second can only be avoided by Dodge or Relocate.",
    "WITCHER.CombatExtended.Action.Lunge": "Lunge",
    "WITCHER.CombatExtended.Action.LungeDesc": "Close the distance and make an Impale attack.",
    "WITCHER.CombatExtended.Action.Parry": "Parry",
    "WITCHER.CombatExtended.Action.ParryDesc": "At −3, your weapon/melee/brawling vs the attack. On success, the attacker is Staggered.",
    "WITCHER.CombatExtended.Action.Pin": "Pin",
    "WITCHER.CombatExtended.Action.PinDesc": "Requires an active grapple. Pin against a wall or go prone. Deals kick damage to the torso; both combatants immobilised. Target suffers an additional −3 to physical checks (stacks with the −2 grapple penalty).",
    "WITCHER.CombatExtended.Action.Pommel": "Pommel Strike",
    "WITCHER.CombatExtended.Action.PommelDesc": "Single attack with the weapon's pommel — half damage, non-lethal.",
    "WITCHER.CombatExtended.Action.Push": "Push",
    "WITCHER.CombatExtended.Action.PushDesc": "Requires you to be grappling the target. No damage. Pushes the target a number of metres equal to your Physique base (BODY + Physique) ÷ 5, rounded down, in a direction you choose, snapping them to the nearest grid cell and breaking any grapple or pin they're in. If shoved into a wall, they take 1d6/2 ramming damage per 2m travelled (torso, bypassing armour but not a magic shield). Resisted with Brawling or Dodge/Escape. Rolled with the Grappling weapon's own skill.",
    "WITCHER.CombatExtended.Action.Slam": "Slam",
    "WITCHER.CombatExtended.Action.Takedown": "Takedown",
    "WITCHER.CombatExtended.Action.TakedownDesc": "Usable by either party in a grapple (holder or grapplee). Deals NON-LETHAL punch damage (to Stamina — still reduced by SP; only ramming ignores armour) and knocks BOTH combatants prone while the grapple hold is maintained. Resisted with Brawling or Dodge/Escape. Rolled with the Grappling weapon's own skill.",
    "WITCHER.CombatExtended.Action.SlamDesc": "Requires an active grapple with the target. Deals DOUBLE kick damage (non-lethal, to Stamina — still soaked by SP; not weapon damage) to a random location, knocks the target prone, throws them a fifth of your Physique base (BODY + Physique) metres, rounded down, in a direction you choose (breaking the grapple), and forces a Stun save. The impact deals an additional 1d6 ramming damage to the target's torso, bypassing armour (but not a magic shield); if slammed into a wall, add 1d6/2 more per 2m travelled. Resisted with Brawling or Dodge/Escape. Rolled with the Grappling weapon's own skill.",
    "WITCHER.CombatExtended.Action.Relocate": "Relocate",
    "WITCHER.CombatExtended.Action.RelocateDesc": "Athletics vs the attack; on success, move up to ½ SPD. Minimum SPD 1 to use. Shares the per-round movement pool with Dodge.",
    "WITCHER.CombatExtended.Action.ReverseGrapple": "Reverse Grapple",
    "WITCHER.CombatExtended.Action.ReverseGrappleDesc": "Attempt to reverse an existing grapple. On success, roles swap and the attacker becomes the one grappled.",
    "WITCHER.CombatExtended.Action.Single": "Single Attack",
    "WITCHER.CombatExtended.Action.SingleDesc": "Perform a single attack at no penalty.",
    "WITCHER.CombatExtended.Action.Strong": "Strong Attack",
    "WITCHER.CombatExtended.Action.StrongDesc": "Take −3 to make a single attack; on a hit, double the weapon's damage dice. Bows can also use this strike.",
    "WITCHER.CombatExtended.Action.Trip": "Trip",
    "WITCHER.CombatExtended.Action.TripDesc": "Deals punch damage to a random location and knocks the target prone. If you're grappling them, deal double damage, tumble them 1d6m, and force a Stun Save.",
    "WITCHER.CombatExtended.ActionsEditor.Hint": "Subsystem toggles, action-economy tuneables, and per-action STA / to-hit / damage / flag overrides for every Combat Extended attack and defense. Combat Extended is based on The Duderonomist's Equipment Overhaul and rule adaptations.",
    "WITCHER.CombatExtended.ActionsEditor.Name": "Configure Combat Extended",
    "WITCHER.CombatExtended.ActionsEditor.Title": "Configure Combat Extended",
