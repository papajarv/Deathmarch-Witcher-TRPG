    "WITCHER.Effect.ActionImmunityStatus": "Immune to status",
    "WITCHER.Effect.ActionModify": "Modify a stat",
    "WITCHER.Effect.ActionPurge": "Clear all alchemy effects",
    "WITCHER.Effect.ActionPurgeHint": "When this effect lands, it ends every other toxicity-bearing potion/decoction effect on the holder (their toxicity is reclaimed with them). This is how White Honey works.",
    "WITCHER.Effect.ActionStressShield": "Stress shield",
    "WITCHER.Effect.ActionStressShieldHint": "On apply, parses Value as a Roll formula (dice or flat number) and sets the buffer. POINTS: every stress raise is reduced by the buffer (a 4-point buffer eats 4 of a 5-point spike). SOURCES: each stress raise event consumes ONE buffer point regardless of size (a 1-source buffer eats one whole raise). Effect persists with no timer until the buffer is depleted, then deletes itself. Author it on potions, perks, or any custom buff.",
    "WITCHER.Effect.ActionStressShieldKind": "Shield kind",
    "WITCHER.Effect.ActionStressShieldKindPoints": "Absorbs N points of stress",
    "WITCHER.Effect.ActionStressShieldKindSources": "Absorbs N stress sources",
    "WITCHER.Effect.ActionStressShieldValue": "Value",
    "WITCHER.Effect.ActionStressShieldValueHint": "Buffer size rolled on apply. Accepts any Roll formula — dice (1d6, 2d6, 3d6+1) or a flat number (e.g. 3).",
    "WITCHER.Effect.ActionSuppress": "Suppress a penalty",
    "WITCHER.Effect.ActionSuppressWhat": "Penalty to ignore",
    "WITCHER.Effect.ActionTempHp": "Grant temporary HP (once)",
    "WITCHER.Effect.ActionVision": "Grant vision",
    "WITCHER.Effect.ActionVisionType": "Vision",
    "WITCHER.Effect.ActionVisionHint": "Grants low-light vision at the chosen tier and waives the light penalty for that tier and every lighter one (cumulative). Dark Vision also gives the token a Foundry vision mode + sight range so it visibly sees in pitch black. Lasts as long as the effect is active.",
