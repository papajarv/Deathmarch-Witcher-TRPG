    "WITCHER.Weather.Config.MapScene": "World-map scene",
    "WITCHER.Weather.Config.MapSceneHint": "The scene whose painted terrain and party marker drive multi-region weather.",
    "WITCHER.Weather.Config.MenuHint": "Every weather & time option in one place: the on/off toggles, automation, climate and clock speed, plus biomes, seasons, terrain landsites, condition penalties, and daylight/moon — all through friendly forms. Defaults are original to this system; you can edit, add, or remove anything.",
    "WITCHER.Weather.Config.MenuLabel": "Configure",
    "WITCHER.Weather.Config.MenuName": "Weather & Calendar",
    "WITCHER.Weather.Config.ModLabel": "Description",
    "WITCHER.Weather.Config.ModLabelPlaceholder": "e.g. Hard to see in the fog",
    "WITCHER.Weather.Config.ModMinLevel": "Applies when",
    "WITCHER.Weather.Config.ModMinLevelHint": "How bad the weather must get before this kicks in.",
    "WITCHER.Weather.Config.ModPerLevel": "Scales",
    "WITCHER.Weather.Config.PerTier": "per intensity (L1 · L2 · L3)",
    "WITCHER.Weather.Config.ModPerLevelHint": "When ON, this modifier multiplies with the weather's intensity — a −1 becomes −1 in light weather, −2 in moderate, −3 in severe. When OFF, it's the same flat value at every intensity (once “Applies when” is met).",
    "WITCHER.Weather.Config.ModTarget": "Affects",
    "WITCHER.Weather.Config.ModValue": "Modifier",
    "WITCHER.Weather.Config.ModValueHint": "Negative = penalty, positive = bonus.",
    "WITCHER.Weather.Config.ModValueTiers": "Value by intensity",
    "WITCHER.Weather.Config.ModValueTiersHint": "One value per weather intensity — light (1), moderate (2), severe (3). Negative = penalty, positive = bonus. Leave a box blank for no effect at that intensity.",
    "WITCHER.Weather.Config.ModifiersIntro": "Each weather condition can apply mechanical penalties. Add a row per effect: pick what it affects, then set the value for each weather intensity — light (1), moderate (2), and severe (3). Negative = penalty; leave a box blank for no effect at that tier.",
    "WITCHER.Weather.Config.Moon": "Moon",
    "WITCHER.Weather.Config.MoonCycle": "Cycle length (days)",
    "WITCHER.Weather.Config.MoonNote": "Phase names and the eight-phase split are seeded from the Witcher calendar; only the total cycle length is adjustable here.",
    "WITCHER.Weather.Config.NoRows": "No penalties for this condition.",
    "WITCHER.Weather.Config.Region": "Campaign region",
    "WITCHER.Weather.Config.RegionBaseline": "Temperature shift",
    "WITCHER.Weather.Config.RegionCustom": "Custom…",
    "WITCHER.Weather.Config.RegionIntro": "Where on the Continent is your campaign set? This slides every biome warmer or colder to match the latitude — the frozen north (Kovir) through to the savanna south (Ofir). Pick a region, or set your own offset.",
