    "WITCHER.Effect.CustomStatus.EndCheck": "Ending check",
    "WITCHER.Effect.CustomStatus.EndCheckActionCost": "Action cost in combat",
    "WITCHER.Effect.CustomStatus.EndCheckHint": "Roll the target has to make (in-combat spend or otherwise) to shake off this condition. Set kind to \"None\" to leave the condition sticky until dispelled.",
    "WITCHER.Effect.CustomStatus.EndCheckKind": "Kind",
    "WITCHER.Effect.CustomStatus.EndCheckSkill": "Skill (when kind is Skill)",
