    "WITCHER.UiScaleConfig.Blurb.Detailed": "Each slider drives one chrome region. Popups covers actor sheets, item sheets, dialogs, and the compendium browser.",
    "WITCHER.UiScaleConfig.Blurb.Modes": "Auto sizes the chrome proportionally to your viewport height. Manual multiplies on top of that with the UI Scale slider. Detailed unlocks a per-element slider for each chrome region.",
    "WITCHER.UiScaleConfig.Text.Apply": "Apply",
    "WITCHER.UiScaleConfig.Text.AutoViewportDpi": "Auto (viewport + DPI)",
    "WITCHER.UiScaleConfig.Text.BottomDock": "Bottom Dock",
    "WITCHER.UiScaleConfig.Text.Cancel": "Cancel",
    "WITCHER.UiScaleConfig.Text.DetailedPerElement": "Detailed (per-element)",
    "WITCHER.UiScaleConfig.Text.LeftSceneControls": "Left Scene Controls",
    "WITCHER.UiScaleConfig.Text.Manual": "Manual",
    "WITCHER.UiScaleConfig.Text.OverallScaling": "Overall Scaling",
    "WITCHER.UiScaleConfig.Text.PopupsSheetsDialogsCompendium": "Popups (sheets, dialogs, compendium)",
    "WITCHER.UiScaleConfig.Text.ResetAll": "Reset all",
    "WITCHER.UiScaleConfig.Text.RightSidebar": "Right Sidebar",
    "WITCHER.UiScaleConfig.Text.TopBar": "Top Bar",
    "WITCHER.UiScaleConfig.Text.UiScale": "UI Scale",
    "WITCHER.UiScaleConfig.Text.UiScaleMode": "UI Scale Mode",
    "WITCHER.UiScaleConfig.Text.UiScaleText": "UI Scale (text)",
    "WITCHER.UiScaleConfig.Tooltip.ResetEverySliderTo100ModeStaysAsIs": "Reset every slider to 1.00× (mode stays as-is).",
    "WITCHER.WR.Adrenaline.Disabled": "Adrenaline is disabled in this game — heroic action unavailable.",
    "WITCHER.WR.Adrenaline.NeedAE": "{name} needs {dice} adrenaline (has {ae}).",
    "WITCHER.WR.Adrenaline.NeedSTA": "{name} needs {sta} STA (has {have}).",
    "WITCHER.WR.FlowAndEbb.Banner": "Flow and Ebb — {name} regenerates 1 vigor budget (spent this round: {spent}/{cap}).",
    "WITCHER.WR.FlowAndEbb.NotOwner": "{name} does not have the Flow and Ebb heroic action.",
    "WITCHER.WR.FlowAndEbb.Nothing": "{name} hasn't spent any vigor this round — nothing to regenerate.",
    "WITCHER.WR.FlowAndEbb.OutOfCombat": "Flow and Ebb only works during combat.",
    "WITCHER.WR.ForcefulBlow.Button": "Forceful Blow (5 STA — reroll, keep higher)",
    "WITCHER.WR.ForcefulBlow.Header": "Forceful Blow — reroll",
    "WITCHER.WR.ForcefulBlow.NoAttacker": "Forceful Blow: attacker no longer available.",
    "WITCHER.WR.ForcefulBlow.NoStamina": "Forceful Blow needs 5 STA — {name} has {sta}.",
    "WITCHER.WR.Fumble.DialogTitle": "Witchers Reborn — Ignore Fumble?",
    "WITCHER.WR.Fumble.SkipNo": "Roll the fumble",
    "WITCHER.WR.Fumble.SkipYes": "Spend 5 STA — Skip",
    "WITCHER.WR.Fumble.SkippedBanner": "Fumble skipped — {name} spent 5 STA.",
    "WITCHER.WR.LightningFast.Banner": "Lightning Fast — {name} gains {meters}m of movement this round ({dice} adrenaline).",
    "WITCHER.WR.LightningFast.NotOwner": "{name} does not have the Lightning Fast heroic action.",
    "WITCHER.WR.LightningFast.OutOfCombat": "Lightning Fast only works during combat.",
    "WITCHER.WR.Perserver.Banner": "{name} gains {gained} adrenaline ({severity}).",
    "WITCHER.WR.Perserver.BannerCapped": "{name} gains {gained} adrenaline ({severity}) — would have been {grant}, capped at BODY {cap}.",
    "WITCHER.WR.Perserver.NoGain": "{name} was already at or above BODY {cap} — no adrenaline gained ({severity}, would have been {grant}).",
    "WITCHER.Weapon.Bomb.Shape.Circle": "Circle",
    "WITCHER.Weapon.Bomb.Shape.Cone": "Cone",
    "WITCHER.Weapon.Bomb.Shape.Line": "Line",
    "WITCHER.Weapon.Bomb.Shape.Rect": "Rectangle",
    "WITCHER.Weapon.Draw": "Draw weapon (Fast Draw)",
    "WITCHER.Weapon.HandLeft": "Left",
    "WITCHER.Weapon.HandRight": "Right",
    "WITCHER.Weapon.HandTwoHanded": "Two-Handed",
    "WITCHER.Weapon.Hands.one": "One-Handed",
    "WITCHER.Weapon.Hands.two": "Two-Handed",
    "WITCHER.Weapon.Slot.left": "Off-hand",
    "WITCHER.Weapon.Slot.quick": "Quick / Off-hand",
    "WITCHER.Weapon.Slot.right": "Main Hand",
    "WITCHER.Weapon.TypeBomb": "Bomb",
    "WITCHER.Weapon.TypeMelee": "Melee",
    "WITCHER.Weapon.TypeRanged": "Ranged",
    "WITCHER.Weapon.TypeThrown": "Thrown",
    "WITCHER.WeaponQuality.Ablating.Description": "On a penetrating hit, deals an additional 1d6/2 SP damage to the target's armor (rolled per hit, 0–3 extra SP off the location's value, on top of the standard −1 SP chip every penetrating hit causes).",
    "WITCHER.WeaponQuality.Ablating.Label": "Ablating",
    "WITCHER.WeaponQuality.ArcheryShield.Description": "Strapped to the forearm, allows you to wield a bow or crossbow at no penalty. Block / Parry rolls with the shield take -1, and any close combat weapon used with the shield arm takes -1 to attacks, Blocks, and Parries. (GM-resolved — no auto -1 chip on shield Block/Parry from this quality; the +ranged-while-shielded waiver requires a CE-specific flow not yet wired.)",
    "WITCHER.WeaponQuality.ArcheryShield.Label": "Archery Shield",
    "WITCHER.WeaponQuality.ArmorPiercing.Description": "Ignores the target armor's damage resistance.",
    "WITCHER.WeaponQuality.ArmorPiercing.Label": "Armor Piercing",
    "WITCHER.WeaponQuality.Balanced.Description": "Better criticals: roll 2d6+2 (or 1d6+1 if aimed) for severity.",
    "WITCHER.WeaponQuality.Balanced.Label": "Balanced",
    "WITCHER.WeaponQuality.QuickStrike.Label": "Quick Strike",
    "WITCHER.WeaponQuality.Versatile.Label": "Versatile",
    "WITCHER.WeaponQuality.Warded.Label": "Warded",
    "WITCHER.WeaponQuality.LikeaShadow.Label": "Like a Shadow",
    "WITCHER.WeaponQuality.Unmoving.Label": "Unmoving",
    "WITCHER.WeaponQuality.BladeCatcher.Description": "When you block a melee attack with it, both weapons lock together and are useless until the attacker beats your Small Blades check with a Physique or Sleight of Hand check, or you let go.",
    "WITCHER.WeaponQuality.BladeCatcher.Label": "Blade Catcher",
    "WITCHER.WeaponQuality.Bleeding.Description": "On damage, chance to inflict Bleeding (see Status Effects).",
    "WITCHER.WeaponQuality.Bleeding.Label": "Bleeding",
    "WITCHER.WeaponQuality.Brawling.Description": "The weapon's damage is added to your normal punch or kick damage, and it changes your punch or kick damage to the type shown.",
    "WITCHER.WeaponQuality.Brawling.Label": "Brawling",
    "WITCHER.WeaponQuality.BrawlingPunch.Description": "Attacking with this weapon adds your punch damage code to the weapon's damage. Requires a free fist; can't be used with Natural Weapons. (Combat Extended)",
    "WITCHER.WeaponQuality.BrawlingPunch.Label": "Brawling (Punch)",
    "WITCHER.WeaponQuality.BrawlingKick.Description": "Attacking with this weapon adds your kick damage code to the weapon's damage. Can't be used with Natural Weapons. (Combat Extended)",
    "WITCHER.WeaponQuality.BrawlingKick.Label": "Brawling (Kick)",
    "WITCHER.WeaponQuality.BrawlingUnarmed.NoNaturalWeapons": "This weapon's Brawling quality can't be used with Natural Weapons.",
    "WITCHER.WeaponQuality.Cavalry.Description": "When used to attack while mounted, the weapon adds a damage die for every 1m of movement instead of 2m. (Equipment Overhaul's rename of the legacy Core ‘Charging’ quality.)",
    "WITCHER.WeaponQuality.Cavalry.Label": "Cavalry",
    "WITCHER.WeaponQuality.Charging.Description": "When used to Charge, this weapon deals an extra damage die per 2m moved, up to the maximum shown. This is in addition to the extra damage gained from movement during mounted combat. (EO's redefined ‘Charging’ — distinct from the legacy Core entry kept at the `charging` key.)",
    "WITCHER.WeaponQuality.Charging.Label": "Charging",
    "WITCHER.WeaponQuality.CharginglegacyCore.Description": "Legacy Core ‘Charging’ — used from a mount in motion: add 1d6 bonus damage per meter charged, rather than the usual half. Equipment Overhaul renames this to ‘Cavalry’ (see below); use that key for new items.",
    "WITCHER.WeaponQuality.CharginglegacyCore.Label": "Charging (legacy Core)",
    "WITCHER.WeaponQuality.CloseQuarters.Description": "Gains the indicated benefits when used to attack an enemy that is involved in a grapple, pin, choke-hold, or clinch with the attacker.",
    "WITCHER.WeaponQuality.CloseQuarters.Label": "Close Quarters",
    "WITCHER.WeaponQuality.Concealment.Description": "+2 to checks made to conceal this weapon on your person. (GM-resolved — no auto Conceal-check surface.)",
    "WITCHER.WeaponQuality.Concealment.Label": "Concealment",
    "WITCHER.WeaponQuality.Crafting.Description": "Counts as a tool for the listed constructions or activities, reducing penalties if you lack Crafting Tools.",
    "WITCHER.WeaponQuality.Crafting.Label": "Crafting",
    "WITCHER.WeaponQuality.CrewReload.Description": "Reloading takes 2 actions, which two people may split between them. (GM-resolved — no multi-actor reload pipeline.)",
    "WITCHER.WeaponQuality.CrewReload.Label": "Crew Reload",
    "WITCHER.WeaponQuality.CriticalBlock.Description": "When you beat an attacker by more than 4 on a Block or Parry with your Manticore shield, immediately make a Shield Strike that knocks them back 4m and prone, at no extra penalty or Stamina.",
    "WITCHER.WeaponQuality.CriticalBlock.Label": "Critical Block",
    "WITCHER.WeaponQuality.CriticalDecimation.Description": "When you score a critical wound with a witcher weapon, treat it as one tier more severe (a Simple critical becomes Complex, and so on).",
    "WITCHER.WeaponQuality.CriticalDecimation.Label": "Critical Decimation",
    "WITCHER.WeaponQuality.CriticalFlurry.Description": "When you score a critical wound with a witcher weapon, immediately attempt a Disarm or Trip at no extra penalty and without spending extra Stamina.",
    "WITCHER.WeaponQuality.CriticalFlurry.Label": "Critical Flurry",
    "WITCHER.WeaponQuality.CriticalMomentum.Description": "When you score a critical wound with a witcher weapon, immediately make a single Strike with a held weapon at no extra penalty or Stamina.",
    "WITCHER.WeaponQuality.CriticalMomentum.Label": "Critical Momentum",
    "WITCHER.WeaponQuality.CriticalRiposte.Description": "When you beat an attacker by more than 4 on a Parry with a witcher weapon, immediately Strike with a held weapon at no extra penalty or Stamina.",
    "WITCHER.WeaponQuality.CriticalRiposte.Label": "Critical Riposte",
    "WITCHER.WeaponQuality.CriticalSpellcasting.Description": "When you score a critical wound with a witcher weapon, immediately make a Spellcasting check to cast a Sign at no extra penalty and without spending Stamina beyond the Sign's own cost.",
    "WITCHER.WeaponQuality.CriticalSpellcasting.Label": "Critical Spellcasting",
    "WITCHER.WeaponQuality.CrushingForce.Description": "Cannot be parried; doubles the standard −1 SP chip to −2 on every penetrating hit (on weapons, shields, and armor).",
    "WITCHER.WeaponQuality.CrushingForce.Label": "Crushing Force",
    "WITCHER.WeaponQuality.Deployable.Description": "You can use an Action to prop this shield up as a portable fortification. (GM-resolved — no portable-cover token state.)",
    "WITCHER.WeaponQuality.Deployable.Label": "Deployable",
    "WITCHER.WeaponQuality.Difficult.Description": "This piece of armor must be worn with an Arming Jack and can't be equipped without assistance.",
    "WITCHER.WeaponQuality.Difficult.Label": "Difficult",
    "WITCHER.WeaponQuality.Disease.Description": "On a damaging hit, chance to inflict the Disease condition (see Status Effects).",
    "WITCHER.WeaponQuality.Disease.Label": "Disease",
    "WITCHER.WeaponQuality.Entangling.Description": "On a hit the target is entangled: -5 SPD and -2 to all physical actions; each turn a DC 18 Dodge/Escape or Contortionist check breaks free, or an ally may spend an action to remove it.",
    "WITCHER.WeaponQuality.Entangling.Label": "Entangling",
    "WITCHER.WeaponQuality.ExtremeReach.Description": "You can attack targets 2-6 meters beyond your normal melee Reach (2-4 grid squares away) with this weapon. You take −5 to Block or Parry adjacent opponents, and can't attack them, even with pommel strikes.",
    "WITCHER.WeaponQuality.ExtremeReach.Label": "Extreme Reach",
    "WITCHER.WeaponQuality.Feeble.Description": "This weapon can only Parry other Feeble weapons, and if used to Block a non-Feeble weapon, the defender still takes half damage if they succeed. If used to Block a Hefty weapon, the defender takes half damage as lethal and half as non-lethal.",
    "WITCHER.WeaponQuality.Feeble.Label": "Feeble",
    "WITCHER.WeaponQuality.Fire.Description": "On a damaging hit, chance to set the target alight (see Burning status).",
    "WITCHER.WeaponQuality.Fire.Label": "Fire",
    "WITCHER.WeaponQuality.Fireproof.Description": "Reduces fire damage by half and confers immunity to the Burning status.",
    "WITCHER.WeaponQuality.Fireproof.Label": "Fireproof",
    "WITCHER.WeaponQuality.Focus.Description": "Casting through this weapon reduces STA cost by its Focus value.",
    "WITCHER.WeaponQuality.Focus.Label": "Focus",
    "WITCHER.WeaponQuality.Foraging.Description": "When used to forage for the listed type of resource, you gain +1 unit of that resource.",
    "WITCHER.WeaponQuality.Foraging.Label": "Foraging",
    "WITCHER.WeaponQuality.FreeAmmunition.Description": "This weapon can use rocks, sticks, or other improvised projectiles from the environment as ammunition at no cost.",
    "WITCHER.WeaponQuality.FreeAmmunition.Label": "Free Ammunition",
    "WITCHER.WeaponQuality.Freeze.Description": "On a damaging hit, chance to chill the target solid (see Frozen status).",
    "WITCHER.WeaponQuality.Freeze.Label": "Freeze",
    "WITCHER.WeaponQuality.FullCoverdeprecated.Description": "Equipment Overhaul retires this quality — it is mechanically subsumed by any shield with a Cover Value of 6 or more. Kept in the catalog for backward compatibility with pavise-style items; new shields should set CV ≥ 6 instead.",
    "WITCHER.WeaponQuality.FullCoverdeprecated.Label": "Full Cover (deprecated)",
    "WITCHER.WeaponQuality.Grappling.Description": "Can be used to grapple and trip opponents in reach. (Use the CE Grapple action; the prereq check is in actions.mjs, not this quality.)",
    "WITCHER.WeaponQuality.Grappling.Label": "Grappling",
    "WITCHER.WeaponQuality.GreaterFocus.Description": "Spells cast through this weapon treat DC as +2.",
    "WITCHER.WeaponQuality.GreaterFocus.Label": "Greater Focus",
    "WITCHER.WeaponQuality.Grounded.Description": "You can't load or shoot this weapon if riding an animal or driving a vehicle. You can still load and shoot as a passenger on a boat, wagon, or cart, but you must stand upright and may be penalized.",
    "WITCHER.WeaponQuality.Grounded.Label": "Grounded",
    "WITCHER.WeaponQuality.Guard.Description": "The weapon adds a +1 bonus to defense rolls when it is used to Block or Parry.",
    "WITCHER.WeaponQuality.Guard.Label": "Guard",
    "WITCHER.WeaponQuality.HalfDamage.Description": "This ammunition deals half the weapon's base damage (rounded down). Usually paired with a debuff or status rider in lieu of damage.",
    "WITCHER.WeaponQuality.HalfDamage.Label": "Half Damage",
    "WITCHER.WeaponQuality.Hefty.Description": "Too heavy for a Fast Strike — Fast Strike is unavailable with this weapon (use Single Attack instead). Its attacks can't be Parried, and it deals half damage as non-lethal damage when successfully Blocked.",
    "WITCHER.WeaponQuality.Hefty.Label": "Hefty",
    "WITCHER.WeaponQuality.Hidden.Description": "Concealed under clothing: requires an Awareness check at the listed DC to detect. (GM-resolved — no automatic Awareness detection surface; the DC chip is for hand-roll reference.)",
    "WITCHER.WeaponQuality.Hidden.Label": "Hidden",
    "WITCHER.WeaponQuality.ImprovedArmorPiercing.Description": "Ignores armor's damage resistance, halves the armor's SP on hit, and bypasses monster per-type resistances + immunities. Does NOT bypass the 'vulnerable only to silver' or 'vulnerable only to meteorite' weakness gates.",
    "WITCHER.WeaponQuality.ImprovedArmorPiercing.Label": "Improved Armor Piercing",
    "WITCHER.WeaponQuality.ImprovedRange.Description": "This ammunition improves the range of the weapon by 50%.",
    "WITCHER.WeaponQuality.ImprovedRange.Label": "Improved Range",
    "WITCHER.WeaponQuality.Indirect.Description": "The weapon's flexibility or curvature allows it to reach behind an opponent's guard. Attempts to Block or Parry its attacks are always rolled at −2. However, this makes it awkward in defense, so it also Blocks and Parries at −2.",
    "WITCHER.WeaponQuality.Indirect.Label": "Indirect",
    "WITCHER.WeaponQuality.Injector.Description": "Can be charged (an action) with a dose of poison or elixir; a damaging hit drives the dose deep, making a poison 3 harder to resist or an elixir last 3 rounds longer. (GM-resolved — no charge-with-poison UI; rider note posts on hit.)",
    "WITCHER.WeaponQuality.Injector.Label": "Injector",
    "WITCHER.WeaponQuality.KnockDown.Description": "On a damaging hit, chance to knock the target prone.",
    "WITCHER.WeaponQuality.KnockDown.Label": "Knock-Down",
    "WITCHER.WeaponQuality.LanceRest.Description": "Allows you to use your Full Turn to make a one-handed charging attack with a lance while mounted, without the usual penalty for attacking one-handed with a two-handed weapon. (GM-resolved — no first-class mount + lance flow.)",
    "WITCHER.WeaponQuality.LanceRest.Label": "Lance Rest",
    "WITCHER.WeaponQuality.LongReach.Description": "You can attack targets 2 meters beyond your normal melee Reach (2 grid squares away) with this weapon. You take −1 to Block, Parry, or attack adjacent opponents.",
    "WITCHER.WeaponQuality.LongReach.Label": "Long Reach",
    "WITCHER.WeaponQuality.MagicallyAnchoring.Description": "While a creature touches the weapon it cannot turn invisible or intangible or teleport away; any already invisible or intangible creature is forced visible and solid.",
    "WITCHER.WeaponQuality.MagicallyAnchoring.Label": "Magically Anchoring",
    "WITCHER.WeaponQuality.Meteorite.Description": "Full damage vs meteorite-vulnerable monsters. Per Equipment Overhaul, if you don't use the alternate optional rules for monster susceptibilities, this quality instead grants the weapon (or shield) an extra enchantment slot for runes (up to 3 total). Legacy house-rule kept Reliability +5 for backward compatibility.",
    "WITCHER.WeaponQuality.Meteorite.Label": "Meteorite",
    "WITCHER.WeaponQuality.MeteoriteContact.Description": "Meteorite-susceptible monsters become staggered whenever they hit this armor piece with their natural weapons, or whenever either of you hit each other with, or maintain, brawling maneuvers. Additionally, if applied to arms or legs, it grants your punches or kicks the Meteorite effect.",
    "WITCHER.WeaponQuality.MeteoriteContact.Label": "Meteorite Contact",
    "WITCHER.WeaponQuality.Mounted.Description": "Fixed in place; it must be set up before use and packed away (an action each) before it can be moved. (GM-resolved — no setup/pack-away action surface; chargeBonusPerMeter on cavalry/charging IS engine-wired.)",
    "WITCHER.WeaponQuality.Mounted.Label": "Mounted",
    "WITCHER.WeaponQuality.Nimble.Description": "When you use an Extra Action to draw or attack with this weapon, the Stamina cost is reduced by 2.",
    "WITCHER.WeaponQuality.Nimble.Label": "Nimble",
    "WITCHER.WeaponQuality.NonLethaldeprecated.Description": "Equipment Overhaul retires this quality — eligible weapons are now given N(on-lethal) as a damage type option instead. Kept in the catalog for backward compatibility with items that still reference it; new items should set damage type to Non-lethal.",
    "WITCHER.WeaponQuality.NonLethaldeprecated.Label": "Non-Lethal (deprecated)",
    "WITCHER.WeaponQuality.Options.Description": "You can get a variation of this armor that doesn't cover the arms and has its EV penalties mitigated by the parenthetical amount. If it normally covers the legs you can also get it in a shorter version that doesn't, also reducing its EV by the same amount. Using either option reduces the weight and price by 20%, and using both options reduces the weight and price by 40%. (GM-resolved — the GM hand-creates the variant item; no auto-derive.)",
    "WITCHER.WeaponQuality.Options.Label": "Options",
    "WITCHER.WeaponQuality.Parrying.Description": "Parrying with this weapon lowers the parry penalty by 2.",
    "WITCHER.WeaponQuality.Parrying.Label": "Parrying",
    "WITCHER.WeaponQuality.Physique.Description": "If your Physique skill base is lower than the listed number, your attack rolls suffer a penalty equal to the difference.",
    "WITCHER.WeaponQuality.Physique.Label": "Physique",
    "WITCHER.WeaponQuality.Poison.Description": "On a damaging hit, chance to envenom the target (see Poisoned status).",
    "WITCHER.WeaponQuality.Poison.Label": "Poison",
    "WITCHER.WeaponQuality.PoorVision.Description": "You have a reduced field of vision and lose scent tracking abilities, and you only recover HALF your normal Stamina from in-combat recovery (Take Breath). With Poor Vision, you also take a −2 to Awareness and ranged attacks, and a −1 penalty to all other vision-dependent checks. On many helms you can open a visor or mask as an Action to negate this, but that removes any resistance to piercing attacks the helmet has and reduces SP by 5.",
    "WITCHER.WeaponQuality.PoorVision.Label": "Poor Vision",
    "WITCHER.WeaponQuality.RangedPenalty.Description": "Heavy or restrictive armor on the arms imposes a flat penalty to ranged attack rolls. The parameter records the penalty value (-1, -2, …).",
    "WITCHER.WeaponQuality.RangedPenalty.Label": "Ranged Penalty",
    "WITCHER.WeaponQuality.ReducedRange.Description": "This ammunition halves the range of the weapon.",
    "WITCHER.WeaponQuality.ReducedRange.Label": "Reduced Range",
    "WITCHER.WeaponQuality.ResistancetoBleeding.Description": "Reduces the chance of the Bleeding status taking hold by the listed amount (-25% by default).",
    "WITCHER.WeaponQuality.ResistancetoBleeding.Label": "Resistance to Bleeding",
    "WITCHER.WeaponQuality.RestrictedVision.Description": "You have a reduced field of vision and lose scent tracking abilities, and you only recover HALF your normal Stamina from in-combat recovery (Take Breath). On many helms you can open a visor or mask as an Action to negate this, but that removes any resistance to piercing attacks the helmet has and reduces SP by 5.",
    "WITCHER.WeaponQuality.RestrictedVision.Label": "Restricted Vision",
    "WITCHER.WeaponQuality.SPDPenalty.Description": "Heavy or restrictive armor on the legs imposes a flat penalty to your SPD stat. The parameter records the penalty value (-1, -2, …).",
    "WITCHER.WeaponQuality.SPDPenalty.Label": "SPD Penalty",
    "WITCHER.WeaponQuality.SetBonus.Description": "Item is part of a named set (witcher school kit, etc.). Wearing the complete set unlocks the set's signature bonus — encoded on the set definition, not here. (Engine fires a rider note when all worn pieces share a set parameter; the per-set BONUS still requires a set-definition lookup, which is GM-resolved.)",
    "WITCHER.WeaponQuality.SetBonus.Label": "Set Bonus",
    "WITCHER.WeaponQuality.Silver.Description": "The weapon's whole damage counts as silver — no separate roll. Silver-weak monsters take FULL damage; every other target (characters, non-silver-weak monsters) takes HALF (silver's poor offensive edge). Combine with Meteorite to deal full to those other targets too.",
    "WITCHER.WeaponQuality.Silver.Label": "Silver",
    "WITCHER.WeaponQuality.SilverContact.Description": "Silver-susceptible monsters become staggered whenever they hit this armor piece with their natural weapons, or whenever either of you hit each other with, or maintain, brawling maneuvers. Additionally, if applied to arms or legs, it grants your punches or kicks the Silver effect.",
    "WITCHER.WeaponQuality.SilverContact.Label": "Silver Contact",
    "WITCHER.WeaponQuality.SlowReload.Description": "Takes a 1-action reload between shots.",
    "WITCHER.WeaponQuality.SlowReload.Label": "Slow Reload",
    "WITCHER.WeaponQuality.StableAim.Description": "When this weapon strikes a Critical Wound, you add your Aim action bonus, if any, to the critical hit roll.",
    "WITCHER.WeaponQuality.StableAim.Label": "Stable Aim",
    "WITCHER.WeaponQuality.Stagger.Description": "On a damaging hit, chance to knock the target off-balance (see Staggered status).",
    "WITCHER.WeaponQuality.Stagger.Label": "Stagger",
    "WITCHER.WeaponQuality.Stifling.Description": "You can not rest while wearing this piece of armor and it can't be layered with other stifling armor pieces.",
    "WITCHER.WeaponQuality.Stifling.Label": "Stifling",
    "WITCHER.WeaponQuality.Strangling.Description": "The weapon can be used to execute a choke hold, gaining the indicated benefits.",
    "WITCHER.WeaponQuality.Strangling.Label": "Strangling",
    "WITCHER.WeaponQuality.Stun.Description": "Head/torso hits force a Stun save at the listed penalty.",
    "WITCHER.WeaponQuality.Stun.Label": "Stun",
    "WITCHER.WeaponQuality.Sturdy.Description": "Sturdy weapons can Block and Parry attacks from Hefty weapons normally.",
    "WITCHER.WeaponQuality.Sturdy.Label": "Sturdy",
    "WITCHER.WeaponQuality.SuperiorGuard.Description": "The weapon adds a +2 bonus to defense rolls when it is used to Block or Parry.",
    "WITCHER.WeaponQuality.SuperiorGuard.Label": "Superior Guard",
    "WITCHER.WeaponQuality.SuperiorLanceRest.Description": "As Lance Rest, and also eliminates the Strong Strike penalty while doing so. (GM-resolved.)",
    "WITCHER.WeaponQuality.SuperiorLanceRest.Label": "Superior Lance Rest",
    "WITCHER.WeaponQuality.SuperiorReach.Description": "You can attack targets 2-4 meters beyond your normal melee Reach (2-3 grid squares away) with this weapon. You take −3 to Block, Parry, or attack adjacent opponents, and can only attack them with pommel strikes.",
    "WITCHER.WeaponQuality.SuperiorReach.Label": "Superior Reach",
    "WITCHER.WeaponQuality.Throwing.Description": "When thrown, this weapon gains the indicated benefits.",
    "WITCHER.WeaponQuality.Throwing.Label": "Throwing",
    "WITCHER.WeaponQuality.TwoHand.Description": "When used as a two-handed weapon instead of a one-handed weapon, this weapon gains the indicated benefits.",
    "WITCHER.WeaponQuality.TwoHand.Label": "Two-Hand",
    "WITCHER.WeaponQuality.VerySturdy.Description": "Very Sturdy shields can Block and Parry attacks from Hefty weapons normally, and can also Parry monster attacks with the Crushing Force effect.",
    "WITCHER.WeaponQuality.VerySturdy.Label": "Very Sturdy",
