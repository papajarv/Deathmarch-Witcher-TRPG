    "WITCHER.App.CarouselInitiativeConfig.Text.EnabledDesc": "Master switch. Turn OFF to fully disable the carousel; requires a reload to take effect. All other settings apply live without a reload.",
    "WITCHER.App.CarouselInitiativeConfig.Text.EnabledName": "Enable Carousel Initiative",
    "WITCHER.App.CarouselInitiativeConfig.Text.FriendlyColor": "Friendly frame",
    "WITCHER.App.CarouselInitiativeConfig.Text.HideSecretDesc": "When a token is set to Secret disposition, remove it from the carousel and combat tracker for non-GM users. The GM keeps seeing it with an eye-slash badge so they know it's hidden from players.",
    "WITCHER.App.CarouselInitiativeConfig.Text.HideSecretName": "Hide SECRET tokens from players",
    "WITCHER.App.CarouselInitiativeConfig.Text.HideStealthDesc": "When a token is stealthed (per the system's stealth mechanic), remove it from the carousel and combat tracker for non-GM users. See the spotter-visibility toggle below to allow player exceptions.",
    "WITCHER.App.CarouselInitiativeConfig.Text.HideStealthName": "Hide stealthed tokens from players",
    "WITCHER.App.CarouselInitiativeConfig.Text.HostileColor": "Hostile frame",
    "WITCHER.App.CarouselInitiativeConfig.Text.NeutralColor": "Neutral frame color",
    "WITCHER.App.CarouselInitiativeConfig.Text.NeutralShowFrameDesc": "By default neutrals get no colored frame (matches 'neither ally nor threat' as ambient). Turn on to give them the color set below.",
    "WITCHER.App.CarouselInitiativeConfig.Text.NeutralShowFrameName": "Show frame for NEUTRAL tokens",
    "WITCHER.App.CarouselInitiativeConfig.Text.PortraitHeight": "Portrait height",
    "WITCHER.App.CarouselInitiativeConfig.Text.SecretColor": "Secret frame (GM only)",
    "WITCHER.App.CarouselInitiativeConfig.Text.ShowForGMDesc": "Whether the carousel appears for the GM. Turn OFF if the GM prefers only the sidebar tracker.",
    "WITCHER.App.CarouselInitiativeConfig.Text.ShowForGMName": "Show for the GM",
    "WITCHER.App.CarouselInitiativeConfig.Text.ShowForPlayersDesc": "Whether the carousel appears for player users. Turn OFF for a GM-only initiative display.",
    "WITCHER.App.CarouselInitiativeConfig.Text.ShowForPlayersName": "Show for players",
    "WITCHER.App.CarouselInitiativeConfig.Text.ShowTheaterDesc": "Include combats with no linked tokens (theater-of-the-mind, actor-only initiative). Turn OFF to only show the carousel when combatants have real tokens on the scene.",
    "WITCHER.App.CarouselInitiativeConfig.Text.ShowTheaterName": "Show for theater-of-the-mind combat",
    "WITCHER.App.CarouselInitiativeConfig.Text.ShowTokenCombatDesc": "Include combats where at least one combatant has a token placed on the current scene. This is the normal case; you almost always want this on.",
    "WITCHER.App.CarouselInitiativeConfig.Text.ShowTokenCombatName": "Show for token combat",
    "WITCHER.App.CarouselInitiativeConfig.Text.SnapWrapDesc": "When a round wraps back to the first combatant, snap the strip to the first card without an animation instead of sliding the whole strip across (which reads as a slingshot).",
    "WITCHER.App.CarouselInitiativeConfig.Text.SnapWrapName": "Snap on round wrap",
    "WITCHER.App.CarouselInitiativeConfig.Text.SpotterVisibilityDesc": "When ON, players who own an actor that has spotted a stealthed combatant WILL see that combatant in the carousel and tracker (matches the canvas visibility gate). When OFF, stealthed combatants are hidden from all non-owners regardless of who spotted whom.",
    "WITCHER.App.CarouselInitiativeConfig.Text.SpotterVisibilityName": "Respect spotter visibility",
