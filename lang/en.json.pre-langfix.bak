    "WITCHER.Tooltip.Dock.Guard": "Sword guard: {label} (click to configure)",
    "WITCHER.Tooltip.Dock.GuardInCombat": "Sword guard: {current} (preferred: {preferred}). Click to configure.",
    "WITCHER.Tooltip.Dock.GuardOutOfCombat": "Sword guard preferred: {preferred}. Applies at combat start. Click to configure.",
