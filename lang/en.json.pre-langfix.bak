    "WITCHER.App.StealthConfig.Coverage.Full": "Fully exposed (100% visible)",
    "WITCHER.App.StealthConfig.Coverage.Half": "Half exposed (50–74% visible)",
    "WITCHER.App.StealthConfig.Coverage.Quarter": "Quarter exposed (25–49% visible)",
    "WITCHER.App.StealthConfig.Coverage.Sliver": "Sliver exposed (<25% visible)",
    "WITCHER.App.StealthConfig.Coverage.ThreeQuarter": "Three-quarter exposed (75–99% visible)",
    "WITCHER.App.StealthConfig.ResetConfirmBody": "Discard all stealth configuration overrides and restore the defaults? Takes effect when you Save.",
    "WITCHER.App.StealthConfig.ResetConfirmTitle": "Reset stealth config?",
    "WITCHER.App.StealthConfig.ResetToDefaults": "Reset to Defaults",
    "WITCHER.App.StealthConfig.Save": "Save",
    "WITCHER.App.StealthConfig.Saved": "Stealth configuration saved.",
    "WITCHER.App.StealthConfig.Section.Core": "Core Behavior",
    "WITCHER.App.StealthConfig.Section.Coverage": "Body Exposure Modifiers",
    "WITCHER.App.StealthConfig.Section.RangeBands": "Range Bands",
    "WITCHER.App.StealthConfig.Section.Rendering": "Cone Rendering",
    "WITCHER.App.StealthConfig.Section.Sight": "Sight Distance",
    "WITCHER.App.StealthConfig.Section.Zones": "Vision Zone Modifiers",
    "WITCHER.App.StealthConfig.Text.AlphaFloor": "Minimum cone brightness (0–1)",
    "WITCHER.App.StealthConfig.Text.AlphaFloorDesc": "Only used when 'Scale cone brightness by catch chance' is on. Cones from harmless spotters fade toward this value; cones from dangerous spotters stay near full opacity.",
    "WITCHER.App.StealthConfig.Text.AlphaScaleDesc": "Cones from spotters with no realistic chance of seeing you fade toward the minimum brightness; cones from spotters on the razor's edge stay full-strength.",
    "WITCHER.App.StealthConfig.Text.AlphaScaleName": "Scale cone brightness by catch chance",
    "WITCHER.App.StealthConfig.Text.AutoSpot": "auto-spot",
    "WITCHER.App.StealthConfig.Text.Band": "Band",
    "WITCHER.App.StealthConfig.Text.BaseSightMetres": "Base sight distance (metres)",
    "WITCHER.App.StealthConfig.Text.Coverage": "Coverage",
    "WITCHER.App.StealthConfig.Text.CoverageDesc": "How much of the stealther's token is actually visible to the spotter (samples of the token's bounding box that fall inside the spotter's sight polygon, ignoring walls that block the rest). 100% exposed = neutral; less exposed = harder to spot.",
    "WITCHER.App.StealthConfig.Text.CrossLevelDesc": "Let spotters detect stealthers on a different scene Level. When off, cross-floor detection is disabled entirely regardless of Foundry's level.visibility.levels config.",
    "WITCHER.App.StealthConfig.Text.CrossLevelName": "Cross-level detection",
    "WITCHER.App.StealthConfig.Text.DebugDesc": "Post a full modifier-breakdown chat card to GMs on every check (including 'still hidden' outcomes). Off = only a short 'spotted by X' whisper to the stealther's owner + GM when the stealther is first spotted.",
    "WITCHER.App.StealthConfig.Text.DebugName": "Debug chat output",
    "WITCHER.App.StealthConfig.Text.EnableStealthDesc": "Master switch. Off = detection dispatch pauses, the red cone overlay draws nothing, cross-user token hiding is skipped, and the sneak HUD button hides. Existing stealth flags on actors are preserved.",
    "WITCHER.App.StealthConfig.Text.EnableStealthName": "Enable Stealth system",
    "WITCHER.App.StealthConfig.Text.FractionOfMaxSight": "Upper bound (× max sight)",
    "WITCHER.App.StealthConfig.Text.HideConeDesc": "Once a spotter has spotted the stealther, hide that spotter's cone on the stealther-owner's overlay — they've been seen, so the cone carries no more information.",
    "WITCHER.App.StealthConfig.Text.HideConeName": "Hide spotter's cone once they've spotted you",
    "WITCHER.App.StealthConfig.Text.Mod": "Mod",
    "WITCHER.App.StealthConfig.Text.OnlyCatchDesc": "Cones render ONLY the sub-region where the spotter's effective DC would meet or beat your passive Stealth — i.e. tiles where stepping there guarantees a spot. Weak spotters that can't catch you at any distance show no cone at all; strong spotters show only the deadly sectors of their vision.",
    "WITCHER.App.StealthConfig.Text.OnlyCatchName": "Show only 100%-catch tiles",
    "WITCHER.App.StealthConfig.Text.PointBlankMetres": "Point Blank distance (metres)",
    "WITCHER.App.StealthConfig.Text.RangeBandFractionsDesc": "Where each band tops out, as a fraction of the spotter's effective max sight. Anything past 'extreme' is out of range.",
    "WITCHER.App.StealthConfig.Text.RangeBandsDesc": "Modifier applied to the spotter's Passive DC based on how far the stealther is. Positive = easier to spot; negative = harder. Point Blank is always auto-spot regardless of its numeric mod.",
    "WITCHER.App.StealthConfig.Text.RenderMode": "Cone render style",
    "WITCHER.App.StealthConfig.Text.RenderModeDesc": "Full = filled cones with per-zone shading (rich but heavier on the GPU). Outline = thin colored outline only, tinted green→yellow→red by threat level (lightweight; recommended for scenes with many spotters).",
    "WITCHER.App.StealthConfig.Text.RenderModeFull": "Full (filled cones)",
    "WITCHER.App.StealthConfig.Text.RenderModeOutline": "Outline (threat tint)",
    "WITCHER.App.StealthConfig.Text.SightFormula": "Each spotter's <b>maximum sight</b> = base + spotter's <b>INT</b> + spotter's <b>Awareness</b> rank. A 20 m base with an INT-6 Awareness-3 spotter sees 29 m at the outer edge; anything past that can't be seen at all.",
    "WITCHER.App.StealthConfig.Text.Zone": "Zone",
    "WITCHER.App.StealthConfig.Text.ZonesDesc": "Angular position of the stealther within the spotter's cone. Interior (focused) is dead-ahead; near-peripheral is off to the sides; far-peripheral is right at the edge of vision.",
    "WITCHER.App.StealthConfig.Title": "Token Stealth Configuration",
    "WITCHER.App.StealthConfig.Tooltip.BaseSight": "20 m default. Per-spotter max sight adds INT + Awareness rank on top.",
    "WITCHER.App.StealthConfig.Tooltip.PointBlankMetres": "Distance within which spotters auto-spot the stealther regardless of Stealth roll.",
    "WITCHER.App.StealthConfig.Zone.Far": "Far peripheral (outermost 10°)",
    "WITCHER.App.StealthConfig.Zone.Focused": "Focused (interior)",
    "WITCHER.App.StealthConfig.Zone.Near": "Near peripheral (10–20° from edge)",
    "WITCHER.App.StealthExplainer.Angle": "Angle",
    "WITCHER.App.StealthExplainer.AngleDesc": "If you're dead ahead in their vision, they see clearly. Off to the side (peripheral) they see less clearly.",
    "WITCHER.App.StealthExplainer.Coverage": "Coverage",
    "WITCHER.App.StealthExplainer.CoverageDesc": "The more of your body is hidden by walls or objects, the harder you are to spot.",
    "WITCHER.App.StealthExplainer.EnemyPassive": "Every enemy has a passive score: 10 + INT + Awareness rank + Awareness modifier. They add situational modifiers to it and compare to your stealth score. Meet or beat = spotted.",
    "WITCHER.App.StealthExplainer.Footer": "Your GM can turn every number here — range mods, sight distance, coverage penalties — via Configure Settings → Token Stealth.",
    "WITCHER.App.StealthExplainer.Intro": "Sneaking is a passive check. You roll once when you enter stealth; every enemy compares their perception to your one number until you leave stealth or they see you.",
    "WITCHER.App.StealthExplainer.OnTheMap": "On the map",
    "WITCHER.App.StealthExplainer.OnTheMapDesc": "Red cones show where enemies can see. Walk around them, break line of sight, or use cover to stay hidden. Once an enemy has spotted you, their cone disappears — they know you're there.",
    "WITCHER.App.StealthExplainer.OneRoll": "That number is your stealth score for as long as you stay in stealth — you don't reroll while sneaking.",
    "WITCHER.App.StealthExplainer.Range": "Range",
    "WITCHER.App.StealthExplainer.RangeDesc": "Point-blank auto-spots. Close makes you easy to see. Medium is neutral. Long and Extreme make you harder to see.",
    "WITCHER.App.StealthExplainer.SightDistance": "How far enemies see",
    "WITCHER.App.StealthExplainer.SightDistanceDesc": "Each enemy's maximum sight is the base sight distance (default 20 m) PLUS their INT and their Awareness skill rank. A dull orc sees roughly the base range; a keen-eyed elven ranger sees much farther. Beyond that maximum, you can't be seen at all.",
    "WITCHER.App.StealthExplainer.Title": "How Stealth Works",
    "WITCHER.App.StealthExplainer.WhatChangesTheirScore": "What changes their score",
    "WITCHER.App.StealthExplainer.WhatEnemiesRoll": "What enemies check against you",
    "WITCHER.App.StealthExplainer.WhatYouRoll": "What you roll",
    "WITCHER.App.StressConfig.Blurb": "Knobs for the stress homebrew. Defaults match the original spec. Break / boon table text and stress-shield dice are edited from the Status Effects editor.",
    "WITCHER.App.StressConfig.Text.Books": "Books",
    "WITCHER.App.StressConfig.Text.FailedBookReadingsAddStress": "Failed book readings add stress",
    "WITCHER.App.StressConfig.Text.FailedBookReadingsAddStressHint": "a failed monster-lore or skill-book study check adds stress. Off = players can fail a reading with no mental toll. Novel/lore per-chapter stress is unaffected.",
    "WITCHER.App.StressConfig.Text.StressPerFailedReading": "Stress per failed reading",
    "WITCHER.App.StressConfig.Tooltip.BookFailStressAmount": "How much stress a failed monster-lore / skill-book study check adds (when the toggle above is on).",
    "WITCHER.App.BookConfig.Text.Language": "Language",
    "WITCHER.App.BookConfig.Text.LanguageEnabled": "Enable book languages",
    "WITCHER.App.BookConfig.Text.LanguageEnabledHint": "books can be written in a language that gates reading (rank 0 = can't read) and penalises low-rank readers. Off = every book is readable by anyone with no language penalty or flavour.",
    "WITCHER.App.BookConfig.Text.LanguagePenaltyPerRanks": "Ranks short per −1 Education",
    "WITCHER.App.BookConfig.Tooltip.LanguagePenaltyPerRanks": "A reader below the book's required language rank takes −1 to the Education check for every this-many ranks they fall short. Novels are exempt from this penalty.",
    "WITCHER.App.BookConfig.Text.BookConfiguration": "Book System Configuration",
    "WITCHER.App.BookConfig.Blurb": "Reading-cooldown tunables for the book homebrew. Defaults reproduce the original 4-hour cooldowns. Language requirements and per-book study difficulty are configured on each book.",
    "WITCHER.App.BookConfig.Text.ReadingCooldowns": "Reading Cooldowns",
    "WITCHER.App.BookConfig.Text.StudyCooldownHours": "Study cooldown (hours)",
    "WITCHER.App.BookConfig.Text.NovelStepCooldownHours": "Novel chapter cooldown (hours)",
    "WITCHER.App.BookConfig.Tooltip.StudyCooldown": "In-world hours that must pass between study sessions of a monster-lore or skill book. 0 = no cooldown.",
    "WITCHER.App.BookConfig.Tooltip.NovelStepCooldown": "In-world hours that must pass between reading chapters of a novel / lore book. 0 = no cooldown.",
    "WITCHER.App.StressConfig.Dialog.Button.ResetToDefaults": "Reset to Defaults",
    "WITCHER.App.StressConfig.Text.ComplexWound": "Complex wound",
    "WITCHER.App.StressConfig.Text.CriticalWounds": "Critical Wounds",
    "WITCHER.App.StressConfig.Text.DeadlyWound": "Deadly wound",
    "WITCHER.App.StressConfig.Text.DifficultWound": "Difficult wound",
    "WITCHER.App.StressConfig.Text.DiscardAllStressConfigurationOverridesAn": "Discard all stress configuration overrides and restore the homebrew defaults? This takes effect when you Save.",
    "WITCHER.App.StressConfig.Text.HowHardEachPointOverWillHurtsTheSave": "How hard each point over WILL hurts the save",
    "WITCHER.App.StressConfig.Text.MentalBreaksBeforeCharacterIsLost": "Mental breaks before character is lost",
    "WITCHER.App.StressConfig.Text.SimpleWound": "Simple wound",
    "WITCHER.App.StressConfig.Text.StressConfiguration": "Stress Configuration",
    "WITCHER.App.StressConfig.Text.StressOverWillSlowsNaturalHealing": "Stress over WILL slows natural healing",
    "WITCHER.App.StressConfig.Text.StressRemainingAfterAWillSaveRelativeToW": "Stress remaining after a WILL save (relative to WILL)",
    "WITCHER.App.StressConfig.Text.TakingACriticalWoundAddsStress": "Taking a critical wound adds stress",
    "WITCHER.App.StressConfig.Text.WillSaveRecovery": "WILL Save & Recovery",
    "WITCHER.App.StressConfig.Tooltip.AfterEveryWillSaveStressSettlesToWillThi": "After every WILL save, stress settles to (WILL + this number). Default =−1, so WILL 6 lands at 5. Use 0 to stop at WILL exactly; use −3 for a stronger reset.",
    "WITCHER.App.StressConfig.Tooltip.EachPointOfStressOverWillHitsTheWillSave": "Each point of stress over WILL hits the WILL save by this much. 1 = default (stress 9 vs WILL 6 → save target 3). 0.5 = saves stay easier at high stress; 2 = each point over WILL doubles the pain.",
    "WITCHER.App.StressConfig.Tooltip.HowManyDistinctMentalBreaksACharacterCan": "How many distinct mental breaks a character can accumulate before control passes to the GM. Default =8 (every entry on the break table). Lower numbers make the character break sooner.",
    "WITCHER.App.UiCustomizer.Title": "UI Customizer",
