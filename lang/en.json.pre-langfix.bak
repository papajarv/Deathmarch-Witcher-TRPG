    "WITCHER.Effect.CustomStatus.DotCadenceHint": "1 = every turn. 3 = every third turn. Set to 0 to disable the DoT.",
    "WITCHER.Effect.CustomStatus.DotDamageType": "DoT damage type",
    "WITCHER.Effect.CustomStatus.DotDamageTypeHint": "When the DoT ticks, this damage type is looked up against the target's monster damageProfile — resistant halves, vulnerable doubles, immune zeroes out. Leave blank for untyped DoT (no resistance check).",
    "WITCHER.Effect.CustomStatus.DotEveryLocation": "Hits every location",
