    "WITCHER.Policy.StealthVisionConfig.AllowedLabel": "Allowed Vision Angle",
    "WITCHER.Policy.StealthVisionConfig.AllowedTooltip": "The vision cone Foundry actually renders. Restricted by equipment (helmet, hood). Peripheral bands compute off True Vision Angle below.",
    "WITCHER.Policy.StealthVisionConfig.TrueHint": "Biological FOV before equipment obstruction. Only used by the stealth system for computing peripheral-band boundaries — Foundry's own vision rendering follows Allowed above.",
    "WITCHER.Policy.StealthVisionConfig.TrueLabel": "True Vision Angle",
    "WITCHER.Policy.StealthVisionConfig.TruePlaceholder": "same as Allowed",
    "WITCHER.Policy.StealthVisionConfig.TrueTooltip": "Biological max field of view. Peripheral bands compute off this value. Should be ≥ Allowed. Leave blank / 0 to treat true = allowed (no separate biological max).",
    "WITCHER.Policy.TacticalGrid.RunConfirmPrompt": "Committing to this tile will consume your entire turn as a Run action.",
